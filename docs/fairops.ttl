core:a rdf:type swrl:Variable .

core:b rdf:type swrl:Variable .

core:C rdf:type swrl:Variable .

core:T rdf:type swrl:Variable .

core:M rdf:type swrl:Variable .

core:N rdf:type swrl:Variable .

core:SA rdf:type swrl:Variable .

core:SP rdf:type swrl:Variable .

core:D rdf:type swrl:Variable .

core:AD rdf:type swrl:Variable .

[ swrla:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:comment "" ;
   rdfs:label "Conflict3" ;
   rdf:type swrl:Imp ;
   swrl:body [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:ClassAtom ;
                           swrl:classPredicate core:IndependenceFairnessNotion ;
                           swrl:argument1 core:a
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:ClassAtom ;
                                      swrl:classPredicate core:SeparationFairnessNotion ;
                                      swrl:argument1 core:b
                                    ] ;
                          rdf:rest rdf:nil
                        ]
             ] ;
   swrl:head [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                           swrl:propertyPredicate core:independenceSeparationConflictsWith ;
                           swrl:argument1 core:a ;
                           swrl:argument2 core:b
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                      swrl:propertyPredicate core:independenceSeparationConflictsWith ;
                                      swrl:argument1 core:b ;
                                      swrl:argument2 core:a
                                    ] ;
                          rdf:rest rdf:nil
                        ]
             ]
 ] .

