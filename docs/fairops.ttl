[ swrla:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:comment "Connect the FairnessConcern with the subset of FairnessMetrics that can quantify it (in the given AI Tupe Of Use) because they measure the Notions addressing that Concern" ;
   rdfs:label "GuidelineRule1" ;
   rdf:type swrl:Imp ;
   swrl:body [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                           swrl:propertyPredicate core:arisesIn ;
                           swrl:argument1 core:C ;
                           swrl:argument2 core:T
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                      swrl:propertyPredicate core:isSuitableFor ;
                                      swrl:argument1 core:M ;
                                      swrl:argument2 core:T
                                    ] ;
                          rdf:rest [ rdf:type swrl:AtomList ;
                                     rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                 swrl:propertyPredicate core:measures ;
                                                 swrl:argument1 core:M ;
                                                 swrl:argument2 core:N
                                               ] ;
                                     rdf:rest [ rdf:type swrl:AtomList ;
                                                rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                            swrl:propertyPredicate core:isAddressedWith ;
                                                            swrl:argument1 core:C ;
                                                            swrl:argument2 core:N
                                                          ] ;
                                                rdf:rest rdf:nil
                                              ]
                                   ]
                        ]
             ] ;
   swrl:head [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                           swrl:propertyPredicate core:isQuantifiedBy ;
                           swrl:argument1 core:C ;
                           swrl:argument2 core:M
                         ] ;
               rdf:rest rdf:nil
             ]
 ] .

[ swrla:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:comment "Connects the FairnessConcern with the subset of MitigationTechnique that can mitigate it. TO BE TESTED" ;
   rdfs:label "GuidelineRule2" ;
   rdf:type swrl:Imp ;
   swrl:body [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                           swrl:propertyPredicate core:isQuantifiedBy ;
                           swrl:argument1 core:C ;
                           swrl:argument2 core:M
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                      swrl:propertyPredicate core:enforces ;
                                      swrl:argument1 core:T ;
                                      swrl:argument2 core:M
                                    ] ;
                          rdf:rest rdf:nil
                        ]
             ] ;
   swrl:head [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                           swrl:propertyPredicate core:mitigatedWith ;
                           swrl:argument1 core:C ;
                           swrl:argument2 core:T
                         ] ;
               rdf:rest rdf:nil
             ]
 ] .

[ swrla:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:comment "" ;
   rdfs:label "hasBeenAppliedToRule" ;
   rdf:type swrl:Imp ;
   swrl:body [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                           swrl:propertyPredicate core:isProposedBy ;
                           swrl:argument1 core:SA ;
                           swrl:argument2 core:SP
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                      swrl:propertyPredicate core:testedOn ;
                                      swrl:argument1 core:SP ;
                                      swrl:argument2 core:D
                                    ] ;
                          rdf:rest [ rdf:type swrl:AtomList ;
                                     rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                 swrl:propertyPredicate core:relatesTo ;
                                                 swrl:argument1 core:D ;
                                                 swrl:argument2 core:AD
                                               ] ;
                                     rdf:rest rdf:nil
                                   ]
                        ]
             ] ;
   swrl:head [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                           swrl:propertyPredicate core:hasBeenAppliedTo ;
                           swrl:argument1 core:SA ;
                           swrl:argument2 core:AD
                         ] ;
               rdf:rest rdf:nil
             ]
 ] .

