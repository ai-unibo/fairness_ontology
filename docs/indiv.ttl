###  https://purl.org/fairops/indiv#DropoutOnAttention
indiv:DropoutOnAttention rdf:type owl:NamedIndividual ,
                                  core:FairnessRegularization ,
                                  core:FullRetraining ,
                                  core:MitigationTechnique ,
                                  core:ScientificArtifact ,
                                  core:TrainingResourcesMitigation ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty core:isAppliedAt ;
                                    owl:allValuesFrom core:In-processing
                                  ] ;
                         core:supportsComplianceWith indiv:Art.15 ,
                                                     indiv:Art.53 ;
                         core:scientificArtifactDescription "Use dropout during pre-training to reduce stereotypical gendered associations between words. By increasing dropout on the attention weights and hidden activations, the work hypothesizes that the interruption of the attention mechanism disrupts gendered correlations." .


