    core:isSuitableFor core:Recommendation ;
    core:isUsedBy papers:2017_LIN,
        papers:2020_KAYA ;
    core:refersTo core:ScoringRegression .

indiv:NonParityUnfairness a owl:NamedIndividual,
        core:AmortizedGranularityMetric,
        core:ImpactFocusedMetric,
        core:SingleGranularityMetric,
        core:TreatmentFocusedMetric,
        core:UserFocusedMetric ;
    core:extends indiv:OverestimationUnfairness,
        indiv:UnderestimationUnfairness ;
    core:isEquivalentTo indiv:AbsoluteDifference ;
    core:isProposedBy papers:2017_YAO,
        papers:2018_FARNADI ;
    core:isSuitableFor core:Recommendation ;
    core:isUsedBy papers:2017_YAO,
        papers:2018_FARNADI ;
    core:measures indiv:EqualOpportunity,
        indiv:StatisticalParity ;
    core:refersTo core:ScoringRegression .

indiv:OverestimationUnfairness a owl:NamedIndividual,
        core:AmortizedGranularityMetric,
        core:UserFocusedMetric ;
    core:isProposedBy papers:2017_YAO ;
    core:isSuitableFor core:Recommendation ;
    core:isUsedBy papers:2018_FARNADI ;
    core:measures indiv:EqualOpportunity ;
    core:refersTo core:ScoringRegression .

indiv:PredictiveParity a owl:NamedIndividual,
        core:ObservationalFairnessNotion,
        core:SufficiencyFairnessNotion ;
    rdfs:comment "2020_MANSOURY use precision (predictive parity) as a benchmarck metric to evaluate the fraction of the recommended items shown to the users that are part of the users’ profile in the test set. While predictive parity and calibration look like very similar criteria, test fair scores can fail to satisfy predictive parity at a given threshold. This is because the relationship between predictive parity and test fairness depends on the conditional distribution of R | A , which can differ across groups in ways that result in PPV imbalance. In the simple case where R itself is binary (Y^), a score that is test fair will also satisfy predictive parity." ;
    core:extends indiv:Calibration ;
    core:isProposedBy papers:2016_DIETERICH,
        papers:2017_CHOULDECHOVA,
        papers:2017_KUSNER ;
    core:isSuitableFor core:Conversation,
        core:Prediction ;
    core:isUsedBy papers:2020_MANSOURY ;
    core:refersTo core:Classification,
        core:TextGeneration .

indiv:PrejudiceIndex a owl:NamedIndividual ;
    core:isProposedBy papers:2012_KAMISHIMA ;
    core:isSuitableFor core:Prediction ;
    core:measures indiv:CounterfactualFairness ;
    core:refersTo core:Classification ;
    core:scientificArtifactDescription """An index to quantify the degree of indirect prejudice is defined as the mutual information between $Y$ (target random variable to be predicted) and $S$ (sensitive variable), considering the empirical (sample) distributions over a given dataset $\\mathcal{D}$:
\\[
\\mathrm{PI} = \\sum_{(y,s)\\in \\mathcal{D}} \\hat{P}(y,s)\\,\\ln \\frac{\\hat{P}(y,s)}{\\hat{P}(y)\\,\\hat{P}(s)}.
\\]""" .

indiv:ProportionalConsistencyScore a owl:NamedIndividual,
        core:DistanceBasedFairnessMetric ;
    core:extends indiv:ConsistencyScore ;
    core:isProposedBy papers:2025_WALLER ;
    core:isSuitableFor core:Prediction,
        core:Recommendation ;
    core:measures indiv:FairnessThroughAwareness ;
    core:refersTo core:Classification .

indiv:RegardClassifier a owl:NamedIndividual,
        core:FairnessRegularization ;
    core:scientificArtifactDescription "Regard Score measures polarity towards and perceptions of social groups, similar to a sentiment and respect score. Using prefix templates to prompt the language model (e.g., “The woman worked as”), they generate a human-annotated dataset to train a regard classifier where regard is a measure of positive or negative social connotation towards a social group. " .

indiv:RegularizationOnEmbeddings a owl:NamedIndividual,
        core:FairnessRegularization ;
    core:scientificArtifactDescription "introduce a regularization term that orthogonalizes stereotypical word embeddings and the gender direction in the embedding space. This term distances the embeddings of neutral occupation words from those of gender-inherent words (e.g., “sister” or “brother”). " .

indiv:RelativeLInfiniteMetric a owl:NamedIndividual,
        core:DistanceBasedFairnessMetric ;
    rdfs:comment "It is the second poposed metric connected to the notion of Fairness through awareness" ;
    core:extends indiv:FairnessThroughAwareness ;
    core:isProposedBy papers:2012_DWORK ;
    core:isSuitableFor core:Prediction,
        core:Recommendation ;
    core:isUsedBy papers:2018_YONA,
        papers:2019_LAHOTI,
        papers:2020_YUROCHKIN,
        papers:2025_GAO ;
    core:measures indiv:FairnessThroughAwareness ;
    core:refersTo core:Classification ;
    core:scientificArtifactDescription "Given P and Q, probability measures on a finite domain A, total variation norm suggests to compute the distance between the distributions as: $D_{\\infty}(P, Q) = \\sup_{a \\in A} \\log \\!\\left( \\max \\left\\{ \\frac{P(a)}{Q(a)}, \\frac{Q(a)}{P(a)} \\right\\} \\right) .$" .

indiv:SimilarityRobustnessOfIndividualConsistency a owl:NamedIndividual,
        core:DistanceBasedFairnessMetric ;
    core:extends indiv:ConsistencyScore ;
    core:isProposedBy papers:2025_WALLER ;
    core:isSuitableFor core:Prediction,
        core:Recommendation ;
    core:measures indiv:FairnessThroughAwareness ;
    core:refersTo core:Classification ;
    core:scientificArtifactDescription """SRIC quantifies the proportion of individuals for which the individual
consistency falls below or rises above a threshold $\\delta$ when comparing
two different notions of similarity $\\sigma_i$ and $\\sigma_j$.
\\begin{equation}
\\text{SRIC}^{\\delta}_{\\{\\sigma_i,\\sigma_j\\},k}
=
\\frac{1}{|E|}
\\left|
\\left\\{
x \\in E :
\\big(c^{\\sigma_i,k}(x) \\ge \\delta \\wedge c^{\\sigma_j,k}(x) < \\delta \\big)
\\ \\vee\\
\\big(c^{\\sigma_i,k}(x) < \\delta \\wedge c^{\\sigma_j,k}(x) \\ge \\delta \\big)
\\right\\}
\\right|
\\end{equation}
SRIC is defined with respect to a threshold $\\delta$, which specifies the
required proportion of similar individuals receiving equivalent treatment.""" .

indiv:TotalFairness a owl:NamedIndividual,
        core:IndependenceFairnessNotion,
        core:ObservationalFairnessNotion,
        core:SeparationFairnessNotion,
        core:SufficiencyFairnessNotion ;
    rdfs:comment "cannot be achieved except in highly artificial simulations" ;
    core:extends indiv:ConditionalUseAccuracyEquality,
        indiv:EqualizedOdds,
        indiv:OverallAccuracyEquality,
        indiv:StatisticalParity,
        indiv:TreatmentEquality ;
    core:isProposedBy papers:2021_BERK ;
    core:isSuitableFor core:Conversation,
        core:Prediction ;
    core:refersTo core:Classification,
        core:TextGeneration .

indiv:TotalVariationNorm a owl:NamedIndividual,
        core:DistanceBasedFairnessMetric ;
    rdfs:comment "It is the first poposed metric connected to the notion of Fairness through awareness" ;
    core:extends indiv:FairnessThroughAwareness ;
    core:isProposedBy papers:2012_DWORK ;
    core:isSuitableFor core:Prediction,
        core:Recommendation ;
    core:isUsedBy papers:2018_YONA,
        papers:2019_LAHOTI,
        papers:2020_YUROCHKIN,
        papers:2025_GAO ;
    core:measures indiv:FairnessThroughAwareness ;
    core:refersTo core:Classification ;
    core:scientificArtifactDescription "Given P and Q, probability measures on a finite domain A, total variation norm suggests to compute the distance between the distributions as: $D_{\\mathrm{tv}}(P, Q) = \\frac{1}{2} \\sum_{a \\in A} | P(a) - Q(a) | .$" .

indiv:UnderestimationUnfairness a owl:NamedIndividual,
        core:AmortizedGranularityMetric,
        core:UserFocusedMetric ;
    core:isProposedBy papers:2017_YAO ;
    core:isSuitableFor core:Recommendation ;
    core:isUsedBy papers:2018_FARNADI ;
    core:measures indiv:EqualOpportunity ;
    core:refersTo core:ScoringRegression .

indiv:AbsoluteDifference a owl:NamedIndividual,
        core:AmortizedGranularityMetric,
        core:ImpactFocusedMetric,
        core:ItemFocusedMetric,
        core:SingleGranularityMetric,
        core:TreatmentFocusedMetric,
        core:UserFocusedMetric ;
    core:extends indiv:NonParityUnfairness ;
    core:isProposedBy papers:2018_ZHU,
        papers:2020_FU,
        papers:2021_LI,
        papers:2021_WANG,
