        papers:2021_LI,
        papers:2021_WANG ;
    core:measures indiv:StatisticalParity ;
    core:refersTo core:ScoringRegression .

indiv:AdvBERT a owl:NamedIndividual,
        core:AdversarialLearning ;
    core:scientificArtifactDescription "Adversarial learning with a ranking of information retrieval results to reduce bias while maintaining relevance, proposing a gender-invariant ranking model. Contrastive pairs consist of a relevant and non-relevant document to a query, with a corresponding social group label denoting if the query or document contains the protected attribute. The adversarial discriminator predicts the social group label from an encoder, while the encoder simultaneously tries to trick the discriminator while also maximizing relevance scores." .

indiv:Art.13 a owl:NamedIndividual,
        core:ManagementLegalRequirement ;
    ns1:SIO_000068 core:EU_AI_Act ;
    rdfs:comment "Requires providers to ensure that high-risk AI systems are accompanied by clear instructions for use and information about performance, assumptions, limitations and foreseeable risks to fundamental rights. Notes: Operational transparency layer: communicate applicable fairness notions, the metrics used to evidence them (incl. parity, error gaps, counterfactual instability, calibration/divergence), evaluation conditions and limits; document active safeguards and the operational response when monitoring signals degrade." ;
    core:isOperationalizedBy indiv:Calibration,
        indiv:ConditionalStatisticalParity,
        indiv:CounterfactualFairness,
        indiv:DemographicParity,
        indiv:EqualOpportunity,
        indiv:EqualizedOdds,
        indiv:ErrorRateBalance,
        indiv:FalseNegativeErrorRateBalance,
        indiv:FalsePositiveErrorRateBalance,
        indiv:PredictiveEquality,
        indiv:StatisticalParity,
        indiv:TestFairness ;
    core:itsComplianceIsSupportedWith indiv:AddNonToxicExamples,
        indiv:AdversarialFDP,
        indiv:AugmentedAntidoteData,
        indiv:BlocklistDocumentRemoval,
        indiv:CDA,
        indiv:CalibratedReRanking,
        indiv:ControlOffensiveTokens,
        indiv:ListReAdjustment,
        indiv:LogLikeDocumentRemoval,
        indiv:PerceptronForUnawareness,
        indiv:REALTOXICITYPROMPTS,
        indiv:ReSamplingProtectedGroup,
        indiv:RegularizationOnANOVA,
        indiv:RegularizationOnValueFairness,
        indiv:UserItemReRanking .

indiv:ChangeAttentionScores a owl:NamedIndividual,
        core:HeadOnly ;
    core:scientificArtifactDescription "Address stereotypes learned in the attention layer of sentence-level encoders by redistributing attention scores, fine-tuning the encoder with an equalization loss that encourages equal attention scores (e.g., to attend to “doctor”) with respect to each social group (e.g., “he” and “she”), while minimizing changes to the attention of other words in the sentence. The equalization loss is added as a regularization term to a semantic information preservation term that computes the distance between the original and fine-tuned models’ attention scores." .

indiv:ChangeAttentionWeights a owl:NamedIndividual,
        core:SelectiveParameterUpdating ;
    core:scientificArtifactDescription "modify the attention weights after training, applying temperature scaling controlled by a hyperparameter that can be tuned to maximize some fairness metric. The hyperparameter can either increase entropy to focus on a broader set of potentially less stereotypical tokens, or can decrease entropy to attend to a narrower context, which may reduce exposure to stereotypical tokens." .

indiv:DisparateImpact a owl:NamedIndividual,
        core:ParityBasedFairnessMetric ;
    core:extends indiv:StatisticalParity ;
    core:isProposedBy papers:2015_FELDMAN ;
    core:isSuitableFor core:Conversation,
        core:Prediction,
        core:Recommendation ;
    core:isUsedBy papers:2015_FELDMAN,
        papers:2017_CHOULDECHOVA,
        papers:2023_GIULIANI ;
    core:measures indiv:StatisticalParity ;
    core:refersTo core:Classification,
        core:TextGeneration .

indiv:DropoutOnAttention a owl:NamedIndividual,
        core:FairnessRegularization ;
    core:scientificArtifactDescription "Use dropout during pre-training to reduce stereotypical gendered associations between words. By increasing dropout on the attention weights and hidden activations, the work hypothesizes that the interruption of the attention mechanism disrupts gendered correlations." .

indiv:EquityOfAttention a owl:NamedIndividual,
        core:IndividualFairnessNotion,
        core:ObservationalFairnessNotion ;
    core:extends indiv:EqualityOfAttention ;
    core:isEquivalentTo indiv:QualityWeightedFairness ;
    core:isMeasuredBy indiv:KLDivergence,
        indiv:L1Norm ;
    core:isProposedBy papers:2018_BIEGA ;
    core:isSuitableFor core:Recommendation ;
    core:refersTo core:ScoringRegression ;
    core:scientificArtifactDescription """A ranking offers equity of attention if each subject receives attention proportional to its relevance:
\\begin{equation}
\\frac{a_{i_1}}{r_{i_1}} = \\frac{a_{i_2}}{r_{i_2}}, \\quad \\forall\\, u_{i_1}, u_{i_2}.
\\end{equation}""" .

indiv:JainIndex a owl:NamedIndividual,
        core:AmortizedGranularityMetric,
        core:ImpactFocusedMetric,
        core:ItemFocusedMetric,
        core:SingleGranularityMetric,
        core:TreatmentFocusedMetric,
        core:UserFocusedMetric ;
    rdfs:comment "Jain index has all 4 properties of population size-independence, scale indep., boundedness, continuity.  Jain index is also called Opportunity fairness [2017_LIN]" ;
    core:extends indiv:MinMaxRatio,
        indiv:Variance ;
    core:isProposedBy papers:1984_JAIN ;
    core:isSuitableFor core:Recommendation ;
    core:isUsedBy papers:2017_LIN,
        papers:2020_ZHU ;
    core:measures indiv:StatisticalParity ;
    core:refersTo core:ScoringRegression .

indiv:OSCAR a owl:NamedIndividual,
        core:Transformation ;
    core:scientificArtifactDescription "Bias removal while maintaining relevant semantic information: orthogonalize two directions that should be independent, such as gender and occupation, while minimizing the change in the embeddings to preserve important semantic meaning from gendered words." .

indiv:TreatmentEquality a owl:NamedIndividual,
        core:ObservationalFairnessNotion,
        core:SeparationFairnessNotion ;
    rdfs:comment "Extends Overall accuracy equality, because even if the accuracy is the same for both groups, it might happend that, when a misclassification occurr for a group, it is more likely to be a FN than a FP" ;
    core:extends indiv:EqualizedOdds,
        indiv:OverallAccuracyEquality ;
    core:isProposedBy papers:2021_BERK ;
    core:isSuitableFor core:Conversation,
        core:Prediction ;
    core:refersTo core:Classification,
        core:TextGeneration .

indiv:TruePositiveRateDifference a owl:NamedIndividual,
        core:ConfusionMatrixBasedFairnessMetric ;
    core:isEquivalentTo indiv:EqualOpportunity ;
    core:isProposedBy papers:2019_DE_ARTEAGA ;
    core:isSuitableFor core:Conversation,
        core:Prediction ;
    core:isUsedBy papers:2019_BELLAMY,
        papers:2019_PROST,
        papers:2021_JIN,
        papers:2022_STEED,
        papers:2023_TOKPO,
        papers:2025_RUSSO ;
    core:measures indiv:EqualOpportunity,
        indiv:FalseNegativeErrorRateBalance ;
    core:refersTo core:Classification,
        core:TextGeneration .

indiv:Art.10.4 a owl:NamedIndividual,
        core:TechnicalLegalRequirement ;
    ns1:SIO_000068 core:EU_AI_Act ;
    rdfs:comment "Datasets shall, to the best extent possible, take into account the specific geographical, behavioural and functional context in which the AI system is intended to be used, so that performance and fairness generalise to the deployment environment. Notes: Addresses fairness risks due to domain shift between training data and the real-world context of use." ;
    core:isOperationalizedBy indiv:Calibration,
        indiv:ConditionalStatisticalParity,
        indiv:CounterfactualFairness,
        indiv:DemographicParity,
        indiv:StatisticalParity,
        indiv:TestFairness ;
    core:itsComplianceIsSupportedWith indiv:AugmentedAntidoteData,
        indiv:CDA,
        indiv:CalibratedReRanking,
        indiv:ListReAdjustment,
        indiv:ReSamplingProtectedGroup,
        indiv:UserItemReRanking .

indiv:ConditionalProcedureAccuracyEquality a owl:NamedIndividual,
        core:ObservationalFairnessNotion,
        core:SeparationFairnessNotion ;
    rdfs:comment "Equal opportunity  and Predictive equality  i.e., if you satisfy Equalized odds, than you also satisfy Equal opportunity" ;
    core:extends indiv:EqualOpportunity,
        indiv:PredictiveEquality ;
    core:isEquivalentTo indiv:EqualizedOdds ;
    core:isMeasuredBy indiv:OutcomeUnfairness ;
    core:isProposedBy papers:2021_BERK ;
    core:isSuitableFor core:Conversation,
        core:Prediction ;
    core:refersTo core:Classification,
        core:TextGeneration .

indiv:FairRecommendationForCustomer a owl:NamedIndividual,
        core:IndividualFairnessNotion,
        core:ObservationalFairnessNotion ;
    core:isMeasuredBy indiv:Variance ;
    core:isProposedBy papers:2021_WU ;
    core:isSuitableFor core:Recommendation ;
    core:refersTo core:ScoringRegression ;
    core:scientificArtifactDescription "The  recommendation is fair for customers if each customer receives recommendation results with the same Normalized Discounted Cumulative Gain (NDCG) value,i.e., $NDCG(u_1) = NDCG(u_2), \\forall u_1, u_2 \\in U$. NDCG is a ranking metric used to evaluate recommendation systems by measuring the quality of the ranked list of recommended items. It assesses a system's ability to place the most relevant items at the top of the list, with higher scores indicating a better ranking. NDCG is calculated by dividing the Discounted Cumulative Gain (DCG) of the actual recommendation list by the DCG of an ideal list, resulting in a score between 0 and 1." .

indiv:L1Norm a owl:NamedIndividual,
        core:AmortizedGranularityMetric,
        core:ImpactFocusedMetric,
        core:ItemFocusedMetric,
        core:SingleGranularityMetric,
        core:TreatmentFocusedMetric,
        core:UserFocusedMetric ;
    core:isProposedBy papers:2018_BIEGA ;
    core:isSuitableFor core:Recommendation ;
    core:isUsedBy papers:2019_BORGES,
        papers:2021_KLRNAP ;
    core:refersTo core:ScoringRegression .

indiv:NamesIntervention a owl:NamedIndividual,
        core:CounterfactualAugmentation ;
    core:scientificArtifactDescription "considers only first names, as opposed to all gendered words: ssociates masculine-specified names with feminine-specified pairs (based on name frequencies in the United States), which can be swapped during CDA." .

indiv:OutcomeUnfairness a owl:NamedIndividual,
        core:ConfusionMatrixBasedFairnessMetric ;
    rdfs:comment "values in R+, the closer to 0, the better" ;
    core:extends indiv:EqualOpportunity,
        indiv:FalseNegativeErrorRateBalance ;
    core:isProposedBy papers:2016_GRGIC_HLACA ;
    core:isSuitableFor core:Conversation,
        core:Prediction ;
    core:measures indiv:ConditionalProcedureAccuracyEquality,
        indiv:EqualizedOdds,
        indiv:ErrorRateBalance ;
    core:refersTo core:Classification,
        core:TextGeneration .

indiv:OverallAccuracyEquality a owl:NamedIndividual,
        core:ObservationalFairnessNotion,
        core:SeparationFairnessNotion ;
    rdfs:comment "Extends equal opportunity because also considers the TNR (besides TPR)" ;
    core:extends indiv:EqualOpportunity ;
    core:isProposedBy papers:2021_BERK ;
    core:isSuitableFor core:Conversation,
        core:Prediction ;
    core:refersTo core:Classification,
        core:TextGeneration .

indiv:PoliteAlternatives a owl:NamedIndividual,
        core:OutputRewriting ;
    core:scientificArtifactDescription "use a a dataset of sentence rewrites to train rewriting models to generate more polite outputs, preserving semantic information but altering the emotion and sentiment." .

indiv:PredictedReplacements a owl:NamedIndividual,
        core:OutputRewriting ;
    core:scientificArtifactDescription "Use LIME (2016_RIBEIRO) to identify tokens responsible for bias in an output and predict new tokens for replacement based on the latent representations of the original sentence" .

indiv:UniformFairness a owl:NamedIndividual,
        core:IndependenceFairnessNotion,
        core:ObservationalFairnessNotion ;
    core:isMeasuredBy indiv:Variance ;
    core:isProposedBy papers:2021_WU ;
    core:isSuitableFor core:Recommendation ;
    core:refersTo core:ScoringRegression ;
    core:scientificArtifactDescription """A recommendation result has  the property of uniform fair exposure for providers if each provider receives exposure ($e_p$) proportional to the number of items it offers ($I_p$), i.e., $\\frac{e_{p_1}}{\\lvert I_{p_1} \\rvert} = \\frac{e_{p_2}}{\\lvert I_{p_2} \\rvert},
\\quad \\forall\\, p_1, p_2 \\in P $, where P is the set of providers. Note that providers can be seen as groups of items. Hence, this is a group fairness notion.""" .

indiv:Art.10.3 a owl:NamedIndividual,
        core:TechnicalLegalRequirement ;
    ns1:SIO_000068 core:EU_AI_Act ;
    rdfs:comment "Training, validation and testing data must be relevant, representative, free of errors and complete, with appropriate statistical properties, including where applicable in relation to the persons or groups for whom the system is intended. Notes: Central data-governance requirement on distribution and representativeness for fairness." ;
    core:isOperationalizedBy indiv:ConditionalStatisticalParity,
        indiv:CounterfactualFairness,
        indiv:DemographicParity,
        indiv:FairnessThroughAwareness,
        indiv:IndividualFairness,
        indiv:StatisticalParity ;
    core:itsComplianceIsSupportedWith indiv:AddNonToxicExamples,
        indiv:AugmentedAntidoteData,
        indiv:BlocklistDocumentRemoval,
        indiv:CDA,
        indiv:GenderneutralAlternatives,
        indiv:LogLikeDocumentRemoval,
        indiv:ReSamplingProtectedGroup,
        indiv:ReplaceStereotypes .

indiv:MatchingConditionalFrequencies a owl:NamedIndividual,
        core:ObservationalFairnessNotion,
        core:SufficiencyFairnessNotion ;
    owl:sameAs indiv:Calibration,
        indiv:TestFairness ;
    core:isEquivalentTo indiv:Calibration,
        indiv:TestFairness ;
    core:isProposedBy papers:2018_VERMA ;
    core:isSuitableFor core:Conversation,
        core:Prediction ;
    core:refersTo core:Classification,
        core:TextGeneration .

indiv:QualityWeightedFairness a owl:NamedIndividual,
        core:IndependenceFairnessNotion,
        core:ObservationalFairnessNotion ;
    rdfs:comment "the metric is first used in 2018_BIEGA, but the formailization is due to a later work by 2021_WU" ;
    core:isEquivalentTo indiv:EquityOfAttention ;
    core:isMeasuredBy indiv:Variance ;
    core:isProposedBy papers:2021_WU ;
    core:isSuitableFor core:Recommendation ;
    core:isUsedBy papers:2018_BIEGA ;
    core:refersTo core:ScoringRegression ;
    core:scientificArtifactDescription """A recommendation result is quality weighted fair exposure for providers if each provider in P receives exposure ($e_p$) proportional to the sum of quality scores (i.e., ratings) of items it offers ($I_p$) in the recommendation lists of all customers, i.e., $\\frac{e_{p_1}}{\\sum_{i \\in I_{p_1}} \\sum_{u \\in U} v_{u,i}}= \\frac{e_{p_2}}{ \\sum_{i \\in I_{p_2}} \\sum_{u \\in U} v_{u,i}},
\\quad \\forall\\, p_1, p_2 \\in P .$""" .

