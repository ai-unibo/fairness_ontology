###  https://purl.org/fairops/indiv#ADELE
indiv:ADELE rdf:type owl:NamedIndividual ,
                     core:Adapters ,
                     core:MitigationTechnique ,
                     core:ModelAccessResourcesMitigation ,
                     core:PartialFineTuning ,
                     core:ScientificArtifact ,
                     core:TrainingResourcesMitigation ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty core:isAppliedAt ;
                       owl:allValuesFrom core:In-processing
                     ] ;
            core:supportsComplianceWith indiv:Art.53 ;
            core:scientificArtifactDescription "Introduce debiasing adapter modules, called ADELE, to mitigate gender bias. The technique is based on modular adapter frameworks (2019_HOULSBY) that add new, randomly initialized layers between the original layers for parameter-efficient fine-tuning; only the injected layers are updated during fine-tuning, while the pre-trained ones remain frozen." .


###  https://purl.org/fairops/indiv#AbsoluteDifference
indiv:AbsoluteDifference rdf:type owl:NamedIndividual ,
                                  core:AmortizedGranularityMetric ,
                                  core:GranularityMetric ,
                                  core:ImpactFocusedMetric ,
                                  core:ItemFocusedMetric ,
                                  core:OptimizationObjectMetric ,
                                  core:RecommendationSystemMetric ,
                                  core:ScientificArtifact ,
                                  core:SingleGranularityMetric ,
                                  core:SubjectMetric ,
                                  core:TreatmentFocusedMetric ,
                                  core:UserFocusedMetric ,
                                  <https://purl.org/twc/fmo#fairness_metric> ,
                                  <https://purl.org/twc/fmo#fairness_notion> ;
                         core:extends indiv:NonParityUnfairness ;
                         core:hasBeenAppliedTo core:RetailAndECommerce ;
                         core:hasBeenTestedOn papers:Amazon ,
                                              papers:Movielens100K ,
                                              papers:Movielens1M ;
                         core:isEquivalentTo indiv:NonParityUnfairness ;
                         core:isProposedBy <https://purl.org/fairops/papers#2018_ZHU> ,
                                           <https://purl.org/fairops/papers#2020_FU> ,
                                           <https://purl.org/fairops/papers#2021_LI> ,
                                           <https://purl.org/fairops/papers#2021_WANG> ,
                                           <https://purl.org/fairops/papers#2023_WANG> ;
                         core:isSuitableFor core:Recommendation ;
                         core:isUsedBy <https://purl.org/fairops/papers#2018_ZHU> ,
                                       <https://purl.org/fairops/papers#2020_FU> ,
                                       <https://purl.org/fairops/papers#2021_LI> ,
                                       <https://purl.org/fairops/papers#2021_WANG> ,
                                       <https://purl.org/fairops/papers#2023_WANG> ;
                         core:measures indiv:DemographicParity ,
                                       indiv:DiscriminationScore ,
                                       indiv:StatisticalParity ;
                         core:refersTo core:ScoringRegression .


