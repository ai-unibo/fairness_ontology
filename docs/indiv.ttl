                                                                       indiv:OverallAccuracyEquality ,
                                                                       indiv:PredictiveEquality ,
                                                                       indiv:TotalFairness ,
                                                                       indiv:TreatmentEquality ;
                              core:independenceSufficiencyConflictsWith indiv:Calibration ,
                                                                        indiv:ConditionalUseAccuracyEquality ,
                                                                        indiv:EquityOfAmortizedAttention ,
                                                                        indiv:FalseDiscoveryParity ,
                                                                        indiv:MatchingConditionalFrequencies ,
                                                                        indiv:PredictiveParity ,
                                                                        indiv:TestFairness ,
                                                                        indiv:TotalFairness ,
                                                                        indiv:WellCalibration ;
                              core:isEquivalentTo indiv:EquityOfAttention ;
                              core:isMeasuredBy indiv:GroupUnfairness ,
                                                indiv:IndividualUnfairness ,
                                                indiv:Variance ;
                              core:isProposedBy <https://purl.org/fairops/papers#2021_WU> ;
                              core:isSuitableFor core:Recommendation ;
                              core:isUsedBy <https://purl.org/fairops/papers#2018_BIEGA> ,
                                            <https://purl.org/fairops/papers#2021_WU> ;
                              core:refersTo core:ScoringRegression ;
                              core:scientificArtifactDescription """A recommendation result is quality weighted fair exposure for providers if each provider in P receives exposure ($e_p$) proportional to the sum of quality scores (i.e., ratings) of items it offers ($I_p$) in the recommendation lists of all customers, i.e., $\\frac{e_{p_1}}{\\sum_{i \\in I_{p_1}} \\sum_{u \\in U} v_{u,i}}= \\frac{e_{p_2}}{ \\sum_{i \\in I_{p_2}} \\sum_{u \\in U} v_{u,i}},
\\quad \\forall\\, p_1, p_2 \\in P .$""" ;
                              rdfs:comment "the metric is first used in 2018_BIEGA, but the formailization is due to a later work by 2021_WU" .


