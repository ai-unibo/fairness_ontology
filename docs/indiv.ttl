                      core:hasBeenTestedOn papers:LastFM360K ;
                      core:independenceSeparationConflictsWith indiv:BalanceForNegativeClass ,
                                                               indiv:BalanceForPositiveClass ,
                                                               indiv:ConditionalEqualOpportunity ,
                                                               indiv:ConditionalProcedureAccuracyEquality ,
                                                               indiv:EqualOpportunity ,
                                                               indiv:EqualizedOdds ,
                                                               indiv:EqualizingDisincentives ,
                                                               indiv:ErrorRateBalance ,
                                                               indiv:FalseNegativeErrorRateBalance ,
                                                               indiv:FalsePositiveErrorRateBalance ,
                                                               indiv:OverallAccuracyEquality ,
                                                               indiv:PredictiveEquality ,
                                                               indiv:TotalFairness ,
                                                               indiv:TreatmentEquality ;
                      core:independenceSufficiencyConflictsWith indiv:Calibration ,
                                                                indiv:ConditionalUseAccuracyEquality ,
                                                                indiv:EquityOfAmortizedAttention ,
                                                                indiv:FalseDiscoveryParity ,
                                                                indiv:MatchingConditionalFrequencies ,
                                                                indiv:PredictiveParity ,
                                                                indiv:TestFairness ,
                                                                indiv:TotalFairness ,
                                                                indiv:WellCalibration ;
                      core:isMeasuredBy indiv:GroupUnfairness ,
                                        indiv:IndividualUnfairness ,
                                        indiv:Variance ;
                      core:isProposedBy <https://purl.org/fairops/papers#2021_WU> ;
                      core:isSuitableFor core:Recommendation ;
                      core:isUsedBy <https://purl.org/fairops/papers#2021_WU> ;
                      core:refersTo core:ScoringRegression ;
                      core:scientificArtifactDescription """A recommendation result has  the property of uniform fair exposure for providers if each provider receives exposure ($e_p$) proportional to the number of items it offers ($I_p$), i.e., $\\frac{e_{p_1}}{\\lvert I_{p_1} \\rvert} = \\frac{e_{p_2}}{\\lvert I_{p_2} \\rvert},
\\quad \\forall\\, p_1, p_2 \\in P $, where P is the set of providers. Note that providers can be seen as groups of items. Hence, this is a group fairness notion.""" .


