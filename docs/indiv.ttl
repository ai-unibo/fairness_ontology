###  https://purl.org/fairops/indiv#FairRecommendationForCustomer
indiv:FairRecommendationForCustomer rdf:type owl:NamedIndividual ,
                                             core:IndividualFairnessNotion ,
                                             core:ObservationalFairnessNotion ,
                                             core:OutcomeFairnessNotion ,
                                             core:ScientificArtifact ,
                                             <https://purl.org/twc/fmo#fairness_notion> ;
                                    core:conflictsWith indiv:FairnessThroughUnawareness ;
                                    core:hasBeenAppliedTo core:RetailAndECommerce ;
                                    core:hasBeenTestedOn papers:LastFM360K ;
                                    core:isMeasuredBy indiv:GroupUnfairness ,
                                                      indiv:IndividualUnfairness ,
                                                      indiv:Variance ;
                                    core:isProposedBy <https://purl.org/fairops/papers#2021_WU> ;
                                    core:isSuitableFor core:Recommendation ;
                                    core:isUsedBy <https://purl.org/fairops/papers#2021_WU> ;
                                    core:refersTo core:ScoringRegression ;
                                    core:scientificArtifactDescription "The  recommendation is fair for customers if each customer receives recommendation results with the same Normalized Discounted Cumulative Gain (NDCG) value,i.e., $NDCG(u_1) = NDCG(u_2), \\forall u_1, u_2 \\in U$. NDCG is a ranking metric used to evaluate recommendation systems by measuring the quality of the ranked list of recommended items. It assesses a system's ability to place the most relevant items at the top of the list, with higher scores indicating a better ranking. NDCG is calculated by dividing the Discounted Cumulative Gain (DCG) of the actual recommendation list by the DCG of an ideal list, resulting in a score between 0 and 1." .


###  https://purl.org/fairops/indiv#FairScore
indiv:FairScore rdf:type owl:NamedIndividual ,
                         core:ScientificArtifact ,
                         core:ScoreBasedFairnessMetric ,
                         <https://purl.org/twc/fmo#fairness_metric> ;
                core:hasBeenAppliedTo core:Dialogue ;
                core:hasBeenTestedOn papers:PANDA ;
                core:isProposedBy <https://purl.org/fairops/papers#2022_QIAN> ;
                core:isSuitableFor core:Conversation ,
                                   core:Prediction ;
                core:isUsedBy <https://purl.org/fairops/papers#2022_QIAN> ,
                              <https://purl.org/fairops/papers#2025_RUSSO> ;
                core:measures indiv:CounterfactualFairness ;
                core:refersTo core:TextGeneration ;
                core:scientificArtifactDescription """Is a counterfactual fairness metric that measures “the change in model predictions between the original evaluation dataset and the perturbation augmented version”, with a comparatively lower score indicating a fairer model. The fairscore of a classifier is defined as the percentage of predictions that differ when the input is demographically altered. More formally, for a perturber model $f_P$ and a text snippet $x$, let $\\tilde{x} \\sim f_P(x)$ be the demographically altered perturber output. A classifier $f_C$ exhibits bias if, for some input $x$ and its demographically perturbed version $\\tilde{x}$, the predictions differ, i.e.,
\\[
f_C(x) \\neq f_C(\\tilde{x}).
\\]
Given a classifier $f_C$ and an evaluation set $X$, we define the \\emph{fairscore} $F_S$ as
\\[
F_S(f_C, X)
=
\\frac{\\left| \\{ x \\in X \\mid f_C(x) \\neq f_C(\\tilde{x}) \\} \\right|}{|X|}.
\\]""" .


###  https://purl.org/fairops/indiv#FairnessThroughAwareness
indiv:FairnessThroughAwareness rdf:type owl:NamedIndividual ,
                                        core:IndividualFairnessNotion ,
                                        core:ObservationalFairnessNotion ,
                                        core:OutcomeFairnessNotion ,
                                        core:ScientificArtifact ,
                                        <https://purl.org/twc/fmo#fairness_notion> ;
                               owl:sameAs indiv:IndividualFairness ;
                               core:conflictsWith indiv:FairnessThroughUnawareness ;
                               core:isEquivalentTo indiv:ConsistencyScore ,
                                                   indiv:FairnessThroughAwareness ,
                                                   indiv:IndividualFairness ;
                               core:isMeasuredBy indiv:BalancedConditionedConsistency ,
                                                 indiv:ConsistencyScore ,
                                                 indiv:IndividualConsistencyScore ,
                                                 indiv:LowIndividualConsistencyCount ,
                                                 indiv:ProportionalConsistencyScore ,
                                                 indiv:RelativeLInfiniteMetric ,
                                                 indiv:SimilarityRobustnessOfIndividualConsistency ,
                                                 indiv:TotalVariationNorm ;
                               core:isProposedBy <https://purl.org/fairops/papers#2012_DWORK> ;
                               core:isSuitableFor core:Prediction ,
                                                  core:Recommendation ;
                               core:isUsedBy <https://purl.org/fairops/papers#2012_DWORK> ,
                                             <https://purl.org/fairops/papers#2018_YONA> ,
                                             <https://purl.org/fairops/papers#2019_LAHOTI> ,
                                             <https://purl.org/fairops/papers#2020_YUROCHKIN> ,
                                             <https://purl.org/fairops/papers#2025_GAO> ;
                               core:operationalize indiv:Art.10 ,
                                                   indiv:Art.10.3 ,
                                                   indiv:Art.11 ,
                                                   indiv:Art.12 ,
                                                   indiv:Art.14 ,
                                                   indiv:Art.15 ,
                                                   indiv:Art.16 ,
                                                   indiv:Art.17 ,
                                                   indiv:Art.20 ,
                                                   indiv:Art.24 ,
                                                   indiv:Art.26 ,
                                                   indiv:Art.27 ,
                                                   indiv:Art.29 ,
                                                   indiv:Art.4 ,
                                                   indiv:Art.43 ,
                                                   indiv:Art.5 ,
                                                   indiv:Art.53 ,
                                                   indiv:Art.6 ,
                                                   indiv:Art.6.2 ,
                                                   indiv:Art.72.1 ,
                                                   indiv:Art.77 ,
                                                   indiv:Art.9 ;
                               core:refersTo core:Classification ;
                               core:scientificArtifactDescription """An algorithm is fair if it gives similar predictions to similar individuals
Awareness is based on the Lipschitz condition, which requires that any two individuals 
$x$ and $y$ at distance $d(x,y) \\in [0,1]$ map to distributions $M(x)$ and $M(y)$, respectively, such that the statistical distance between them is at most $d(x,y)$:
\\[
D(M(x_1), M(x_2)) \\le d(x_1, x_2), 
\\quad \\forall x_1, x_2 \\in E .
\\]

Here, $M(x)$ denotes the probability distribution of the output for individual $x$, 
$E$ is a dataset, $D(\\cdot,\\cdot)$ returns the statistical distance between 
$M(x_1)$ and $M(x_2)$, and $d(\\cdot,\\cdot)$ denotes a distance between individuals 
$x_1$ and $x_2$, defined using a pre-specified, domain-dependent notion of similarity.
\\cite{2025_WALLER}""" .


