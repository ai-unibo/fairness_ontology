        papers:2018_STECK,
        papers:2018_XU,
        papers:2018_ZHU,
        papers:2019_CELISa,
        papers:2019_MAUDSLAY,
        papers:2019_RASTEGARPANAH,
        papers:2019_SHENG,
        papers:2020_GEHMAN,
        papers:2020_LU,
        papers:2020_PATRO,
        papers:2020_RAFFEL,
        papers:2020_WAN,
        papers:2020_XU,
        papers:2020_ZHU,
        papers:2021_DEV,
        papers:2021_GE,
        papers:2021_ISLAM,
        papers:2021_JAIN,
        papers:2021_LAUSCHER,
        papers:2021_NGO,
        papers:2021_REKABSAZ,
        papers:2021_ROH,
        papers:2021_WEBSTER,
        papers:2022_BORCHERS,
        papers:2022_GACI,
        papers:2022_GARIMELLA,
        papers:2022_HANa,
        papers:2022_MANSOURY,
        papers:2022_TOKPO,
        papers:2022_WANG,
        papers:2023_DHINGRA,
        papers:2023_HAUZENBERGER,
        papers:2023_KUMARa,
        papers:2023_LIU,
        papers:2023_PARK,
        papers:2023_ZAYED,
        papers:2024_SUKUMARAN,
        papers:2025_SIKDER,
        papers:2025_ZHOU ;
    core:measures indiv:CounterfactualFairness ;
    core:refersTo core:Classification ;
    core:scientificArtifactDescription """The application of the normalization technique for mutual information to the prejudice index leads to a normalized prejudice index (NPI for short):
\\[
\\mathrm{NPI} = \\frac{\\mathrm{PI}}{\\sqrt{H(Y)\\,H(S)}}.
\\]""" .

indiv:OpportunityFairness a owl:NamedIndividual,
        core:ItemFocusedMetric,
        core:SingleGranularityMetric,
        core:TreatmentFocusedMetric ;
    core:extends indiv:JainIndex ;
    core:isEquivalentTo indiv:JainIndex ;
    core:isProposedBy papers:2020_ZHU ;
    core:isSuitableFor core:Recommendation ;
    core:measures indiv:StatisticalParity ;
    core:refersTo core:ScoringRegression ;
    core:scientificArtifactDescription """Opportunity fairness is a metric to measure the fairness of recommendation opportunity, which can be expressed by Jain’s fairness index~\\cite{20}:
\\begin{equation}
J(\\mathbf{a}) = \\frac{\\left( \\sum_{i=1}^{n} a_i \\right)^2}{n \\sum_{i=1}^{n} a_i^2}
\\end{equation}
where $J(\\mathbf{a})$ denotes Jain’s fairness index, $n$ denotes the total number of candidates with the same function, and $a_i$ represents the number of recommendations of APP $i$. The value $a_i$ can be any positive integer.""" .

