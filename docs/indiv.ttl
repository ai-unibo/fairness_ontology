###  https://purl.org/fairops/indiv#RelativeLInfiniteMetric
indiv:RelativeLInfiniteMetric rdf:type owl:NamedIndividual ,
                                       core:DistanceBasedFairnessMetric ,
                                       core:ScientificArtifact ,
                                       <https://purl.org/twc/fmo#fairness_metric> ;
                              core:extends indiv:FairnessThroughAwareness ,
                                           indiv:IndividualFairness ;
                              core:isProposedBy <https://purl.org/fairops/papers#2012_DWORK> ;
                              core:isSuitableFor core:Prediction ,
                                                 core:Recommendation ;
                              core:isUsedBy <https://purl.org/fairops/papers#2012_DWORK> ,
                                            <https://purl.org/fairops/papers#2018_YONA> ,
                                            <https://purl.org/fairops/papers#2019_LAHOTI> ,
                                            <https://purl.org/fairops/papers#2020_YUROCHKIN> ,
                                            <https://purl.org/fairops/papers#2025_GAO> ;
                              core:measures indiv:FairnessThroughAwareness ,
                                            indiv:IndividualFairness ;
                              core:refersTo core:Classification ;
                              core:scientificArtifactDescription "Given P and Q, probability measures on a finite domain A, total variation norm suggests to compute the distance between the distributions as: $D_{\\infty}(P, Q) = \\sup_{a \\in A} \\log \\!\\left( \\max \\left\\{ \\frac{P(a)}{Q(a)}, \\frac{Q(a)}{P(a)} \\right\\} \\right) .$" ;
                              rdfs:comment "It is the second poposed metric connected to the notion of Fairness through awareness" .


