                                   core:independenceSeparationConflictsWith indiv:BalanceForNegativeClass ,
                                                                            indiv:BalanceForPositiveClass ,
                                                                            indiv:ConditionalEqualOpportunity ,
                                                                            indiv:ConditionalProcedureAccuracyEquality ,
                                                                            indiv:EqualOpportunity ,
                                                                            indiv:EqualizedOdds ,
                                                                            indiv:EqualizingDisincentives ,
                                                                            indiv:ErrorRateBalance ,
                                                                            indiv:FalseNegativeErrorRateBalance ,
                                                                            indiv:FalsePositiveErrorRateBalance ,
                                                                            indiv:OverallAccuracyEquality ,
                                                                            indiv:PredictiveEquality ,
                                                                            indiv:TotalFairness ,
                                                                            indiv:TreatmentEquality ;
                                   core:independenceSufficiencyConflictsWith indiv:Calibration ,
                                                                             indiv:ConditionalUseAccuracyEquality ,
                                                                             indiv:EquityOfAmortizedAttention ,
                                                                             indiv:FalseDiscoveryParity ,
                                                                             indiv:MatchingConditionalFrequencies ,
                                                                             indiv:PredictiveParity ,
                                                                             indiv:TestFairness ,
                                                                             indiv:TotalFairness ,
                                                                             indiv:WellCalibration ;
                                   core:isProposedBy <https://purl.org/fairops/papers#2017_CORBETT_DAVIES> ;
                                   core:isSuitableFor core:Conversation ,
                                                      core:Prediction ,
                                                      core:Recommendation ;
                                   core:isUsedBy <https://purl.org/fairops/papers#2017_CORBETT_DAVIES> ;
                                   core:operationalize indiv:Art.10 ,
                                                       indiv:Art.10.3 ,
                                                       indiv:Art.10.4 ,
                                                       indiv:Art.10.5 ,
                                                       indiv:Art.11 ,
                                                       indiv:Art.12 ,
                                                       indiv:Art.13 ,
                                                       indiv:Art.14 ,
                                                       indiv:Art.15 ,
                                                       indiv:Art.16 ,
                                                       indiv:Art.17 ,
                                                       indiv:Art.26 ,
                                                       indiv:Art.27 ,
                                                       indiv:Art.29 ,
                                                       indiv:Art.43 ,
                                                       indiv:Art.5 ,
                                                       indiv:Art.6 ,
                                                       indiv:Art.6.2 ,
                                                       indiv:Art.9 ;
                                   core:refersTo core:Classification ,
                                                 core:TextGeneration ;
                                   rdfs:comment "Conditional statistical parity is closely related to the idea of fairness through blindness (i.e., unawareness[Ndr]), in which one attempts to create fair algorithms by prohibiting use of protected attributes, such as race. However, as frequently noted, it is difficult to restrict to “legitimate” features that do not at least partially correlate with race and other protected attributes, and so one cannot be completely “blind” to the sensitive information. Moreover, unlike the other definitions of fairness, this one does not necessarily re- duce racial disparities. Conditional statistical parity mitigates these limitations of the blindness approach while preserving its intuitive appeal. [2017_CORBETT_DAVIES]" .


