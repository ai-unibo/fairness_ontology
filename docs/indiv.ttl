@prefix : <https://purl.org/fairops/indiv#> .
@prefix ns1: <http://semanticscience.org/resource/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix core: <https://purl.org/fairops/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix indiv: <https://purl.org/fairops/indiv#> .
@prefix papers: <https://purl.org/fairops/papers#> .
@base <https://purl.org/fairops/indiv#> .

<https://purl.org/fairops/indiv> rdf:type owl:Ontology ;
                                  owl:imports <https://purl.org/fairops/core> ,
                                              <https://purl.org/fairops/papers> .

#################################################################
#    Object Properties
#################################################################

###  https://purl.org/fairops/core#arisesIn
core:arisesIn rdfs:range [ rdf:type owl:Class ;
                           owl:oneOf ( core:Conversation
                                       core:Prediction
                                       core:Recommendation
                                     )
                         ] .


###  https://purl.org/fairops/core#enforces
core:enforces rdfs:domain core:ScientificArtifact ;
              rdfs:range core:ScientificArtifact .


###  https://purl.org/fairops/core#guides
core:guides rdfs:range core:ScientificArtifact .


###  https://purl.org/fairops/core#isAddressedWith
core:isAddressedWith rdfs:range core:ScientificArtifact .


###  https://purl.org/fairops/core#isAppliedAt
core:isAppliedAt rdfs:domain core:ScientificArtifact .


###  https://purl.org/fairops/core#isEnforcedBy
core:isEnforcedBy rdfs:domain core:ScientificArtifact ;
                  rdfs:range core:ScientificArtifact .


###  https://purl.org/fairops/core#isEquivalentTo
core:isEquivalentTo rdfs:domain core:ScientificArtifact ;
                    rdfs:range core:ScientificArtifact .


###  https://purl.org/fairops/core#isGuidedBy
core:isGuidedBy rdfs:domain core:ScientificArtifact .


###  https://purl.org/fairops/core#isMeasuredBy
core:isMeasuredBy rdfs:domain core:ScientificArtifact ;
                  rdfs:range core:ScientificArtifact .


###  https://purl.org/fairops/core#isMitigatedBy
core:isMitigatedBy rdfs:range core:ScientificArtifact .


###  https://purl.org/fairops/core#isOperationalizedBy
core:isOperationalizedBy rdfs:range core:ScientificArtifact .


###  https://purl.org/fairops/core#isQuantifiedBy
core:isQuantifiedBy rdfs:range core:ScientificArtifact .


###  https://purl.org/fairops/core#isSuitableFor
core:isSuitableFor rdfs:range [ rdf:type owl:Class ;
                                owl:oneOf ( core:Conversation
                                            core:Prediction
                                            core:Recommendation
                                          )
                              ] .


###  https://purl.org/fairops/core#itsComplianceIsSupportedWith
core:itsComplianceIsSupportedWith rdfs:range core:ScientificArtifact .


###  https://purl.org/fairops/core#measures
core:measures rdfs:domain core:ScientificArtifact ;
              rdfs:range core:ScientificArtifact .


###  https://purl.org/fairops/core#mitigatedWith
core:mitigatedWith rdfs:range core:ScientificArtifact .


###  https://purl.org/fairops/core#mitigates
core:mitigates rdfs:domain core:ScientificArtifact .


###  https://purl.org/fairops/core#operationalize
core:operationalize rdfs:domain core:ScientificArtifact .


###  https://purl.org/fairops/core#supportsComplianceWith
core:supportsComplianceWith rdfs:domain core:ScientificArtifact .


#################################################################
#    Classes
#################################################################

###  https://purl.org/fairops/core#AITypeOfUse
core:AITypeOfUse rdfs:subClassOf [ rdf:type owl:Class ;
                                   owl:oneOf ( core:Conversation
                                               core:Prediction
                                               core:Recommendation
                                             )
                                 ] .


###  https://purl.org/fairops/core#Adapters
core:Adapters rdfs:subClassOf core:MitigationTechnique ,
                              core:ModelAccessResourcesMitigation ,
                              core:TrainingResourcesMitigation ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty core:isAppliedAt ;
                                owl:allValuesFrom core:In-processing
                              ] .


###  https://purl.org/fairops/core#AdversarialLearning
core:AdversarialLearning rdfs:subClassOf core:MitigationTechnique ,
                                         core:TrainingResourcesMitigation ,
