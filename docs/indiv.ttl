    core:refersTo core:ScoringRegression .

indiv:ReplaceStereotypes a owl:NamedIndividual,
        core:OutputRewriting ;
    core:scientificArtifactDescription "Use SHAP (2017_Lundberg) to identify stereotypical words towards queer people, providing reasoning for why the original word was harmful. They then re-prompt the language model to replace those words, using style transfer to preserve the semantic meaning of the original sentence." .

indiv:Art.72.1 a owl:NamedIndividual,
        core:ManagementLegalRequirement ;
    ns1:SIO_000068 core:EU_AI_Act ;
    rdfs:comment "Specifies that providers must systematically collect, document and analyse data relevant to the functioning of high-risk AI systems, including possible risks to fundamental rights, as part of post-market monitoring. Notes: Art. 72(1) is the KPI layer: fairness notions/metrics are used as post-deployment risk indicators and drift signals; techniques are handled under 72(2)." ;
    core:isOperationalizedBy indiv:Calibration,
        indiv:CounterfactualFairness,
        indiv:DemographicParity,
        indiv:EqualOpportunity,
        indiv:EqualizedOdds,
        indiv:FairnessThroughAwareness,
        indiv:IndividualFairness,
        indiv:StatisticalParity,
        indiv:TestFairness .

indiv:Art.72.2 a owl:NamedIndividual,
        core:ManagementLegalRequirement ;
    ns1:SIO_000068 core:EU_AI_Act ;
    rdfs:comment "Requires providers to take corrective actions, including necessary updates or withdrawal, when they identify non-compliance or new risks to health, safety or fundamental rights. Notes: Art. 72(2) is the remediation layer: apply updates/rollback/withdrawal; demonstrate risk reduction using the same KPIs defined under 72(1) with versioned evidence." ;
    core:isOperationalizedBy indiv:Calibration,
        indiv:CounterfactualFairness,
        indiv:DemographicParity,
        indiv:EqualOpportunity,
        indiv:EqualizedOdds,
        indiv:StatisticalParity,
