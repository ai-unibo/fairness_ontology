###  https://purl.org/fairops/indiv#rND
indiv:rND rdf:type owl:NamedIndividual ,
                   core:GranularityMetric ,
                   core:ItemFocusedMetric ,
                   core:OptimizationObjectMetric ,
                   core:RecommendationSystemMetric ,
                   core:ScientificArtifact ,
                   core:SingleGranularityMetric ,
                   core:SubjectMetric ,
                   core:TreatmentFocusedMetric ,
                   <https://purl.org/twc/fmo#fairness_metric> ;
          core:isProposedBy <https://purl.org/fairops/papers#2017_YANG> ;
          core:isSuitableFor core:Recommendation ;
          core:isUsedBy <https://purl.org/fairops/papers#2017_YANG> ;
          core:measures indiv:DemographicParity ,
                        indiv:DiscriminationScore ,
                        indiv:StatisticalParity ;
          core:refersTo core:ScoringRegression ;
          rdfs:comment "(*)Normalized Discounted Cumulative Gain is a ranking metric used to evaluate recommendation systems by measuring the quality of the ranked list of recommended items. It assesses a system's ability to place the most relevant items at the top of the list, with higher scores indicating a better ranking. NDCG is calculated by dividing the Discounted Cumulative Gain (DCG) of the actual recommendation list by the DCG of an ideal list, resulting in a score between 0 and 1." .


