#################################################################
#    Individuals
#################################################################

###  https://purl.org/fairops/core#AbductiveReasoning
core:AbductiveReasoning rdf:type core:AITask .


###  https://purl.org/fairops/core#AlgorithmicBias
core:AlgorithmicBias rdf:type core:FairnessConcern .


###  https://purl.org/fairops/core#AnalyticsApproach
core:AnalyticsApproach rdf:type core:AILifecycleStep ;
                       core:follows core:BusinessRequirements .


###  https://purl.org/fairops/core#BiasPerpetuation
core:BiasPerpetuation rdf:type <https://nobias-project.eu/nobias/Bias> ,
                               core:ApplicationDomain ,
                               core:FairnessConcern ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty core:arisesIn ;
                                 owl:hasValue core:Recommendation
                               ] ;
                      core:exposesTo core:HistoricalBias ,
                                     core:IntersectionalBias ,
                                     core:MaskingBias ,
                                     core:OmittedVariableBias ,
                                     core:RepresentationBias ,
                                     core:SamplingBias ;
                      core:isAddressedWith indiv:DemographicParity ,
                                           indiv:DiscriminationScore ,
                                           indiv:EqualOpportunity ,
                                           indiv:StatisticalParity ;
                      core:isQuantifiedBy indiv:AbsoluteDifference ,
                                          indiv:AbsoluteUnfairness ,
                                          indiv:DisparateImpact ,
                                          indiv:JainIndex ,
                                          indiv:KSStatistic ,
                                          indiv:MinMaxDifference ,
                                          indiv:MinSkewAndMaxSkew ,
                                          indiv:NonParityUnfairness ,
                                          indiv:OpportunityFairness ,
                                          indiv:OverestimationUnfairness ,
                                          indiv:PairwiseRankingAccuracyGap ,
                                          indiv:UnderestimationUnfairness ,
                                          indiv:ValueUnfairness ,
                                          indiv:rKL ,
                                          indiv:rND ,
                                          indiv:rRD ;
                      core:requires core:DatasetRepresentativenessReport ,
                                    core:ParityErrorGapDashboard ,
                                    core:PrePostMitigationComparisonReport ;
                      core:triggers indiv:Art.10.3 ,
