indiv:EqualityOfAttention a owl:NamedIndividual,
        core:IndividualFairnessNotion,
        core:ObservationalFairnessNotion ;
    core:isMeasuredBy indiv:KLDivergence,
        indiv:L1Norm ;
    core:scientificArtifactDescription "An egalitarian version of  fairness that is a special case of equity of attention, where the relevance  distributions are uniform, i.e., ri1 = ri2 ∀ui1, ui2." .

indiv:FairScore a owl:NamedIndividual,
        core:ScoreBasedFairnessMetric ;
    core:isProposedBy papers:2022_QIAN ;
    core:isSuitableFor core:Conversation,
        core:Prediction ;
    core:isUsedBy papers:2025_RUSSO ;
    core:measures indiv:CounterfactualFairness ;
    core:refersTo core:TextGeneration ;
    core:scientificArtifactDescription """Is a counterfactual fairness metric that measures “the change in model predictions between the original evaluation dataset and the perturbation augmented version”, with a comparatively lower score indicating a fairer model. The fairscore of a classifier is defined as the percentage of predictions that differ when the input is demographically altered. More formally, for a perturber model $f_P$ and a text snippet $x$, let $\\tilde{x} \\sim f_P(x)$ be the demographically altered perturber output. A classifier $f_C$ exhibits bias if, for some input $x$ and its demographically perturbed version $\\tilde{x}$, the predictions differ, i.e.,
\\[
f_C(x) \\neq f_C(\\tilde{x}).
\\]
Given a classifier $f_C$ and an evaluation set $X$, we define the \\emph{fairscore} $F_S$ as
\\[
F_S(f_C, X)
=
\\frac{\\left| \\{ x \\in X \\mid f_C(x) \\neq f_C(\\tilde{x}) \\} \\right|}{|X|}.
\\]""" .

indiv:FairnessThroughUnawareness a owl:NamedIndividual,
        core:ProceduralFairnessNotion ;
    rdfs:comment "not actually a measure, might increase bias instead of mitigating it. Virtually applicable to any domain. Used as low-performance benchmark by several studies" ;
    core:isProposedBy papers:2016_GRGIC_HLACA ;
    core:isSuitableFor core:Conversation,
        core:Prediction,
        core:Recommendation ;
    core:refersTo core:Classification,
        core:TextGeneration ;
    core:scientificArtifactDescription "An algorithm is fair as long as any protected attributes A are not explicitly used in the decision-making process. Hence, remove the sensitive features from the training dataset" .

indiv:FalseDiscoveryParity a owl:NamedIndividual,
        core:ObservationalFairnessNotion,
        core:SufficiencyFairnessNotion ;
    core:isMeasuredBy indiv:FalseDiscoveryRate ;
    core:isProposedBy papers:2019_CELIS ;
    core:isSuitableFor core:Conversation,
        core:Prediction ;
    core:isUsedBy papers:2019_CELISa ;
    core:refersTo core:Classification ;
    core:scientificArtifactDescription """it focuses on equality of False Positive Rates (FPR) across privileged and unprivileged groups. I.e., for each group you compute of all the predicted positive, how many were actually negative (predicted bad). The rates should be equal across different groups. Such notion is useful in cases when false prediction results in additional costs, for example, when classifying whether a person has a medical condition or not. It is mathematically defined as: $P(Y = 0, \\hat{Y} = 1, A = a) = P(Y = 0, \\hat{Y} = 1, A = b),
\\quad \\text{i.e.,} \\quad \\mathrm{FDR}(a) = \\mathrm{FDR}(b).$""" .

indiv:FalseDiscoveryRate a owl:NamedIndividual,
        core:ConfusionMatrixBasedFairnessMetric ;
    core:isProposedBy papers:2019_CELIS ;
    core:isSuitableFor core:Conversation,
        core:Prediction ;
    core:isUsedBy papers:2019_CELISa ;
    core:measures indiv:FalseDiscoveryParity ;
