indiv:GeneralizedEntropyIndex a owl:NamedIndividual,
        core:ScoreBasedFairnessMetric ;
    core:isProposedBy papers:2018_SPEICHER ;
    core:isSuitableFor core:Conversation,
        core:Prediction ;
    core:isUsedBy papers:2018_BELLAMY ;
