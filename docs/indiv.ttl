###  https://purl.org/fairops/indiv#BalancedTraining
indiv:BalancedTraining rdf:type owl:NamedIndividual ,
                                core:DataResourcesMitigation ,
                                core:FeatureLevelRowReweightingResampling ,
                                core:InstanceWeighting ,
                                core:MitigationTechnique ,
                                core:ScientificArtifact ,
                                core:StratifiedSampling ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty core:isAppliedAt ;
                                  owl:allValuesFrom core:Pre-processing
                                ] ;
                       core:scientificArtifactDescription "use instance reweighting to equalize the weight of each class during training, calculating each instance’s weight in the loss as inversely proportional to its label and an associated protected attribute. They also downsample majority-class instances to balance the number of examples in each class with respect to some protected attribute." .


