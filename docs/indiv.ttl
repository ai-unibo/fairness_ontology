###  https://purl.org/fairops/indiv#OpportunityFairness
indiv:OpportunityFairness rdf:type owl:NamedIndividual ,
                                   core:GranularityMetric ,
                                   core:ItemFocusedMetric ,
                                   core:OptimizationObjectMetric ,
                                   core:RecommendationSystemMetric ,
                                   core:ScientificArtifact ,
                                   core:SingleGranularityMetric ,
                                   core:SubjectMetric ,
                                   core:TreatmentFocusedMetric ,
                                   <https://purl.org/twc/fmo#fairness_metric> ,
                                   <https://purl.org/twc/fmo#fairness_notion> ;
                          core:extends indiv:JainIndex ;
                          core:hasBeenAppliedTo core:RetailAndECommerce ;
                          core:hasBeenTestedOn papers:Amazon ;
                          core:isEquivalentTo indiv:JainIndex ;
                          core:isProposedBy <https://purl.org/fairops/papers#2020_ZHU> ;
                          core:isSuitableFor core:Recommendation ;
                          core:isUsedBy <https://purl.org/fairops/papers#2020_ZHU> ;
                          core:measures indiv:DemographicParity ,
                                        indiv:DiscriminationScore ,
                                        indiv:StatisticalParity ;
                          core:refersTo core:ScoringRegression ;
                          core:scientificArtifactDescription """Opportunity fairness is a metric to measure the fairness of recommendation opportunity, which can be expressed by Jain’s fairness index~\\cite{20}:
\\begin{equation}
J(\\mathbf{a}) = \\frac{\\left( \\sum_{i=1}^{n} a_i \\right)^2}{n \\sum_{i=1}^{n} a_i^2}
\\end{equation}
where $J(\\mathbf{a})$ denotes Jain’s fairness index, $n$ denotes the total number of candidates with the same function, and $a_i$ represents the number of recommendations of APP $i$. The value $a_i$ can be any positive integer.""" .


