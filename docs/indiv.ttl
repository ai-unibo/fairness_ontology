indiv:GroupUnfairness a owl:NamedIndividual,
        core:AmortizedGranularityMetric,
        core:ImpactFocusedMetric,
        core:ItemFocusedMetric,
        core:SingleGranularityMetric,
        core:TreatmentFocusedMetric,
        core:UserFocusedMetric ;
    core:extends indiv:Variance ;
    core:isProposedBy papers:2019_RASTEGARPANAH ;
    core:isSuitableFor core:Recommendation ;
    core:measures indiv:FairRecommendationForCustomer,
        indiv:QualityWeightedFairness,
        indiv:UniformFairness ;
    core:refersTo core:ScoringRegression ;
    core:scientificArtifactDescription """Let $I$ be the set of all users/items and $G = \\{G_1, \\dots, G_d\\}$ be a partition of users/items into $d$ groups, i.e., $I = \\bigcup_{i \\in \\{1, \\dots, d\\}} G_i$. We define the loss of group $i$ as the mean squared estimation error over all known ratings in group $i$:
\\begin{equation}
L_i = \\frac{\\left\\| P_{\\Omega_{G_i}} \\left( \\hat{X} - X \\right) \\right\\|_2^2}{|\\Omega_{G_i}|}
\\end{equation}

For a given partition $G$, we define the group unfairness as the variance of all group losses:
\\begin{equation}
R_{\\text{grp}}(X, \\hat{X}, G) = \\frac{1}{d^2} \\sum_{k=1}^{d} \\sum_{l>k} (L_k - L_l)^2
\\end{equation}

Again, to improve group fairness, we seek to minimize $R_{\\text{grp}}$.""" .

indiv:HONEST a owl:NamedIndividual,
        core:LexiconFairnessMetric ;
    core:isProposedBy papers:2021_NOZZA ;
    core:isSuitableFor core:Conversation ;
    core:refersTo core:TextGeneration .

indiv:IndividualUnfairness a owl:NamedIndividual,
        core:AmortizedGranularityMetric,
        core:ImpactFocusedMetric,
        core:ItemFocusedMetric,
        core:SingleGranularityMetric,
        core:TreatmentFocusedMetric,
        core:UserFocusedMetric ;
    core:extends indiv:Variance ;
    core:isProposedBy papers:2019_RASTEGARPANAH ;
    core:isSuitableFor core:Recommendation ;
    core:measures indiv:FairRecommendationForCustomer,
        indiv:QualityWeightedFairness,
        indiv:UniformFairness ;
    core:refersTo core:ScoringRegression ;
    core:scientificArtifactDescription """For each user $i$, we define $l_i$, the loss of user $i$, as the mean squared error over known ratings of user $i$:
\\begin{equation}
l_i = \\frac{\\left\\| P_{\\Omega^i} \\left( \\hat{x}_i - x_i \\right) \\right\\|_2^2}{|\\Omega_i|}
\\end{equation}

Then we define the individual unfairness as the variance of the user losses:
\\begin{equation}
R_{\\text{indv}}(X, \\hat{X}) = \\frac{1}{n^2} \\sum_{k=1}^{n} \\sum_{l>k} (l_k - l_l)^2
\\end{equation}

To improve individual fairness, we seek to minimize $R_{\\text{indv}}$.""" .

indiv:JSDivergence a owl:NamedIndividual,
        core:AmortizedGranularityMetric,
        core:ImpactFocusedMetric,
        core:ItemFocusedMetric,
        core:SingleGranularityMetric,
        core:TreatmentFocusedMetric,
        core:UserFocusedMetric ;
    rdfs:comment "JS is sometimes prefered to KL-divergence because it is symmetric (i.e., if you swap the distributions, you will get the same number)" ;
    core:extends indiv:KLDivergence ;
    core:isProposedBy papers:2017_MODANI ;
