indiv:FairPSL a owl:NamedIndividual,
        core:FairnessRegularization ;
    core:scientificArtifactDescription "FairPSL extends an existing statistical relational learning framework, probabilistic soft logic (PSL). FairPSL incorporates logical definitions of fairnesss supporting a probabilistic interpretation." .

indiv:GenderneutralAlternatives a owl:NamedIndividual,
        core:OutputRewriting ;
    core:scientificArtifactDescription "To provide gender-neutral alternatives to sentences with gendered pronouns, use a rulesbased approach to generate parallel debiased sentences from biased sources, and then train a machine translation model to translate from biased sentences to debiased ones." .

indiv:KLDivergence a owl:NamedIndividual,
        core:AmortizedGranularityMetric,
        core:ImpactFocusedMetric,
        core:ItemFocusedMetric,
        core:SingleGranularityMetric,
        core:TreatmentFocusedMetric,
