###  https://purl.org/fairops/indiv#IndividualConsistencyScore
indiv:IndividualConsistencyScore rdf:type owl:NamedIndividual ,
                                          core:DistanceBasedFairnessMetric ,
                                          core:ScientificArtifact ,
                                          <https://purl.org/twc/fmo#fairness_metric> ;
                                 core:extends indiv:ConsistencyScore ;
                                 core:hasBeenAppliedTo core:FinanceAndInsurance ,
                                                       core:LawAndJustice ;
                                 core:hasBeenTestedOn papers:COMPAS ,
                                                      papers:GermanCredit ;
                                 core:isProposedBy <https://purl.org/fairops/papers#2025_WALLER> ;
                                 core:isSuitableFor core:Prediction ,
                                                    core:Recommendation ;
                                 core:isUsedBy <https://purl.org/fairops/papers#2025_WALLER> ;
                                 core:measures indiv:FairnessThroughAwareness ,
                                               indiv:IndividualFairness ;
                                 core:refersTo core:Classification ;
                                 core:scientificArtifactDescription """It is an extension of the consistency score, which does not provide an overall (average) evaluation of the individual fairness performance of the predictor, but is able to asses how fair the model is for any individual in the dataset. Given a binary classifier $f$ for a dataset $E$ and an individual $x \\in E$, 
the individual consistency score $c_{\\sigma,k}(x)$ computes the proportion of 
$x$'s $k$ most similar individuals (according to $\\sigma$) that receive the same 
classification as $x$:
\\[
c_{\\sigma,k}(x)
= 1 - \\left| f(x) - \\frac{1}{k} 
\\sum_{y \\in {nbr}_{\\sigma}(x,k)} f(y) \\right| .
\\]""" .


###  https://purl.org/fairops/indiv#IndividualFairness
indiv:IndividualFairness rdf:type owl:NamedIndividual ,
                                  core:IndividualFairnessNotion ,
                                  core:ObservationalFairnessNotion ,
                                  core:OutcomeFairnessNotion ,
                                  core:ScientificArtifact ,
                                  <https://purl.org/twc/fmo#fairness_notion> ;
                         core:conflictsWith indiv:FairnessThroughUnawareness ;
                         core:isEquivalentTo indiv:ConsistencyScore ,
                                             indiv:FairnessThroughAwareness ,
                                             indiv:IndividualFairness ;
                         core:isMeasuredBy indiv:BalancedConditionedConsistency ,
                                           indiv:ConsistencyScore ,
                                           indiv:IndividualConsistencyScore ,
                                           indiv:LowIndividualConsistencyCount ,
                                           indiv:ProportionalConsistencyScore ,
                                           indiv:RelativeLInfiniteMetric ,
                                           indiv:SimilarityRobustnessOfIndividualConsistency ,
                                           indiv:TotalVariationNorm ;
                         core:isProposedBy <https://purl.org/fairops/papers#2012_DWORK> ;
                         core:isSuitableFor core:Prediction ,
                                            core:Recommendation ;
                         core:isUsedBy <https://purl.org/fairops/papers#2012_DWORK> ,
                                       <https://purl.org/fairops/papers#2018_YONA> ,
                                       <https://purl.org/fairops/papers#2019_LAHOTI> ,
                                       <https://purl.org/fairops/papers#2020_YUROCHKIN> ,
                                       <https://purl.org/fairops/papers#2025_GAO> ;
                         core:operationalize indiv:Art.10 ,
                                             indiv:Art.10.3 ,
                                             indiv:Art.11 ,
                                             indiv:Art.12 ,
                                             indiv:Art.14 ,
                                             indiv:Art.15 ,
                                             indiv:Art.16 ,
                                             indiv:Art.17 ,
                                             indiv:Art.20 ,
                                             indiv:Art.24 ,
                                             indiv:Art.26 ,
                                             indiv:Art.27 ,
                                             indiv:Art.29 ,
                                             indiv:Art.4 ,
                                             indiv:Art.43 ,
                                             indiv:Art.5 ,
                                             indiv:Art.53 ,
                                             indiv:Art.6 ,
                                             indiv:Art.6.2 ,
                                             indiv:Art.72.1 ,
                                             indiv:Art.77 ,
                                             indiv:Art.9 ;
                         core:refersTo core:Classification ;
                         core:scientificArtifactDescription """An algorithm is fair if it gives similar predictions to similar individuals
Awareness is based on the Lipschitz condition, which requires that any two individuals 
$x$ and $y$ at distance $d(x,y) \\in [0,1]$ map to distributions $M(x)$ and $M(y)$, respectively, such that the statistical distance between them is at most $d(x,y)$:
\\[
D(M(x_1), M(x_2)) \\le d(x_1, x_2), 
\\quad \\forall x_1, x_2 \\in E .
\\]

Here, $M(x)$ denotes the probability distribution of the output for individual $x$, 
$E$ is a dataset, $D(\\cdot,\\cdot)$ returns the statistical distance between 
$M(x_1)$ and $M(x_2)$, and $d(\\cdot,\\cdot)$ denotes a distance between individuals 
$x_1$ and $x_2$, defined using a pre-specified, domain-dependent notion of similarity.
\\cite{2025_WALLER}""" .


###  https://purl.org/fairops/indiv#IndividualUnfairness
indiv:IndividualUnfairness rdf:type owl:NamedIndividual ,
                                    core:AmortizedGranularityMetric ,
                                    core:GranularityMetric ,
                                    core:ImpactFocusedMetric ,
                                    core:ItemFocusedMetric ,
                                    core:OptimizationObjectMetric ,
                                    core:RecommendationSystemMetric ,
                                    core:ScientificArtifact ,
                                    core:SingleGranularityMetric ,
                                    core:SubjectMetric ,
                                    core:TreatmentFocusedMetric ,
                                    core:UserFocusedMetric ,
                                    <https://purl.org/twc/fmo#fairness_metric> ;
                           core:extends indiv:Variance ;
                           core:hasBeenAppliedTo core:RetailAndECommerce ;
                           core:hasBeenTestedOn papers:Movielens1M ;
                           core:isProposedBy <https://purl.org/fairops/papers#2019_RASTEGARPANAH> ;
                           core:isSuitableFor core:Recommendation ;
                           core:isUsedBy <https://purl.org/fairops/papers#2019_RASTEGARPANAH> ;
                           core:measures indiv:FairRecommendationForCustomer ,
                                         indiv:QualityWeightedFairness ,
                                         indiv:UniformFairness ;
                           core:refersTo core:ScoringRegression ;
                           core:scientificArtifactDescription """For each user $i$, we define $l_i$, the loss of user $i$, as the mean squared error over known ratings of user $i$:
\\begin{equation}
l_i = \\frac{\\left\\| P_{\\Omega^i} \\left( \\hat{x}_i - x_i \\right) \\right\\|_2^2}{|\\Omega_i|}
\\end{equation}

Then we define the individual unfairness as the variance of the user losses:
\\begin{equation}
R_{\\text{indv}}(X, \\hat{X}) = \\frac{1}{n^2} \\sum_{k=1}^{n} \\sum_{l>k} (l_k - l_l)^2
\\end{equation}

To improve individual fairness, we seek to minimize $R_{\\text{indv}}$.""" .


