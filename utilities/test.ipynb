     "text": [
      "@prefix fair: <http://fairness_ontology.com/> .\n",
      "\n",
      "<http://fairness_ontology.com/papers/MyDataset> fair:relatesTo <http://fairness_ontology.com/applicationDomain/Healthcare> .\n",
      "\n",
      "\n"
     ]
    }
   ],
   "source": [
    "from rdflib import Graph, Namespace, URIRef\n",
    "\n",
    "g = Graph()\n",
    "\n",
    "FAIR = Namespace(\"http://fairness_ontology.com/\")\n",
    "g.bind(\"fair\", FAIR)\n",
    "\n",
    "dataset = FAIR[\"papers/MyDataset\"]\n",
    "\n",
    "g.add((dataset, FAIR.relatesTo, FAIR[\"applicationDomain/Healthcare\"]))\n",
    "\n",
    "print(g.serialize(format=\"turtle\"))"
   ]
  }
 ],
