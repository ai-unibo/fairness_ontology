###  http://fairness_ontology.com/rKL
:rKL rdf:type owl:NamedIndividual ,
              :ItemFocusedMetric ,
              :SingleGranularityMetric ,
              :TreatmentFocusedMetric ;
     :isProposedBy papers:2017_YANG ;
     :measures :StatisticalParity .


###  http://fairness_ontology.com/rND
:rND rdf:type owl:NamedIndividual ,
              :ItemFocusedMetric ,
              :SingleGranularityMetric ,
              :TreatmentFocusedMetric ;
     :isProposedBy papers:2017_YANG ;
     :measures :StatisticalParity ;
     skos:definition "(*)Normalized Discounted Cumulative Gain is a ranking metric used to evaluate recommendation systems by measuring the quality of the ranked list of recommended items. It assesses a system's ability to place the most relevant items at the top of the list, with higher scores indicating a better ranking. NDCG is calculated by dividing the Discounted Cumulative Gain (DCG) of the actual recommendation list by the DCG of an ideal list, resulting in a score between 0 and 1." .


###  http://fairness_ontology.com/rRD
:rRD rdf:type owl:NamedIndividual ,
              :ItemFocusedMetric ,
              :SingleGranularityMetric ,
              :TreatmentFocusedMetric ;
     :isProposedBy papers:2017_YANG ;
     :measures :StatisticalParity .




###  http://fairness_ontology.com/TreatmentEquality
:TreatmentEquality rdf:type owl:NamedIndividual ,
                            :ObservationalFairnessNotion ,
                            :SeparationFairnessNotion ;
                   :extends :EqualizedOdds ,
                            :OverallAccuracyEquality ;
                   :hasBeenAppliedTo :Healthcare ,
                                     :LawAndJustice ;
                   :isProposedBy papers:2021_BERK ;
                   :refersTo :Classification ;
                   skos:definition "Extends Overall accuracy equality, because even if the accuracy is the same for both groups, it might happend that, when a misclassification occurr for a group, it is more likely to be a FN than a FP" .


