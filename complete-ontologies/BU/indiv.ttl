###  http://fairness_ontology.com/EquityOfAmortizedAttention
:EquityOfAmortizedAttention rdf:type owl:NamedIndividual ,
                                     :IndependenceFairnessNotion ,
                                     :ObservationalFairnessNotion ;
                            :isEquivalentTo :QualityWeightedFairness ;
                            :isMeasuredBy :Variance ;
                            :isProposedBy papers:2018_BIEGA ;
                            :scientificArtifactDescription """A sequence of rankings $\\rho_1, \\dots, \\rho_m$ offers equity of amortized attention if each subject receives cumulative attention proportional to her cumulative relevance, i.e.:

\\[
\\frac{\\sum_{l=1}^{m} a^l_{i_1}}{\\sum_{l=1}^{m} r^l_{i_1}} = 
\\frac{\\sum_{l=1}^{m} a^l_{i_2}}{\\sum_{l=1}^{m} r^l_{i_2}}, 
\\quad \\forall u_{i_1}, u_{i_2}.
\\]""" .


###  http://fairness_ontology.com/EquityOfAttention
:EquityOfAttention rdf:type owl:NamedIndividual ,
                            :IndependenceFairnessNotion ,
                            :ObservationalFairnessNotion ;
                   :isEquivalentTo :QualityWeightedFairness ;
                   :isMeasuredBy :Variance ;
                   :isProposedBy papers:2018_BIEGA ;
                   :scientificArtifactDescription """A ranking offers equity of  attention if each (ranked) subject receives attention proportional to its relevance. Given: $r^j_i$ the [0..1]-normalized relevance score of subject $u_i$ in  ranking $\\rho_j ,  $a^j_i$ the [0..1]-normalized attention value received by subject $u_i$ in ranking $\\rho_j$, it states: \\[
\\frac{a_{i_1}}{r_{i_1}} = \\frac{a_{i_2}}{r_{i_2}},
\\quad \\forall\\, u_{i_1}, u_{i_2}.
\\]""" .


