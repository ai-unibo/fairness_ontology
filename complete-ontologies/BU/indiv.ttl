###  http://fairness_ontology.com/MinMaxRatio
:MinMaxRatio rdf:type owl:NamedIndividual ,
                      :AmortizedGranularityMetric ,
                      :ImpactFocusedMetric ,
                      :ItemFocusedMetric ,
                      :SingleGranularityMetric ,
                      :TreatmentFocusedMetric ,
                      :UserFocusedMetric ;
             :isProposedBy papers:1984_JAIN ;
