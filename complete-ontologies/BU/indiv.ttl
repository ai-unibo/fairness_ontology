                               :scientificArtifactDescription "Use fairness metrics (e.g., value fairness) as fair regularization" .


###  http://fairness_ontology.com/RelativeLInfiniteMetric
:RelativeLInfiniteMetric rdf:type owl:NamedIndividual ,
                                  :DistanceBasedFairnessMetric ;
                         :extends :FairnessThroughAwareness ;
                         :hasBeenAppliedTo :Education ,
                                           :Healthcare ,
                                           :LawAndJustice ;
                         :isProposedBy papers:2012_DWORK ;
                         :isUsedBy papers:2018_YONA ,
                                   papers:2019_LAHOTI ,
                                   papers:2020_YUROCHKIN ,
                                   papers:2025_GAO ;
                         :measures :FairnessThroughAwareness ;
                         :refersTo :Classification ;
                         :scientificArtifactDescription "Given P and Q, probability measures on a finite domain A, total variation norm suggests to compute the distance between the distributions as: $D_{\\infty}(P, Q) = \\sup_{a \\in A} \\log \\!\\left( \\max \\left\\{ \\frac{P(a)}{Q(a)}, \\frac{Q(a)}{P(a)} \\right\\} \\right) .$" ;
                         skos:definition "It is the second poposed metric connected to the notion of Fairness through awareness" .


###  http://fairness_ontology.com/ReplaceStereotypes
:ReplaceStereotypes rdf:type owl:NamedIndividual ,
                             :OutputRewriting ;
                    :isProposedBy papers:2023_DHINGRA ;
                    :scientificArtifactDescription "Use SHAP (2017_Lundberg) to identify stereotypical words towards queer people, providing reasoning for why the original word was harmful. They then re-prompt the language model to replace those words, using style transfer to preserve the semantic meaning of the original sentence." .


