<http://fairness_ontology.com/BiasCorrectionFineTuning> rdf:type owl:NamedIndividual ,
                                                                 <http://fairness_ontology.com/FullFineTuning> ,
                                                                 <http://fairness_ontology.com/FullParameterDebiasing> ,
                                                                 <http://fairness_ontology.com/MitigationTechnique> ,
