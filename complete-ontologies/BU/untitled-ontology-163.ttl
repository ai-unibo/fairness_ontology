<http://fairness_ontology.com/Pre-processing> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://fairness_ontology.com/AILifecycleStep> ;
                                              rdfs:label "Pre-processing" .


###  http://fairness_ontology.com/ProbabilityBasedFairnessMetric
<http://fairness_ontology.com/ProbabilityBasedFairnessMetric> rdf:type owl:Class ;
                                                              rdfs:subClassOf <https://purl.org/twc/fmo#fairness_metric> ;
                                                              rdfs:label "Probability-based Fairness Metric"@en ;
                                                              <http://www.w3.org/2004/02/skos/core#definition> "A metric that considers the probability distributions of predicted outcomes to measure fairness."@en .


###  http://fairness_ontology.com/ProceduralFairnessNotion
<http://fairness_ontology.com/ProceduralFairnessNotion> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purl.org/twc/fmo#fairness_notion> ;
                                                        <http://semanticscience.org/resource/hasSynonym> "procedural fairness"@en ;
                                                        rdfs:label "Procedural Fairness Notion"@en ;
                                                        <http://www.w3.org/2004/02/skos/core#definition> "Procedural fairness is connected to the concept of fairness from administrative law, which is concerned with equality of treatment within the process that makes a decision."@en .


###  http://fairness_ontology.com/PseudoLogLikelihoodFairnessMetric
<http://fairness_ontology.com/PseudoLogLikelihoodFairnessMetric> rdf:type owl:Class ;
                                                                 rdfs:subClassOf <http://fairness_ontology.com/ProbabilityBasedFairnessMetric> ;
                                                                 rdfs:label "Pseudo-log Likelihood Fairness Metric"@en ;
                                                                 <http://www.w3.org/2004/02/skos/core#definition> "A metric based on pseudo-log likelihoods, often used to evaluate the fairness of generation or prediction probabilities."@en .


###  http://fairness_ontology.com/ReasoningAndDecisionMaking
<http://fairness_ontology.com/ReasoningAndDecisionMaking> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://fairness_ontology.com/AITask> ;
                                                          rdfs:label "Reasoning And Decision Making" .


