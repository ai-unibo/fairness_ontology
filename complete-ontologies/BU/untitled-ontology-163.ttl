                                                          <http://fairness_ontology.com/SocialPrinciple> ;
                                                 rdfs:label "Equality"@en ;
                                                 <http://www.w3.org/2004/02/skos/core#definition> "Equality is giving everyone the same resources and opportunities."@en .


###  http://fairness_ontology.com/EqualizedOdds
<http://fairness_ontology.com/EqualizedOdds> rdf:type owl:NamedIndividual ,
                                                      <http://fairness_ontology.com/GroupFairnessNotion> ,
                                                      <http://fairness_ontology.com/ObservationalFairnessNotion> ,
                                                      <http://fairness_ontology.com/OutcomeFairnessNotion> ,
                                                      <http://fairness_ontology.com/ScientificArtifact> ,
                                                      <http://fairness_ontology.com/SeparationFairnessNotion> ,
                                                      <https://purl.org/twc/fmo#fairness_notion> ;
                                             <http://fairness_ontology.com/extends> <http://fairness_ontology.com/EqualOpportunity> ,
                                                                                    <http://fairness_ontology.com/OverallAccuracyEquality> ,
                                                                                    <http://fairness_ontology.com/PredictiveEquality> ;
                                             <http://fairness_ontology.com/hasBeenAppliedTo> <http://fairness_ontology.com/Healthcare> ,
                                                                                             <http://fairness_ontology.com/LawAndJustice> ;
                                             <http://fairness_ontology.com/isEquivalentTo> <http://fairness_ontology.com/ConditionalProcedureAccuracyEquality> ;
                                             <http://fairness_ontology.com/isMeasuredBy> <http://fairness_ontology.com/OutcomeUnfairness> ;
                                             <http://fairness_ontology.com/isProposedBy> <http://fairness_ontology.com/2018_VANMASSENHOVE> ,
                                                                                         <http://fairness_ontology.com/2021_BERK> ;
                                             <http://fairness_ontology.com/refersTo> <http://fairness_ontology.com/Classification> ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "for NLP classification tasks, or tasks with a superimposed classifier, traditional fairness definitions like equalized odds or statistical parity MAY be used without modification[2024_Gallegos]. Extends Equal opportunity  and Predictive equality  i.e., if you satisfy Equalized odds, than you also satisfy Equal opportunity. It also extends Overall accuracy equality because if you achieve equalized odds, then you have equal accuracy." .


