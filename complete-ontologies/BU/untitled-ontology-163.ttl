###  http://fairness_ontology.com/MitigationTechnique
<http://fairness_ontology.com/MitigationTechnique> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://fairness_ontology.com/ScientificArtifact> ;
                                                   rdfs:label "Mitigation Technique"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "A method used to identify, reduce, or prevent unfair bias in data, models, or decision-making processes. It aims to improve fairness and reduce discriminatory outcomes across different groups or individuals." .


###  http://fairness_ontology.com/ModelAccessResourcesMitigation
<http://fairness_ontology.com/ModelAccessResourcesMitigation> rdf:type owl:Class ;
                                                              rdfs:subClassOf <http://fairness_ontology.com/MitigationTechnique> ;
                                                              rdfs:label "Model Access Resources Mitigation"@en .


###  http://fairness_ontology.com/ObservationalFairnessNotion
<http://fairness_ontology.com/ObservationalFairnessNotion> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://fairness_ontology.com/OutcomeFairnessNotion> ;
                                                           <http://semanticscience.org/resource/hasSynonym> "observational fairness"@en ;
                                                           rdfs:label "Observational Fairness Notion"@en ;
                                                           <http://www.w3.org/2004/02/skos/core#definition> "A family of fairness notions focusing on the joint distribution of observable factors."@en .


###  http://fairness_ontology.com/OptimizationObjectMetric
<http://fairness_ontology.com/OptimizationObjectMetric> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://fairness_ontology.com/RecommendationSystemMetric> ;
                                                        rdfs:label "Optimization Object Metric"@en .


###  http://fairness_ontology.com/OutcomeFairnessNotion
<http://fairness_ontology.com/OutcomeFairnessNotion> rdf:type owl:Class ;
                                                     rdfs:subClassOf <https://purl.org/twc/fmo#fairness_notion> ;
                                                     owl:disjointWith <http://fairness_ontology.com/ProceduralFairnessNotion> ;
                                                     <http://semanticscience.org/resource/hasSynonym> "outcome fairness"@en ;
                                                     rdfs:label "Outcome Fairness Notion"@en ;
                                                     <http://www.w3.org/2004/02/skos/core#definition> "Outcome fairness is concerned with the fairness of the results of the decision-making process."@en .


###  http://fairness_ontology.com/OutputRewriting
<http://fairness_ontology.com/OutputRewriting> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://fairness_ontology.com/BlackBoxDecisionOnly> ;
                                               rdfs:label "Decision/Output Re-writing" .


###  http://fairness_ontology.com/ParityBasedFairnessMetric
<http://fairness_ontology.com/ParityBasedFairnessMetric> rdf:type owl:Class ;
                                                         rdfs:subClassOf <https://purl.org/twc/fmo#fairness_metric> ;
                                                         rdfs:label "Parity-based Fairness Metric"@en ;
                                                         <http://www.w3.org/2004/02/skos/core#definition> "A measurement of any fairness notion, focusing on equalising the probability of a favourable outcome among groups."@en .


###  http://fairness_ontology.com/PartialFineTuning
<http://fairness_ontology.com/PartialFineTuning> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://fairness_ontology.com/ModelAccessResourcesMitigation> ,
                                                                 <http://fairness_ontology.com/TrainingResourcesMitigation> ;
                                                 rdfs:label "Partial Fine-tuning - White-box Model (G)" .


###  http://fairness_ontology.com/PartialPruning
<http://fairness_ontology.com/PartialPruning> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://fairness_ontology.com/PartialFineTuning> ;
                                              rdfs:comment "A mitigation technique that prunes a SUBPART OF an already trained model by setting to 0 some of its weights." ;
                                              rdfs:label "Partial Pruning and Weight Masking" .


