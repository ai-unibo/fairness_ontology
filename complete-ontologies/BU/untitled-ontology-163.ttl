                                                  <http://fairness_ontology.com/hasBeenAppliedTo> <http://fairness_ontology.com/LawAndJustice> ;
                                                  <http://fairness_ontology.com/isEquivalentTo> <http://fairness_ontology.com/FalsePositiveErrorRateBalance> ;
                                                  <http://fairness_ontology.com/isProposedBy> <http://fairness_ontology.com/2016_HARDT> ;
