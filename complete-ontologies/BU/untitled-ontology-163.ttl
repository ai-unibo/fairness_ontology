                                                             <http://fairness_ontology.com/ScientificArtifact> ,
                                                             <https://purl.org/twc/fmo#fairness_metric> ;
                                                    <http://fairness_ontology.com/extends> <http://fairness_ontology.com/LogProbabilityBiasScore> ;
