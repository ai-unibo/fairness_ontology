###  http://fairness_ontology.com/ConditionalProcedureAccuracyEquality
<http://fairness_ontology.com/ConditionalProcedureAccuracyEquality> rdf:type owl:NamedIndividual ,
                                                                             <http://fairness_ontology.com/GroupFairnessNotion> ,
                                                                             <http://fairness_ontology.com/ObservationalFairnessNotion> ,
                                                                             <http://fairness_ontology.com/OutcomeFairnessNotion> ,
                                                                             <http://fairness_ontology.com/ScientificArtifact> ,
                                                                             <http://fairness_ontology.com/SeparationFairnessNotion> ,
                                                                             <https://purl.org/twc/fmo#fairness_notion> ;
                                                                    <http://fairness_ontology.com/extends> <http://fairness_ontology.com/EqualOpportunity> ,
                                                                                                           <http://fairness_ontology.com/PredictiveEquality> ;
                                                                    <http://fairness_ontology.com/hasBeenAppliedTo> <http://fairness_ontology.com/Healthcare> ,
                                                                                                                    <http://fairness_ontology.com/LawAndJustice> ;
                                                                    <http://fairness_ontology.com/isEquivalentTo> <http://fairness_ontology.com/EqualizedOdds> ;
                                                                    <http://fairness_ontology.com/isMeasuredBy> <http://fairness_ontology.com/OutcomeUnfairness> ;
                                                                    <http://fairness_ontology.com/isProposedBy> <http://fairness_ontology.com/2018_VANMASSENHOVE> ,
