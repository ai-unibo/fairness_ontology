###  http://fairness_ontology.com/SelectiveParameterUpdating
<http://fairness_ontology.com/SelectiveParameterUpdating> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://fairness_ontology.com/PartialFineTuning> ;
                                                          rdfs:comment "A mitigation technique that updates the parameters (e.g., redistributes the weights) of a SUBPART OF an already trained model." ;
                                                          rdfs:label "Selective Parameter Updating" .


###  http://fairness_ontology.com/SentenceEmbeddingFairnessMetric
<http://fairness_ontology.com/SentenceEmbeddingFairnessMetric> rdf:type owl:Class ;
                                                               rdfs:subClassOf <http://fairness_ontology.com/EmbeddingBasedFairnessMetric> ;
                                                               rdfs:label "Sentence Embedding Fairness Metric"@en ;
                                                               <http://www.w3.org/2004/02/skos/core#definition> "A metric using sentence-level embedding representations as the basis for evaluating model or data fairness."@en .


###  http://fairness_ontology.com/SeparationFairnessNotion
<http://fairness_ontology.com/SeparationFairnessNotion> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://fairness_ontology.com/GroupFairnessNotion> ;
                                                        <http://purl.org/dc/elements/1.1/source> "https://doi.org/10.1145/3468507.3468511"^^xsd:anyURI ;
                                                        <http://semanticscience.org/resource/hasSynonym> "separation fairness"@en ;
                                                        rdfs:label "Separation Fairness Notion"@en ;
                                                        <http://www.w3.org/2004/02/skos/core#definition> "The fairness property satisfied when the predicted outcome variable is independent of protected attributes, conditionally on the actual outcome variable."@en ;
                                                        <https://purl.org/twc/fmo#probabilistic_definition> "Ŷ ⊥ A | Y"@en .


###  http://fairness_ontology.com/SingleGranularityMetric
<http://fairness_ontology.com/SingleGranularityMetric> rdf:type owl:Class ;
                                                       rdfs:subClassOf <http://fairness_ontology.com/GranularityMetric> ;
                                                       rdfs:label "Single Granularity Metric"@en .


