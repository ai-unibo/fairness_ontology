@prefix : <http://www.semanticweb.org/daniela/ontologies/2026/2/untitled-ontology-163#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/daniela/ontologies/2026/2/untitled-ontology-163#> .

<http://www.semanticweb.org/daniela/ontologies/2026/2/untitled-ontology-163> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/source
<http://purl.org/dc/elements/1.1/source> rdf:type owl:AnnotationProperty .


###  http://semanticscience.org/resource/hasSynonym
<http://semanticscience.org/resource/hasSynonym> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty .


###  https://purl.org/twc/fmo#probabilistic_definition
<https://purl.org/twc/fmo#probabilistic_definition> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://fairness_ontology.com/arisesIn
<http://fairness_ontology.com/arisesIn> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <http://fairness_ontology.com/FairnessConcern> ;
                                        rdfs:range <http://fairness_ontology.com/AITypeOfUse> ;
                                        rdfs:label "arises in" .


###  http://fairness_ontology.com/enforces
<http://fairness_ontology.com/enforces> rdf:type owl:ObjectProperty ;
                                        owl:inverseOf <http://fairness_ontology.com/isEnforcedBy> ;
                                        rdfs:domain <http://fairness_ontology.com/MitigationTechnique> ;
                                        rdfs:range <https://purl.org/twc/fmo#fairness_metric> ;
                                        rdfs:label "enforces"@en .


###  http://fairness_ontology.com/exposesTo
<http://fairness_ontology.com/exposesTo> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <https://purl.org/twc/fmo#bias> ;
                                         rdfs:range <http://fairness_ontology.com/FairnessConcern> ;
                                         rdfs:label "exposes to"@en .


###  http://fairness_ontology.com/extends
<http://fairness_ontology.com/extends> rdf:type owl:ObjectProperty ;
                                       rdfs:domain <http://fairness_ontology.com/ScientificArtifact> ;
                                       rdfs:range <http://fairness_ontology.com/ScientificArtifact> ;
                                       rdfs:label "extends" ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "A certain Scientific Artifact may extend another. E.g., a certain Fairness Notion can extend another one" .


###  http://fairness_ontology.com/follows
<http://fairness_ontology.com/follows> rdf:type owl:ObjectProperty ;
                                       owl:inverseOf <http://fairness_ontology.com/isFollowedBy> ;
                                       rdfs:domain <http://fairness_ontology.com/AILifecycleStep> ;
                                       rdfs:range <http://fairness_ontology.com/AILifecycleStep> ;
                                       rdfs:label "follows" .


###  http://fairness_ontology.com/guides
<http://fairness_ontology.com/guides> rdf:type owl:ObjectProperty ;
                                      owl:inverseOf <http://fairness_ontology.com/isGuidedBy> ;
                                      rdfs:domain <http://fairness_ontology.com/SocialPrinciple> ;
                                      rdfs:range <https://purl.org/twc/fmo#fairness_notion> ;
                                      rdfs:comment "Links a fairness notion to its underpinning social principle such as equity or equality."@en ;
                                      rdfs:label "guides"@en .


###  http://fairness_ontology.com/hasBeenAppliedTo
<http://fairness_ontology.com/hasBeenAppliedTo> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <http://fairness_ontology.com/ScientificArtifact> ;
                                                rdfs:range <http://fairness_ontology.com/ApplicationDomain> ;
                                                rdfs:label "has been applied to"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "A certain fairness notion has been applied to certain application domains."@en .


###  http://fairness_ontology.com/hasBeenTestedOn
<http://fairness_ontology.com/hasBeenTestedOn> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <http://fairness_ontology.com/ScientificArtifact> ;
                                               rdfs:range <http://fairness_ontology.com/Dataset> ;
                                               rdfs:label "has been tested on"@en .


###  http://fairness_ontology.com/isAddressedWith
<http://fairness_ontology.com/isAddressedWith> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <http://fairness_ontology.com/FairnessConcern> ;
                                               rdfs:range <https://purl.org/twc/fmo#fairness_notion> ;
                                               rdfs:label "is addressed with"@en .


###  http://fairness_ontology.com/isAppliedAt
<http://fairness_ontology.com/isAppliedAt> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <http://fairness_ontology.com/MitigationTechnique> ;
                                           rdfs:range <http://fairness_ontology.com/AILifecycleStep> ;
                                           rdfs:label "is applied at" .


###  http://fairness_ontology.com/isEnforcedBy
<http://fairness_ontology.com/isEnforcedBy> rdf:type owl:ObjectProperty ;
                                            rdfs:domain <https://purl.org/twc/fmo#fairness_metric> ;
                                            rdfs:range <http://fairness_ontology.com/MitigationTechnique> ;
                                            rdfs:label "is enforced by"@en .


###  http://fairness_ontology.com/isEquivalentTo
<http://fairness_ontology.com/isEquivalentTo> rdf:type owl:ObjectProperty ;
                                              owl:inverseOf <http://fairness_ontology.com/isEquivalentTo> ;
                                              rdf:type owl:SymmetricProperty ;
                                              rdfs:domain <https://purl.org/twc/fmo#fairness_notion> ;
                                              rdfs:range <https://purl.org/twc/fmo#fairness_notion> ;
                                              rdfs:label "is equivalent to"@en ;
                                              <http://www.w3.org/2004/02/skos/core#definition> "A certain fairness notion can be equal to some other fairness notions."@en .


###  http://fairness_ontology.com/isFollowedBy
<http://fairness_ontology.com/isFollowedBy> rdf:type owl:ObjectProperty ;
                                            rdfs:domain <http://fairness_ontology.com/AILifecycleStep> ;
                                            rdfs:range <http://fairness_ontology.com/AILifecycleStep> ;
                                            rdfs:label "is followed by" .


###  http://fairness_ontology.com/isGuidedBy
<http://fairness_ontology.com/isGuidedBy> rdf:type owl:ObjectProperty ;
                                          rdfs:domain <https://purl.org/twc/fmo#fairness_notion> ;
                                          rdfs:range <http://fairness_ontology.com/SocialPrinciple> ;
                                          rdfs:comment "Links a fairness notion to its underpinning social principle such as equity or equality."@en ;
                                          rdfs:label "is guided by"@en .


###  http://fairness_ontology.com/isMeasuredBy
<http://fairness_ontology.com/isMeasuredBy> rdf:type owl:ObjectProperty ;
                                            owl:inverseOf <http://fairness_ontology.com/measures> ;
                                            rdfs:domain <https://purl.org/twc/fmo#fairness_notion> ;
                                            rdfs:range <https://purl.org/twc/fmo#fairness_metric> ;
                                            rdfs:label "is measured by"@en ;
                                            <http://www.w3.org/2004/02/skos/core#definition> "A fairness notion is measured by a fairness metric if comparisons made with the given metric are a valid way to determine fairness with this notion."@en .


###  http://fairness_ontology.com/isMitigatedBy
<http://fairness_ontology.com/isMitigatedBy> rdf:type owl:ObjectProperty ;
                                             owl:inverseOf <http://fairness_ontology.com/mitigates> ;
                                             rdfs:domain <https://purl.org/twc/fmo#bias> ;
                                             rdfs:range <https://purl.org/twc/fmo#fairness_notion> ;
                                             rdfs:label "is mitigated by"@en ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "A certain bias in the use-case can be mitigated by enforcing specific fairness notions."@en .


###  http://fairness_ontology.com/isOperationalizedBy
<http://fairness_ontology.com/isOperationalizedBy> rdf:type owl:ObjectProperty ;
                                                   owl:inverseOf <http://fairness_ontology.com/operationalize> ;
                                                   rdfs:domain <http://fairness_ontology.com/LegalRequirement> ;
                                                   rdfs:range <https://purl.org/twc/fmo#fairness_notion> ;
                                                   rdfs:label "is operationalized by" .


###  http://fairness_ontology.com/isProposedBy
<http://fairness_ontology.com/isProposedBy> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <http://fairness_ontology.com/isUsedBy> ;
                                            rdfs:domain <http://fairness_ontology.com/ScientificArtifact> ;
                                            rdfs:range <http://fairness_ontology.com/ScientificPaper> ;
                                            rdfs:label "is proposed by"@en ;
                                            <http://www.w3.org/2004/02/skos/core#definition> "A certain fairness notion is proposed by a certain scientific paper."@en .


###  http://fairness_ontology.com/isQuantifiedBy
<http://fairness_ontology.com/isQuantifiedBy> rdf:type owl:ObjectProperty ;
                                              rdfs:subPropertyOf :inferredRelation ;
                                              rdfs:domain <http://fairness_ontology.com/FairnessConcern> ;
                                              rdfs:range <https://purl.org/twc/fmo#fairness_metric> ;
                                              rdfs:label "is quantified by"@en .


###  http://fairness_ontology.com/isRelevantDuring
<http://fairness_ontology.com/isRelevantDuring> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <http://fairness_ontology.com/LegalRequirement> ;
                                                rdfs:range <http://fairness_ontology.com/AILifecycleStep> ;
                                                rdfs:label "is relevant during" .


###  http://fairness_ontology.com/isSuitableFor
<http://fairness_ontology.com/isSuitableFor> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <https://purl.org/twc/fmo#fairness_metric> ;
                                             rdfs:range <http://fairness_ontology.com/AITypeOfUse> ;
                                             rdfs:label "is suitable for" .


###  http://fairness_ontology.com/isUsedBy
<http://fairness_ontology.com/isUsedBy> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <http://fairness_ontology.com/ScientificArtifact> ;
                                        rdfs:range <http://fairness_ontology.com/ScientificPaper> ;
                                        rdfs:label "is used by"@en ;
                                        <http://www.w3.org/2004/02/skos/core#definition> "A certain fairness notion is used by some scientific papers."@en .


###  http://fairness_ontology.com/itsComplianceIsSupportedWith
<http://fairness_ontology.com/itsComplianceIsSupportedWith> rdf:type owl:ObjectProperty ;
                                                            owl:inverseOf <http://fairness_ontology.com/supportsComplianceWith> ;
                                                            rdfs:domain <http://fairness_ontology.com/LegalRequirement> ;
                                                            rdfs:range <http://fairness_ontology.com/MitigationTechnique> ;
                                                            rdfs:label "its compliance is supported by" .


###  http://fairness_ontology.com/measures
<http://fairness_ontology.com/measures> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <https://purl.org/twc/fmo#fairness_metric> ;
                                        rdfs:range <https://purl.org/twc/fmo#fairness_notion> ;
                                        rdfs:label "measures"@en ;
                                        <http://www.w3.org/2004/02/skos/core#definition> "A fairness metric measures some fairness notion if comparisons made with the given metric are a valid way to determine fairness with this notion."@en .


###  http://fairness_ontology.com/mitigatedWith
<http://fairness_ontology.com/mitigatedWith> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <http://fairness_ontology.com/FairnessConcern> ;
                                             rdfs:range <http://fairness_ontology.com/MitigationTechnique> ;
                                             rdfs:label "mitigated with"@en .


###  http://fairness_ontology.com/mitigates
<http://fairness_ontology.com/mitigates> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <https://purl.org/twc/fmo#fairness_notion> ;
                                         rdfs:range <https://purl.org/twc/fmo#bias> ;
                                         rdfs:label "mitigates"@en ;
                                         <http://www.w3.org/2004/02/skos/core#definition> "A fairness notion is required to mitigate a certain bias."@en .


###  http://fairness_ontology.com/operationalize
<http://fairness_ontology.com/operationalize> rdf:type owl:ObjectProperty ;
                                              rdfs:domain <https://purl.org/twc/fmo#fairness_notion> ;
                                              rdfs:range <http://fairness_ontology.com/LegalRequirement> ;
                                              rdfs:label "operationalize" .


###  http://fairness_ontology.com/refersTo
<http://fairness_ontology.com/refersTo> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <http://fairness_ontology.com/ScientificArtifact> ;
                                        rdfs:range <http://fairness_ontology.com/AITask> ;
                                        rdfs:label "refers to"@en ;
                                        <http://www.w3.org/2004/02/skos/core#definition> "A certain fairness notion refers to (is suitable for) a certain set of AI tasks."@en .


###  http://fairness_ontology.com/relatesTo
<http://fairness_ontology.com/relatesTo> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <http://fairness_ontology.com/Dataset> ;
                                         rdfs:range <http://fairness_ontology.com/ApplicationDomain> ;
                                         rdfs:label "relates to" .


###  http://fairness_ontology.com/requires
<http://fairness_ontology.com/requires> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <http://fairness_ontology.com/FairnessConcern> ;
                                        rdfs:range <http://fairness_ontology.com/EvidenceArtifact> .


###  http://fairness_ontology.com/supportsComplianceWith
<http://fairness_ontology.com/supportsComplianceWith> rdf:type owl:ObjectProperty ;
                                                      rdfs:domain <http://fairness_ontology.com/MitigationTechnique> ;
                                                      rdfs:range <http://fairness_ontology.com/LegalRequirement> ;
                                                      rdfs:label "supports compliance with" .


###  http://fairness_ontology.com/testedOn
<http://fairness_ontology.com/testedOn> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <http://fairness_ontology.com/FairnessConcern> ;
                                        rdfs:range <http://fairness_ontology.com/Dataset> ;
                                        rdfs:label "tested on"@en .


###  http://semanticscience.org/resource/SIO_000068
<http://semanticscience.org/resource/SIO_000068> rdf:type owl:ObjectProperty ;
                                                 rdfs:domain <http://fairness_ontology.com/LegalRequirement> ;
                                                 rdfs:range <http://fairness_ontology.com/Legislation> ;
                                                 rdfs:label "is part of"@en .


###  http://www.semanticweb.org/daniela/ontologies/2026/2/untitled-ontology-163#inferredRelation
:inferredRelation rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://fairness_ontology.com/concernDescription
<http://fairness_ontology.com/concernDescription> rdf:type owl:DatatypeProperty ;
                                                  rdfs:domain <http://fairness_ontology.com/FairnessConcern> ;
                                                  rdfs:range xsd:string ;
                                                  rdfs:label "concern description"@en .


###  http://fairness_ontology.com/concernName
<http://fairness_ontology.com/concernName> rdf:type owl:DatatypeProperty ;
                                           rdfs:domain <http://fairness_ontology.com/FairnessConcern> ;
                                           rdfs:range xsd:string ;
                                           rdfs:label "concern name"@en .


###  http://fairness_ontology.com/datasetDescription
<http://fairness_ontology.com/datasetDescription> rdf:type owl:DatatypeProperty ;
                                                  rdfs:domain <http://fairness_ontology.com/Dataset> ;
                                                  rdfs:range xsd:string ;
                                                  rdfs:label "dataset description"@en .


###  http://fairness_ontology.com/datasetName
<http://fairness_ontology.com/datasetName> rdf:type owl:DatatypeProperty ;
                                           rdfs:domain <http://fairness_ontology.com/Dataset> ;
                                           rdfs:range xsd:string ;
                                           rdfs:label "dataset name"@en .


###  http://fairness_ontology.com/scientificArtifactDescription
<http://fairness_ontology.com/scientificArtifactDescription> rdf:type owl:DatatypeProperty ;
                                                             rdfs:domain <http://fairness_ontology.com/ScientificArtifact> ;
                                                             rdfs:range xsd:string ;
                                                             rdfs:label "scientific artifact description"@en ;
                                                             <http://www.w3.org/2004/02/skos/core#definition> "A latex description of a scientific artifact."@en .


#################################################################
#    Classes
#################################################################

###  http://fairness_ontology.com/AILifecycleStep
<http://fairness_ontology.com/AILifecycleStep> rdf:type owl:Class ;
                                               rdfs:label "AI Lifecycle Step" .


###  http://fairness_ontology.com/AITask
<http://fairness_ontology.com/AITask> rdf:type owl:Class ;
                                      rdfs:label "AI Task"@en ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "The functional task that the AI system is able to perform. Previously was MLTask, AITask and AICapability."@en .


###  http://fairness_ontology.com/AITypeOfUse
<http://fairness_ontology.com/AITypeOfUse> rdf:type owl:Class ;
                                           rdfs:comment "Describes the type of use of (or the type of interaction with) the AI system. It impacts obligations. Previously called AIScenario" ;
                                           rdfs:label "AI Type Of Use" .


###  http://fairness_ontology.com/Adapters
<http://fairness_ontology.com/Adapters> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://fairness_ontology.com/PartialFineTuning> ;
                                        rdfs:label "Adapters" .


###  http://fairness_ontology.com/AdversarialLearning
<http://fairness_ontology.com/AdversarialLearning> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://fairness_ontology.com/FullRetraining> ;
                                                   rdfs:label "Adversarial Learning" .


###  http://fairness_ontology.com/AmortizedGranularityMetric
<http://fairness_ontology.com/AmortizedGranularityMetric> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://fairness_ontology.com/GranularityMetric> ;
                                                          rdfs:label "Amortized Granularity Metric"@en .


###  http://fairness_ontology.com/ApplicationDomain
<http://fairness_ontology.com/ApplicationDomain> rdf:type owl:Class ;
                                                 rdfs:label "Application Domain"@en ;
                                                 <http://www.w3.org/2004/02/skos/core#definition> "The specific real-world area or context in which the system is designed to operate. Previously was UseArea. According to AI Watch taxonomy can also me called \"Economic Sector or Use Area\""@en .


###  http://fairness_ontology.com/AuditSets
<http://fairness_ontology.com/AuditSets> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://fairness_ontology.com/DataGeneration> ;
                                         rdfs:label "Audit Sets" .


###  http://fairness_ontology.com/BanditsBasedLearning
<http://fairness_ontology.com/BanditsBasedLearning> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://fairness_ontology.com/FullRetraining> ;
                                                    rdfs:label "Bandits-based Learning" .


###  http://fairness_ontology.com/BlackBoxDecisionOnly
<http://fairness_ontology.com/BlackBoxDecisionOnly> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://fairness_ontology.com/ModelAccessResourcesMitigation> ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty <http://fairness_ontology.com/isAppliedAt> ;
                                                                      owl:allValuesFrom <http://fairness_ontology.com/Post-processing>
                                                                    ] ;
                                                    rdfs:label "Decision Layer Control - Black-box Model (I)" .


###  http://fairness_ontology.com/Blinding
<http://fairness_ontology.com/Blinding> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://fairness_ontology.com/FeatureLevelColumnIntervention> ;
                                        rdfs:label "Blinding and Proxy Removal" .


###  http://fairness_ontology.com/CalibrationBasedFairnessMetric
<http://fairness_ontology.com/CalibrationBasedFairnessMetric> rdf:type owl:Class ;
                                                              rdfs:subClassOf <https://purl.org/twc/fmo#fairness_metric> ;
                                                              rdfs:label "Calibration-based Fairness Metric" ;
                                                              <http://www.w3.org/2004/02/skos/core#definition> "A measurement of any fairness notion, partially connected to the confusion matrix principles, these metrics are usually referred with the term  calibration-based, with the very aim of distinguishing their prevalent attention to the predictive values." .


###  http://fairness_ontology.com/CalibrationBasedMitigation
<http://fairness_ontology.com/CalibrationBasedMitigation> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://fairness_ontology.com/GreyBoxScores> ;
                                                          rdfs:label "Calibration-based Mitigation" .


###  http://fairness_ontology.com/CausalFairnessNotion
<http://fairness_ontology.com/CausalFairnessNotion> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://fairness_ontology.com/OutcomeFairnessNotion> ;
                                                    owl:disjointWith <http://fairness_ontology.com/ObservationalFairnessNotion> ;
                                                    <http://semanticscience.org/resource/hasSynonym> "causal fairness"@en ;
                                                    rdfs:label "Causal Fairness Notion"@en ;
                                                    <http://www.w3.org/2004/02/skos/core#definition> "A family of fairness notions focusing on the causal relations between variables."@en .


###  http://fairness_ontology.com/ClassifierFairnessMetric
<http://fairness_ontology.com/ClassifierFairnessMetric> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://fairness_ontology.com/GeneratedTextBasedFairnessMetric> ;
                                                        rdfs:label "Classifier Fairness Metric"@en ;
                                                        <http://www.w3.org/2004/02/skos/core#definition> "A metric that employs a classifier on generated text to assess the presence of bias or fairness."@en .


###  http://fairness_ontology.com/Cleaning
<http://fairness_ontology.com/Cleaning> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://fairness_ontology.com/InstanceLevelRowIntervention> ;
                                        rdfs:label "Cleaning" .


###  http://fairness_ontology.com/ConfusionMatrixBasedFairnessMetric
<http://fairness_ontology.com/ConfusionMatrixBasedFairnessMetric> rdf:type owl:Class ;
                                                                  rdfs:subClassOf <https://purl.org/twc/fmo#fairness_metric> ;
                                                                  rdfs:label "Confusion Matrix-based Fairness Metric"@en ;
                                                                  <http://www.w3.org/2004/02/skos/core#definition> "A measurement of any fairness notion, focusing on the amount of correct/incorrect classifications inferred by the predictor."@en .


###  http://fairness_ontology.com/ConstrainedOptimization
<http://fairness_ontology.com/ConstrainedOptimization> rdf:type owl:Class ;
                                                       rdfs:subClassOf <http://fairness_ontology.com/FullRetraining> ;
                                                       rdfs:label "Constrained Optimization" .


###  http://fairness_ontology.com/ConversationFairnessConcern
<http://fairness_ontology.com/ConversationFairnessConcern> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://fairness_ontology.com/FairnessConcern> ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty <http://fairness_ontology.com/arisesIn> ;
                                                                             owl:hasValue <http://fairness_ontology.com/Conversation>
                                                                           ] .


###  http://fairness_ontology.com/CounterfactualAugmentation
<http://fairness_ontology.com/CounterfactualAugmentation> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://fairness_ontology.com/InstanceLevelRowIntervention> ;
                                                          rdfs:label "Counterfactual Augmentation" .


###  http://fairness_ontology.com/DataGeneration
<http://fairness_ontology.com/DataGeneration> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://fairness_ontology.com/DataResourcesMitigation> ;
                                              rdfs:label "Data Acquisition/Generation (D)" .


###  http://fairness_ontology.com/DataResourcesMitigation
<http://fairness_ontology.com/DataResourcesMitigation> rdf:type owl:Class ;
                                                       rdfs:subClassOf <http://fairness_ontology.com/MitigationTechnique> ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <http://fairness_ontology.com/isAppliedAt> ;
                                                                         owl:allValuesFrom <http://fairness_ontology.com/Pre-processing>
                                                                       ] ;
                                                       rdfs:label "Data Resources Mitigation"@en .


###  http://fairness_ontology.com/Dataset
<http://fairness_ontology.com/Dataset> rdf:type owl:Class ;
                                       rdfs:label "Dataset"@en ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "A dataset used in machine learning."@en .


###  http://fairness_ontology.com/DecisionTimeConstrainedDecisioning
<http://fairness_ontology.com/DecisionTimeConstrainedDecisioning> rdf:type owl:Class ;
                                                                  rdfs:subClassOf <http://fairness_ontology.com/BlackBoxDecisionOnly> ;
                                                                  rdfs:label "Decision-time Constrained Decisioning" .


###  http://fairness_ontology.com/DistanceBasedFairnessMetric
<http://fairness_ontology.com/DistanceBasedFairnessMetric> rdf:type owl:Class ;
                                                           rdfs:subClassOf <https://purl.org/twc/fmo#fairness_metric> ;
                                                           rdfs:label "Distance-based Fairness Metric" .


###  http://fairness_ontology.com/DistributionFairnessMetric
<http://fairness_ontology.com/DistributionFairnessMetric> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://fairness_ontology.com/GeneratedTextBasedFairnessMetric> ;
                                                          rdfs:label "Distribution Fairness Metric"@en ;
                                                          <http://www.w3.org/2004/02/skos/core#definition> "A metric that evaluates fairness by comparing the statistical distribution of generated outputs across groups."@en .


###  http://fairness_ontology.com/EmbeddingBasedFairnessMetric
<http://fairness_ontology.com/EmbeddingBasedFairnessMetric> rdf:type owl:Class ;
                                                            rdfs:subClassOf <https://purl.org/twc/fmo#fairness_metric> ;
                                                            rdfs:label "Embedding-based Fairness Metric"@en ;
                                                            <http://www.w3.org/2004/02/skos/core#definition> "A fairness metric that evaluates bias or fairness using representations derived from word or sentence embeddings."@en .


###  http://fairness_ontology.com/EvidenceArtifact
<http://fairness_ontology.com/EvidenceArtifact> rdf:type owl:Class ;
                                                rdfs:label "Evidence Artifact" ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "Evidence expected for compliance and auditability." .


###  http://fairness_ontology.com/FairnessConcern
<http://fairness_ontology.com/FairnessConcern> rdf:type owl:Class ;
                                               rdfs:label "Fairness Concern"@en ;
                                               <http://www.w3.org/2004/02/skos/core#definition> "A fairness concern refers to a potential or observed issue where a system’s decisions or outcomes may unjustly favor or disadvantage certain individuals or groups. It highlights risks of bias, discrimination, or unequal treatment that require attention and mitigation." .


###  http://fairness_ontology.com/FairnessRegularization
<http://fairness_ontology.com/FairnessRegularization> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://fairness_ontology.com/FullRetraining> ;
                                                      rdfs:label "Fairness Regularization" .


###  http://fairness_ontology.com/FeatureLevelColumnIntervention
<http://fairness_ontology.com/FeatureLevelColumnIntervention> rdf:type owl:Class ;
                                                              rdfs:subClassOf <http://fairness_ontology.com/DataResourcesMitigation> ;
                                                              rdfs:label "Feature-level Column Intervention (A)" .


###  http://fairness_ontology.com/FeatureLevelRowReweightingResampling
<http://fairness_ontology.com/FeatureLevelRowReweightingResampling> rdf:type owl:Class ;
                                                                    rdfs:subClassOf <http://fairness_ontology.com/DataResourcesMitigation> ;
                                                                    rdfs:label "Feature-level Row Reweighting/Resampling (C)" .


###  http://fairness_ontology.com/FeatureReview
<http://fairness_ontology.com/FeatureReview> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://fairness_ontology.com/FeatureLevelColumnIntervention> ;
                                             rdfs:label "Feature Review" .


###  http://fairness_ontology.com/FullFineTuning
<http://fairness_ontology.com/FullFineTuning> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://fairness_ontology.com/ModelAccessResourcesMitigation> ,
                                                              <http://fairness_ontology.com/TrainingResourcesMitigation> ;
                                              owl:disjointWith <http://fairness_ontology.com/PartialFineTuning> ;
                                              rdfs:label "Full Fine-tuning - White-box Model (F)" .


###  http://fairness_ontology.com/FullParameterDebiasing
<http://fairness_ontology.com/FullParameterDebiasing> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://fairness_ontology.com/FullFineTuning> ;
                                                      rdfs:label "Full Parameter Debiasing" .


###  http://fairness_ontology.com/FullPruning
<http://fairness_ontology.com/FullPruning> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://fairness_ontology.com/FullFineTuning> ;
                                           rdfs:comment "A mitigation technique that prunes an already trained model by setting to 0 some of its weights. The model is considered AS A WHOLE, by taking into account for pruning all its internal weights." ;
                                           rdfs:label "Full Pruning and Weight Masking" .


###  http://fairness_ontology.com/FullRetraining
<http://fairness_ontology.com/FullRetraining> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://fairness_ontology.com/TrainingResourcesMitigation> ;
                                              rdfs:label "Full Retraining (E)" .


###  http://fairness_ontology.com/FullWeightRedistribution
<http://fairness_ontology.com/FullWeightRedistribution> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://fairness_ontology.com/FullFineTuning> ;
                                                        rdfs:comment "A mitigation technique that redistributes the weights of an already trained model, considering it AS A WHOLE, potentially redistributing all its weights." ;
                                                        rdfs:label "Full Weight Redistribution"@en .


###  http://fairness_ontology.com/GeneratedTextBasedFairnessMetric
<http://fairness_ontology.com/GeneratedTextBasedFairnessMetric> rdf:type owl:Class ;
                                                                rdfs:subClassOf <https://purl.org/twc/fmo#fairness_metric> ;
                                                                rdfs:label "Generated Text-based Fairness Metric"@en ;
                                                                <http://www.w3.org/2004/02/skos/core#definition> "A metric that measures fairness by analyzing or scoring generated text outputs."@en .


###  http://fairness_ontology.com/Governance
<http://fairness_ontology.com/Governance> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://fairness_ontology.com/AILifecycleStep> ;
                                          rdfs:label "Governance" .


###  http://fairness_ontology.com/GovernanceOnly
<http://fairness_ontology.com/GovernanceOnly> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://fairness_ontology.com/HumanOversightMitigation> ;
                                              rdfs:label "Governance-only Interventions (J)" .


###  http://fairness_ontology.com/GranularityMetric
<http://fairness_ontology.com/GranularityMetric> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://fairness_ontology.com/RecommendationSystemMetric> ;
                                                 rdfs:label "Granularity Metric"@en .


###  http://fairness_ontology.com/GreyBoxScores
<http://fairness_ontology.com/GreyBoxScores> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://fairness_ontology.com/ModelAccessResourcesMitigation> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://fairness_ontology.com/isAppliedAt> ;
                                                               owl:allValuesFrom <http://fairness_ontology.com/Post-processing>
                                                             ] ;
                                             rdfs:label "Scores and Probabilities Access - Grey-box Model (H)" .


###  http://fairness_ontology.com/GroupFairnessNotion
<http://fairness_ontology.com/GroupFairnessNotion> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://fairness_ontology.com/OutcomeFairnessNotion> ;
                                                   owl:disjointWith <http://fairness_ontology.com/IndividualFairnessNotion> ;
                                                   <http://purl.org/dc/elements/1.1/source> "https://doi.org/10.1145/3468507.3468511"^^xsd:anyURI ;
                                                   <http://semanticscience.org/resource/hasSynonym> "group fairness"@en ;
                                                   rdfs:label "Group Fairness Notion"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "A family of fairness notions with the common objective to ensure that groups who differ by their sensitive attributes are treated equally. (Note: Occasionally, \"group fairness\" is used to refer to statistical parity specifically, instead of the broader meaning as defined here)."@en .


###  http://fairness_ontology.com/HeadOnly
<http://fairness_ontology.com/HeadOnly> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://fairness_ontology.com/PartialFineTuning> ;
                                        rdfs:label "Head-only" .


###  http://fairness_ontology.com/HumanOversightMitigation
<http://fairness_ontology.com/HumanOversightMitigation> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://fairness_ontology.com/MitigationTechnique> ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://fairness_ontology.com/isAppliedAt> ;
                                                                          owl:allValuesFrom <http://fairness_ontology.com/Governance>
                                                                        ] ;
                                                        rdfs:label "Human Oversight Mitigation" .


###  http://fairness_ontology.com/ImpactFocusedMetric
<http://fairness_ontology.com/ImpactFocusedMetric> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://fairness_ontology.com/OptimizationObjectMetric> ;
                                                   rdfs:label "Impact-focused Metric"@en .


