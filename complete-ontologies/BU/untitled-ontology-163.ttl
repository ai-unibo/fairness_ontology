<http://fairness_ontology.com/AnalyticsApproach> rdf:type owl:NamedIndividual ,
                                                          <http://fairness_ontology.com/AILifecycleStep> ,
                                                          <http://fairness_ontology.com/Scoping> ;
                                                 <http://fairness_ontology.com/isFollowedBy> <http://fairness_ontology.com/DataRequirements> .


