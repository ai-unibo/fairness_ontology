###  http://fairness_ontology.com/TotalVariationNorm
:TotalVariationNorm rdf:type owl:NamedIndividual ,
                             :DistanceBasedFairnessMetric ,
                             :ScientificArtifact ,
                             fmo:fairness_metric ;
                    :extends :FairnessThroughAwareness ,
                             :IndividualFairness ;
                    :hasBeenAppliedTo :Education ,
                                      :Healthcare ,
                                      :LawAndJustice ;
                    :isProposedBy <http://fairness_ontology.com/2012_DWORK> ;
                    :isUsedBy <http://fairness_ontology.com/2012_DWORK> ,
                              <http://fairness_ontology.com/2018_YONA> ,
                              <http://fairness_ontology.com/2019_LAHOTI> ,
                              <http://fairness_ontology.com/2020_YUROCHKIN> ,
                              <http://fairness_ontology.com/2025_GAO> ;
                    :measures :FairnessThroughAwareness ,
                              :IndividualFairness ;
                    :refersTo :Classification ;
                    :scientificArtifactDescription "Given P and Q, probability measures on a finite domain A, total variation norm suggests to compute the distance between the distributions as: $D_{\\mathrm{tv}}(P, Q) = \\frac{1}{2} \\sum_{a \\in A} | P(a) - Q(a) | .$" ;
                    skos:definition "It is the first poposed metric connected to the notion of Fairness through awareness" .


