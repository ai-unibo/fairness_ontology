                                      :hasBeenAppliedTo :Healthcare ,
                                                        :LawAndJustice ;
                                      :isEquivalentTo :EqualizedOdds ,
                                                      :ErrorRateBalance ;
                                      :isMeasuredBy :OutcomeUnfairness ;
                                      :isProposedBy <http://fairness_ontology.com/2018_VANMASSENHOVE> ,
