###  http://fairness_ontology.com/QualityWeightedFairness
:QualityWeightedFairness rdf:type owl:NamedIndividual ,
                                  :GroupFairnessNotion ,
                                  :IndependenceFairnessNotion ,
                                  :ObservationalFairnessNotion ,
                                  :OutcomeFairnessNotion ,
                                  :ScientificArtifact ,
                                  fmo:fairness_notion ;
                         :isEquivalentTo :EquityOfAmortizedAttention ,
                                         :EquityOfAttention ;
                         :isMeasuredBy :Variance ;
                         :isProposedBy <http://fairness_ontology.com/2021_WU> ;
                         :isUsedBy <http://fairness_ontology.com/2018_BIEGA> ,
                                   <http://fairness_ontology.com/2021_WU> ;
                         :scientificArtifactDescription """A recommendation result is quality weighted fair exposure for providers if each provider in P receives exposure ($e_p$) proportional to the sum of quality scores (i.e., ratings) of items it offers ($I_p$) in the recommendation lists of all customers, i.e., $\\frac{e_{p_1}}{\\sum_{i \\in I_{p_1}} \\sum_{u \\in U} v_{u,i}}= \\frac{e_{p_2}}{ \\sum_{i \\in I_{p_2}} \\sum_{u \\in U} v_{u,i}},
\\quad \\forall\\, p_1, p_2 \\in P .$""" ;
                         skos:definition "the metric is first used in 2018_BIEGA, but the formailization is due to a later work by 2021_WU" .


