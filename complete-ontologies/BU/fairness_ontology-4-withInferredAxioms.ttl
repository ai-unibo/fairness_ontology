@prefix : <http://fairness_ontology.com/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix fmo: <https://purl.org/twc/fmo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix resource: <http://semanticscience.org/resource/> .
@base <http://fairness_ontology.com/> .

<http://fairness_ontology.com/> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://fairness_ontology.com/hasAntonym
:hasAntonym rdf:type owl:AnnotationProperty ;
            rdfs:comment "Relates a concept to its antonym, given as a string or URI."@en ;
            rdfs:label "has antonym"@en .


###  http://fairness_ontology.com/isBasedOnSocialPrinciple
:isBasedOnSocialPrinciple rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/source
dc:source rdf:type owl:AnnotationProperty .


###  http://semanticscience.org/resource/hasSynonym
resource:hasSynonym rdf:type owl:AnnotationProperty .


###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  https://purl.org/twc/fmo#probabilistic_definition
fmo:probabilistic_definition rdf:type owl:AnnotationProperty .


###  https://purl.org/twc/fmo#tag
fmo:tag rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://fairness_ontology.com/arisesIn
:arisesIn rdf:type owl:ObjectProperty ;
          rdfs:domain :FairnessConcern ;
          rdfs:range :AITypeOfUse ,
                     [ rdf:type owl:Class ;
                       owl:oneOf ( :Conversation
                                   :Prediction
                                   :Recommendation
                                 )
                     ] ;
          rdfs:label "arises in" .


###  http://fairness_ontology.com/enforces
:enforces rdf:type owl:ObjectProperty ;
          owl:inverseOf :isEnforcedBy ;
          rdfs:domain :MitigationTechnique ,
                      :ScientificArtifact ;
          rdfs:range :ScientificArtifact ,
                     fmo:fairness_metric ;
          rdfs:label "enforces"@en .


###  http://fairness_ontology.com/exposesTo
:exposesTo rdf:type owl:ObjectProperty ;
           rdfs:domain fmo:bias ;
           rdfs:range :FairnessConcern ;
           rdfs:label "exposes to"@en .


###  http://fairness_ontology.com/extends
:extends rdf:type owl:ObjectProperty ;
         rdfs:domain :ScientificArtifact ;
         rdfs:range :ScientificArtifact ;
         rdfs:label "extends" ;
         skos:definition "A certain Scientific Artifact may extend another. E.g., a certain Fairness Notion can extend another one" .


###  http://fairness_ontology.com/follows
:follows rdf:type owl:ObjectProperty ;
         owl:inverseOf :isFollowedBy ;
         rdfs:domain :AILifecycleStep ;
         rdfs:range :AILifecycleStep ;
         rdfs:label "follows" .


###  http://fairness_ontology.com/guides
:guides rdf:type owl:ObjectProperty ;
        owl:inverseOf :isGuidedBy ;
        rdfs:domain :SocialPrinciple ;
        rdfs:range :ScientificArtifact ,
                   fmo:fairness_notion ;
        rdfs:comment "Links a fairness notion to its underpinning social principle such as equity or equality."@en ;
        rdfs:label "guides"@en .


###  http://fairness_ontology.com/hasBeenAppliedTo
:hasBeenAppliedTo rdf:type owl:ObjectProperty ;
                  rdfs:domain :ScientificArtifact ;
                  rdfs:range :ApplicationDomain ;
                  rdfs:label "has been applied to"@en ;
                  skos:definition "A certain fairness notion has been applied to certain application domains."@en .


###  http://fairness_ontology.com/hasBeenTestedOn
:hasBeenTestedOn rdf:type owl:ObjectProperty ;
                 rdfs:domain :ScientificArtifact ;
                 rdfs:range :Dataset ;
                 rdfs:label "has been tested on"@en .


###  http://fairness_ontology.com/isAddressedWith
:isAddressedWith rdf:type owl:ObjectProperty ;
                 rdfs:domain :FairnessConcern ;
                 rdfs:range :ScientificArtifact ,
                            fmo:fairness_notion ;
                 rdfs:label "is addressed with"@en .


###  http://fairness_ontology.com/isAppliedAt
:isAppliedAt rdf:type owl:ObjectProperty ;
             rdfs:domain :MitigationTechnique ,
                         :ScientificArtifact ;
             rdfs:range :AILifecycleStep ;
             rdfs:label "is applied at" .


###  http://fairness_ontology.com/isEnforcedBy
:isEnforcedBy rdf:type owl:ObjectProperty ;
              rdfs:domain :ScientificArtifact ,
                          fmo:fairness_metric ;
              rdfs:range :MitigationTechnique ,
                         :ScientificArtifact ;
              rdfs:label "is enforced by"@en .


###  http://fairness_ontology.com/isEquivalentTo
:isEquivalentTo rdf:type owl:ObjectProperty ,
                         owl:SymmetricProperty ;
                rdfs:domain :ScientificArtifact ,
                            fmo:fairness_notion ;
                rdfs:range :ScientificArtifact ,
                           fmo:fairness_notion ;
                rdfs:label "is equivalent to"@en ;
                skos:definition "A certain fairness notion can be equal to some other fairness notions."@en .


###  http://fairness_ontology.com/isFollowedBy
:isFollowedBy rdf:type owl:ObjectProperty ;
              rdfs:domain :AILifecycleStep ;
              rdfs:range :AILifecycleStep ;
              rdfs:label "is followed by" .


###  http://fairness_ontology.com/isGuidedBy
:isGuidedBy rdf:type owl:ObjectProperty ;
            rdfs:domain :ScientificArtifact ,
                        fmo:fairness_notion ;
            rdfs:range :SocialPrinciple ;
            rdfs:comment "Links a fairness notion to its underpinning social principle such as equity or equality."@en ;
            rdfs:label "is guided by"@en .


###  http://fairness_ontology.com/isMeasuredBy
:isMeasuredBy rdf:type owl:ObjectProperty ;
              owl:inverseOf :measures ;
              rdfs:domain :ScientificArtifact ,
                          fmo:fairness_notion ;
              rdfs:range :ScientificArtifact ,
                         fmo:fairness_metric ;
              rdfs:label "is measured by"@en ;
              skos:definition "A fairness notion is measured by a fairness metric if comparisons made with the given metric are a valid way to determine fairness with this notion."@en .


###  http://fairness_ontology.com/isMitigatedBy
:isMitigatedBy rdf:type owl:ObjectProperty ;
               owl:inverseOf :mitigates ;
               rdfs:domain fmo:bias ;
               rdfs:range :ScientificArtifact ,
                          fmo:fairness_notion ;
               rdfs:label "is mitigated by"@en ;
               skos:definition "A certain bias in the use-case can be mitigated by enforcing specific fairness notions."@en .


###  http://fairness_ontology.com/isOperationalizedBy
:isOperationalizedBy rdf:type owl:ObjectProperty ;
                     owl:inverseOf :operationalize ;
                     rdfs:domain :LegalRequirement ;
                     rdfs:range :ScientificArtifact ,
                                fmo:fairness_notion ;
                     rdfs:label "is operationalized by" .


###  http://fairness_ontology.com/isProposedBy
:isProposedBy rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :isUsedBy ;
              rdfs:domain :ScientificArtifact ;
              rdfs:range :ScientificPaper ;
              rdfs:label "is proposed by"@en ;
              skos:definition "A certain fairness notion is proposed by a certain scientific paper."@en .


###  http://fairness_ontology.com/isQuantifiedBy
:isQuantifiedBy rdf:type owl:ObjectProperty ;
                rdfs:domain :FairnessConcern ;
                rdfs:range :ScientificArtifact ,
                           fmo:fairness_metric ;
                rdfs:label "is quantified by"@en .


###  http://fairness_ontology.com/isRelevantDuring
:isRelevantDuring rdf:type owl:ObjectProperty ;
                  rdfs:domain :LegalRequirement ;
                  rdfs:range :AILifecycleStep ;
                  rdfs:label "is relevant during" .


###  http://fairness_ontology.com/isSuitableFor
:isSuitableFor rdf:type owl:ObjectProperty ;
               rdfs:domain :ScientificArtifact ,
                           fmo:fairness_metric ;
               rdfs:range :AITypeOfUse ,
                          [ rdf:type owl:Class ;
                            owl:oneOf ( :Conversation
                                        :Prediction
                                        :Recommendation
                                      )
                          ] ;
               rdfs:label "is suitable for" .


###  http://fairness_ontology.com/isTriggeredBy
:isTriggeredBy rdf:type owl:ObjectProperty ;
               owl:inverseOf :triggers .


###  http://fairness_ontology.com/isUsedBy
:isUsedBy rdf:type owl:ObjectProperty ;
          rdfs:domain :ScientificArtifact ;
          rdfs:range :ScientificPaper ;
          rdfs:label "is used by"@en ;
          skos:definition "A certain fairness notion is used by some scientific papers."@en .


###  http://fairness_ontology.com/itsComplianceIsSupportedWith
:itsComplianceIsSupportedWith rdf:type owl:ObjectProperty ;
                              owl:inverseOf :supportsComplianceWith ;
                              rdfs:domain :LegalRequirement ;
                              rdfs:range :MitigationTechnique ,
                                         :ScientificArtifact ;
                              rdfs:label "its compliance is supported by" .


###  http://fairness_ontology.com/measures
:measures rdf:type owl:ObjectProperty ;
          rdfs:domain :ScientificArtifact ,
                      fmo:fairness_metric ;
          rdfs:range :ScientificArtifact ,
                     fmo:fairness_notion ;
          rdfs:label "measures"@en ;
          skos:definition "A fairness metric measures some fairness notion if comparisons made with the given metric are a valid way to determine fairness with this notion."@en .


###  http://fairness_ontology.com/mitigatedWith
:mitigatedWith rdf:type owl:ObjectProperty ;
               rdfs:domain :FairnessConcern ;
               rdfs:range :MitigationTechnique ,
                          :ScientificArtifact ;
               rdfs:label "mitigated with"@en .


###  http://fairness_ontology.com/mitigates
:mitigates rdf:type owl:ObjectProperty ;
           rdfs:domain :ScientificArtifact ,
                       fmo:fairness_notion ;
           rdfs:range fmo:bias ;
           rdfs:label "mitigates"@en ;
           skos:definition "A fairness notion is required to mitigate a certain bias."@en .


###  http://fairness_ontology.com/operationalize
:operationalize rdf:type owl:ObjectProperty ;
                rdfs:domain :ScientificArtifact ,
                            fmo:fairness_notion ;
                rdfs:range :LegalRequirement ;
                rdfs:label "operationalize" .


###  http://fairness_ontology.com/refersTo
:refersTo rdf:type owl:ObjectProperty ;
          rdfs:domain :ScientificArtifact ;
          rdfs:range :AITask ;
          rdfs:label "refers to"@en ;
          skos:definition "A certain fairness notion refers to (is suitable for) a certain set of AI tasks."@en .


###  http://fairness_ontology.com/relatesTo
:relatesTo rdf:type owl:ObjectProperty ;
           rdfs:domain :Dataset ;
           rdfs:range :ApplicationDomain ;
           rdfs:label "relates to" .


###  http://fairness_ontology.com/requires
:requires rdf:type owl:ObjectProperty ;
          rdfs:domain :FairnessConcern ;
          rdfs:range :EvidenceArtifact .


###  http://fairness_ontology.com/supportsComplianceWith
:supportsComplianceWith rdf:type owl:ObjectProperty ;
                        rdfs:domain :MitigationTechnique ,
                                    :ScientificArtifact ;
                        rdfs:range :LegalRequirement ;
                        rdfs:label "supports compliance with" .


###  http://fairness_ontology.com/testedOn
:testedOn rdf:type owl:ObjectProperty ;
          rdfs:domain :FairnessConcern ;
          rdfs:range :Dataset ;
          rdfs:label "tested on"@en .


###  http://fairness_ontology.com/triggers
:triggers rdf:type owl:ObjectProperty ;
          rdfs:domain :FairnessConcern ;
          rdfs:range :LegalRequirement .


###  http://semanticscience.org/resource/SIO_000068
resource:SIO_000068 rdf:type owl:ObjectProperty ;
                    rdfs:domain :LegalRequirement ;
                    rdfs:range :Legislation ;
                    rdfs:label "is part of"@en .


#################################################################
#    Data properties
#################################################################

###  http://fairness_ontology.com/concernDescription
:concernDescription rdf:type owl:DatatypeProperty ;
                    rdfs:domain :FairnessConcern ;
                    rdfs:range xsd:string ;
                    rdfs:label "concern description"@en .


###  http://fairness_ontology.com/concernName
:concernName rdf:type owl:DatatypeProperty ;
             rdfs:domain :FairnessConcern ;
             rdfs:range xsd:string ;
             rdfs:label "concern name"@en .


###  http://fairness_ontology.com/datasetDescription
:datasetDescription rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Dataset ;
                    rdfs:range xsd:string ;
                    rdfs:label "dataset description"@en .


###  http://fairness_ontology.com/datasetName
:datasetName rdf:type owl:DatatypeProperty ;
             rdfs:domain :Dataset ;
             rdfs:range xsd:string ;
             rdfs:label "dataset name"@en .


###  http://fairness_ontology.com/scientificArtifactDescription
:scientificArtifactDescription rdf:type owl:DatatypeProperty ;
                               rdfs:domain :ScientificArtifact ;
                               rdfs:range xsd:string ;
                               rdfs:label "scientific artifact description"@en ;
                               skos:definition "A latex description of a scientific artifact."@en .


#################################################################
#    Classes
#################################################################

###  http://fairness_ontology.com/AILifecycleStep
:AILifecycleStep rdf:type owl:Class ;
                 rdfs:label "AI Lifecycle Step" .


###  http://fairness_ontology.com/AITask
:AITask rdf:type owl:Class ;
        rdfs:label "AI Task"@en ;
        skos:definition "The functional task that the AI system is able to perform. Previously was MLTask, AITask and AICapability."@en .


###  http://fairness_ontology.com/AITypeOfUse
:AITypeOfUse rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Class ;
                                   owl:oneOf ( :Conversation
                                               :Prediction
                                               :Recommendation
                                             )
                                 ] ;
             rdfs:subClassOf [ rdf:type owl:Class ;
                               owl:oneOf ( :Conversation
                                           :Prediction
                                           :Recommendation
                                         )
                             ] ;
             rdfs:comment "Describes the type of use of (or the type of interaction with) the AI system. It impacts obligations. Previously called AIScenario" ;
             rdfs:label "AI Type Of Use" .


###  http://fairness_ontology.com/Adapters
:Adapters rdf:type owl:Class ;
          rdfs:subClassOf :MitigationTechnique ,
                          :ModelAccessResourcesMitigation ,
                          :PartialFineTuning ,
                          :TrainingResourcesMitigation ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :isAppliedAt ;
                            owl:allValuesFrom :In-processing
                          ] ;
          rdfs:label "Adapters" .


###  http://fairness_ontology.com/AdversarialLearning
:AdversarialLearning rdf:type owl:Class ;
                     rdfs:subClassOf :FullRetraining ,
                                     :MitigationTechnique ,
                                     :TrainingResourcesMitigation ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :isAppliedAt ;
                                       owl:allValuesFrom :In-processing
                                     ] ;
                     rdfs:label "Adversarial Learning" .


###  http://fairness_ontology.com/AmortizedGranularityMetric
:AmortizedGranularityMetric rdf:type owl:Class ;
                            rdfs:subClassOf :GranularityMetric ,
                                            :RecommendationSystemMetric ,
                                            fmo:fairness_metric ;
                            rdfs:label "Amortized Granularity Metric"@en .


###  http://fairness_ontology.com/ApplicationDomain
:ApplicationDomain rdf:type owl:Class ;
                   rdfs:label "Application Domain"@en ;
                   skos:definition "The specific real-world area or context in which the system is designed to operate. Previously was UseArea. According to AI Watch taxonomy can also me called \"Economic Sector or Use Area\""@en .


###  http://fairness_ontology.com/AuditSets
:AuditSets rdf:type owl:Class ;
           rdfs:subClassOf :DataGeneration ,
                           :DataResourcesMitigation ,
                           :MitigationTechnique ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :isAppliedAt ;
                             owl:allValuesFrom :Pre-processing
                           ] ;
           rdfs:label "Audit Sets" .


###  http://fairness_ontology.com/BanditsBasedLearning
:BanditsBasedLearning rdf:type owl:Class ;
                      rdfs:subClassOf :FullRetraining ,
                                      :MitigationTechnique ,
                                      :TrainingResourcesMitigation ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :isAppliedAt ;
                                        owl:allValuesFrom :In-processing
                                      ] ;
                      rdfs:label "Bandits-based Learning" .


###  http://fairness_ontology.com/BlackBoxDecisionOnly
:BlackBoxDecisionOnly rdf:type owl:Class ;
                      rdfs:subClassOf :MitigationTechnique ,
                                      :ModelAccessResourcesMitigation ,
                                      :ScientificArtifact ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :isAppliedAt ;
                                        owl:allValuesFrom :Post-processing
                                      ] ;
                      rdfs:label "Decision Layer Control - Black-box Model (I)" .


###  http://fairness_ontology.com/Blinding
:Blinding rdf:type owl:Class ;
          rdfs:subClassOf :DataResourcesMitigation ,
                          :FeatureLevelColumnIntervention ,
                          :MitigationTechnique ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :isAppliedAt ;
                            owl:allValuesFrom :Pre-processing
                          ] ;
          rdfs:label "Blinding and Proxy Removal" .


###  http://fairness_ontology.com/CalibrationBasedFairnessMetric
:CalibrationBasedFairnessMetric rdf:type owl:Class ;
                                rdfs:subClassOf :ScientificArtifact ,
                                                fmo:fairness_metric ;
                                rdfs:label "Calibration-based Fairness Metric" ;
                                skos:definition "A measurement of any fairness notion, partially connected to the confusion matrix principles, these metrics are usually referred with the term  calibration-based, with the very aim of distinguishing their prevalent attention to the predictive values." .


###  http://fairness_ontology.com/CalibrationBasedMitigation
:CalibrationBasedMitigation rdf:type owl:Class ;
                            rdfs:subClassOf :GreyBoxScores ,
                                            :MitigationTechnique ,
                                            :ModelAccessResourcesMitigation ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :isAppliedAt ;
                                              owl:allValuesFrom :Post-processing
                                            ] ;
                            rdfs:label "Calibration-based Mitigation" .


###  http://fairness_ontology.com/CausalFairnessNotion
:CausalFairnessNotion rdf:type owl:Class ;
                      rdfs:subClassOf :OutcomeFairnessNotion ,
                                      :ScientificArtifact ,
                                      fmo:fairness_notion ;
                      owl:disjointWith :ObservationalFairnessNotion ;
                      resource:hasSynonym "causal fairness"@en ;
                      rdfs:label "Causal Fairness Notion"@en ;
                      skos:definition "A family of fairness notions focusing on the causal relations between variables."@en .


###  http://fairness_ontology.com/ClassifierFairnessMetric
:ClassifierFairnessMetric rdf:type owl:Class ;
                          rdfs:subClassOf :GeneratedTextBasedFairnessMetric ,
                                          :ScientificArtifact ,
                                          fmo:fairness_metric ;
                          rdfs:label "Classifier Fairness Metric"@en ;
                          skos:definition "A metric that employs a classifier on generated text to assess the presence of bias or fairness."@en .


###  http://fairness_ontology.com/Cleaning
:Cleaning rdf:type owl:Class ;
          rdfs:subClassOf :DataResourcesMitigation ,
                          :InstanceLevelRowIntervention ,
                          :MitigationTechnique ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :isAppliedAt ;
                            owl:allValuesFrom :Pre-processing
                          ] ;
          rdfs:label "Cleaning" .


###  http://fairness_ontology.com/ConfusionMatrixBasedFairnessMetric
:ConfusionMatrixBasedFairnessMetric rdf:type owl:Class ;
                                    rdfs:subClassOf :ScientificArtifact ,
                                                    fmo:fairness_metric ;
                                    rdfs:label "Confusion Matrix-based Fairness Metric"@en ;
                                    skos:definition "A measurement of any fairness notion, focusing on the amount of correct/incorrect classifications inferred by the predictor."@en .


###  http://fairness_ontology.com/ConstrainedOptimization
:ConstrainedOptimization rdf:type owl:Class ;
                         rdfs:subClassOf :FullRetraining ,
                                         :MitigationTechnique ,
                                         :TrainingResourcesMitigation ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :isAppliedAt ;
                                           owl:allValuesFrom :In-processing
                                         ] ;
                         rdfs:label "Constrained Optimization" .


###  http://fairness_ontology.com/ConversationFairnessConcern
:ConversationFairnessConcern rdf:type owl:Class ;
                             rdfs:subClassOf :FairnessConcern ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty :arisesIn ;
                                               owl:hasValue :Conversation
                                             ] .


###  http://fairness_ontology.com/CounterfactualAugmentation
:CounterfactualAugmentation rdf:type owl:Class ;
                            rdfs:subClassOf :DataResourcesMitigation ,
                                            :InstanceLevelRowIntervention ,
                                            :MitigationTechnique ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :isAppliedAt ;
                                              owl:allValuesFrom :Pre-processing
                                            ] ;
                            rdfs:label "Counterfactual Augmentation" .


###  http://fairness_ontology.com/DataGeneration
:DataGeneration rdf:type owl:Class ;
                rdfs:subClassOf :DataResourcesMitigation ,
                                :MitigationTechnique ,
                                :ScientificArtifact ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :isAppliedAt ;
                                  owl:allValuesFrom :Pre-processing
                                ] ;
                rdfs:label "Data Acquisition/Generation (D)" .


###  http://fairness_ontology.com/DataResourcesMitigation
:DataResourcesMitigation rdf:type owl:Class ;
                         rdfs:subClassOf :MitigationTechnique ,
                                         :ScientificArtifact ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :isAppliedAt ;
                                           owl:allValuesFrom :Pre-processing
                                         ] ;
                         rdfs:label "Data Resources Mitigation"@en .


###  http://fairness_ontology.com/Dataset
:Dataset rdf:type owl:Class ;
         rdfs:label "Dataset"@en ;
         skos:definition "A dataset used in machine learning."@en .


###  http://fairness_ontology.com/DecisionTimeConstrainedDecisioning
:DecisionTimeConstrainedDecisioning rdf:type owl:Class ;
                                    rdfs:subClassOf :BlackBoxDecisionOnly ,
                                                    :MitigationTechnique ,
                                                    :ModelAccessResourcesMitigation ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty :isAppliedAt ;
                                                      owl:allValuesFrom :Post-processing
                                                    ] ;
                                    rdfs:label "Decision-time Constrained Decisioning" .


###  http://fairness_ontology.com/DistanceBasedFairnessMetric
:DistanceBasedFairnessMetric rdf:type owl:Class ;
                             rdfs:subClassOf :ScientificArtifact ,
                                             fmo:fairness_metric ;
                             rdfs:label "Distance-based Fairness Metric" .


###  http://fairness_ontology.com/DistributionFairnessMetric
:DistributionFairnessMetric rdf:type owl:Class ;
                            rdfs:subClassOf :GeneratedTextBasedFairnessMetric ,
                                            :ScientificArtifact ,
                                            fmo:fairness_metric ;
                            rdfs:label "Distribution Fairness Metric"@en ;
                            skos:definition "A metric that evaluates fairness by comparing the statistical distribution of generated outputs across groups."@en .


###  http://fairness_ontology.com/EmbeddingBasedFairnessMetric
:EmbeddingBasedFairnessMetric rdf:type owl:Class ;
                              rdfs:subClassOf :ScientificArtifact ,
                                              fmo:fairness_metric ;
                              rdfs:label "Embedding-based Fairness Metric"@en ;
                              skos:definition "A fairness metric that evaluates bias or fairness using representations derived from word or sentence embeddings."@en .


###  http://fairness_ontology.com/EvidenceArtifact
:EvidenceArtifact rdf:type owl:Class ;
                  rdfs:label "Evidence Artifact" ;
                  skos:definition "Evidence expected for compliance and auditability. That is, a piece of documentation, data, or analytical output that provides verifiable information about the presence, assessment, or mitigation of a specific socio-technical concern in an AI system. It supports the evaluation of that concern by supplying measurable or auditable evidence (e.g., logs, dataset analyses, reports, or metrics) related to the system’s behavior, data, or operational context." .


###  http://fairness_ontology.com/FairnessConcern
:FairnessConcern rdf:type owl:Class ;
                 rdfs:label "Fairness Concern"@en ;
                 skos:definition "A fairness concern refers to a potential or observed issue where a system’s decisions or outcomes may unjustly favor or disadvantage certain individuals or groups. It highlights risks of bias, discrimination, or unequal treatment that require attention and mitigation." .


###  http://fairness_ontology.com/FairnessRegularization
:FairnessRegularization rdf:type owl:Class ;
                        rdfs:subClassOf :FullRetraining ,
                                        :MitigationTechnique ,
                                        :TrainingResourcesMitigation ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty :isAppliedAt ;
                                          owl:allValuesFrom :In-processing
                                        ] ;
                        rdfs:label "Fairness Regularization" .


###  http://fairness_ontology.com/FeatureLevelColumnIntervention
:FeatureLevelColumnIntervention rdf:type owl:Class ;
                                rdfs:subClassOf :DataResourcesMitigation ,
                                                :MitigationTechnique ,
                                                :ScientificArtifact ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty :isAppliedAt ;
