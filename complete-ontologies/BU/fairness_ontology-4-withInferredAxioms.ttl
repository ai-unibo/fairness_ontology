                                  :ConsistencyScore ,
                                  :IndividualConsistencyScore ,
                                  :LowIndividualConsistencyCount ,
                                  :ProportionalConsistencyScore ,
                                  :RelativeLInfiniteMetric ,
                                  :SimilarityRobustnessOfIndividualConsistency ,
