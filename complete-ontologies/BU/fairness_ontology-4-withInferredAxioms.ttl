                                owl:allValuesFrom :Pre-processing
                              ] ;
                     :isProposedBy <http://fairness_ontology.com/2018_DIXON> ;
                     :isUsedBy <http://fairness_ontology.com/2018_DIXON> ;
                     :supportsComplianceWith :Art.10 ,
                                             :Art.10.3 ,
                                             :Art.11 ,
                                             :Art.12 ,
                                             :Art.13 ,
                                             :Art.14 ,
                                             :Art.15 ,
                                             :Art.16 ,
                                             :Art.24 ,
                                             :Art.26 ,
                                             :Art.27 ,
                                             :Art.29 ,
                                             :Art.43 ,
                                             :Art.50 ,
                                             :Art.53 ,
                                             :Art.77 ,
                                             :Art.9 ;
                     :scientificArtifactDescription "Add non-toxic examples for groups disproportionately represented with toxicity, until the distribution between toxic and non-toxic examples is balanced across groups." .


###  http://fairness_ontology.com/AdvBERT
:AdvBERT rdf:type owl:NamedIndividual ,
                  :AdversarialLearning ,
                  :FullRetraining ,
                  :MitigationTechnique ,
                  :ScientificArtifact ,
                  :TrainingResourcesMitigation ,
                  [ rdf:type owl:Restriction ;
                    owl:onProperty :isAppliedAt ;
                    owl:allValuesFrom :In-processing
                  ] ;
         :isProposedBy <http://fairness_ontology.com/2021_REKABSAZ> ;
         :isUsedBy <http://fairness_ontology.com/2021_REKABSAZ> ;
         :supportsComplianceWith :Art.15 ,
                                 :Art.53 ;
         :scientificArtifactDescription "Adversarial learning with a ranking of information retrieval results to reduce bias while maintaining relevance, proposing a gender-invariant ranking model. Contrastive pairs consist of a relevant and non-relevant document to a query, with a corresponding social group label denoting if the query or document contains the protected attribute. The adversarial discriminator predicts the social group label from an encoder, while the encoder simultaneously tries to trick the discriminator while also maximizing relevance scores." .


###  http://fairness_ontology.com/AdvPredictedScore
:AdvPredictedScore rdf:type owl:NamedIndividual ,
                            :AdversarialLearning ,
                            :FullRetraining ,
                            :MitigationTechnique ,
                            :ScientificArtifact ,
                            :TrainingResourcesMitigation ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :isAppliedAt ;
                              owl:allValuesFrom :In-processing
                            ] ;
                   :isProposedBy <http://fairness_ontology.com/2020_ZHU> ;
                   :isUsedBy <http://fairness_ontology.com/2020_ZHU> ;
                   :supportsComplianceWith :Art.15 ;
                   :scientificArtifactDescription "Learn fair predicted scores by enhancing score distribution similarity" .


###  http://fairness_ontology.com/AdversarialFDP
:AdversarialFDP rdf:type owl:NamedIndividual ,
                         :AdversarialLearning ,
                         :FullRetraining ,
                         :MitigationTechnique ,
                         :ScientificArtifact ,
                         :TrainingResourcesMitigation ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :isAppliedAt ;
                           owl:allValuesFrom :In-processing
                         ] ;
                :isProposedBy <http://fairness_ontology.com/2019_CELISa> ;
                :isUsedBy <http://fairness_ontology.com/2019_CELISa> ;
                :supportsComplianceWith :Art.10.5 ,
                                        :Art.11 ,
                                        :Art.12 ,
                                        :Art.13 ,
                                        :Art.14 ,
                                        :Art.16 ,
                                        :Art.17 ,
                                        :Art.20 ,
                                        :Art.23 ,
                                        :Art.24 ,
                                        :Art.26 ,
                                        :Art.27 ,
                                        :Art.29 ,
                                        :Art.43 ,
                                        :Art.6 ,
                                        :Art.6.2 ,
                                        :Art.77 ,
                                        :Art.9 ;
                :scientificArtifactDescription "The adversary seeks to determine whether the training process is fair, and when not, feedback from the adversary is used to improve the model. Uses FDR as a fariness metric within the adversary to apply feedback for model tuning as a form of in-processing: the adversary penalizes the model if a sensitive variable is predictable from the dependent variable." .


###  http://fairness_ontology.com/AlgorithmicBias
:AlgorithmicBias rdf:type owl:NamedIndividual ,
                          fmo:bias ;
                 dc:source "https://doi.org/10.1145/3457607"^^xsd:anyURI ;
                 rdfs:label "Algorithmic Bias"@en ;
                 skos:definition "Algorithmic bias is when the bias is not present in the input data and is added purely by the algorithm."@en .


###  http://fairness_ontology.com/AllUnmaskedLikelihood
:AllUnmaskedLikelihood rdf:type owl:NamedIndividual ,
                                :ProbabilityBasedFairnessMetric ,
                                :PseudoLogLikelihoodFairnessMetric ,
                                :ScientificArtifact ,
                                fmo:fairness_metric ;
                       :extends :ContextAssociationTest ,
                                :CrowSPairsScore ;
                       :isProposedBy <http://fairness_ontology.com/2022_KANEKO> ;
                       :isUsedBy <http://fairness_ontology.com/2022_KANEKO> ;
                       :scientificArtifactDescription "Extends the CrowS-Pair Score and CAT to consider multiple correct candidate predictions. While pseudo-loglikelihood and CAT consider a single correct answer for a masked test example, AUL provides an unmasked sentence to the model and predicts all tokens in the sentence. The unmasked input provides the model with all information to predict a token, which can improve the prediction accuracy of the model, and avoids selection bias in the choice of which words to mask." .


###  http://fairness_ontology.com/AnalyticsApproach
:AnalyticsApproach rdf:type owl:NamedIndividual ,
                            :AILifecycleStep ,
                            :Scoping ;
                   :follows :BusinessRequirements ;
                   :isFollowedBy :DataRequirements .


###  http://fairness_ontology.com/Art.10
:Art.10 rdf:type owl:NamedIndividual ,
                 :LegalRequirement ,
                 :TechnicalLegalRequirement ;
        :isOperationalizedBy :Calibration ,
                             :ConditionalStatisticalParity ,
                             :CounterfactualFairness ,
                             :DemographicParity ,
                             :EqualOpportunity ,
                             :EqualizedOdds ,
                             :FairnessThroughAwareness ,
                             :IndividualFairness ,
                             :MatchingConditionalFrequencies ,
                             :StatisticalParity ,
                             :TestFairness ;
        :itsComplianceIsSupportedWith :AddNonToxicExamples ,
                                      :AugmentedAntidoteData ,
                                      :BlocklistDocumentRemoval ,
                                      :CDA ,
                                      :ControlOffensiveTokens ,
                                      :GenderneutralAlternatives ,
                                      :LogLikeDocumentRemoval ,
                                      :PredictedReplacements ,
                                      :REALTOXICITYPROMPTS ,
                                      :ReSamplingProtectedGroup ,
                                      :ReplaceStereotypes ;
        resource:SIO_000068 :EU_AI_Act ;
        rdfs:comment "Establishes data and data governance requirements for high-risk AI systems, including quality, relevance, representativeness and appropriate statistical properties of training, validation and testing data. Notes: Umbrella provision for data quality and bias control; detailed constraints are set in specific paragraphs." .


###  http://fairness_ontology.com/Art.10.3
:Art.10.3 rdf:type owl:NamedIndividual ,
                   :LegalRequirement ,
                   :TechnicalLegalRequirement ;
          :isOperationalizedBy :ConditionalStatisticalParity ,
                               :CounterfactualFairness ,
                               :DemographicParity ,
                               :FairnessThroughAwareness ,
                               :IndividualFairness ,
                               :StatisticalParity ;
          :isRelevantDuring :DataCollection ,
                            :DataPreparation ;
          :isTriggeredBy :BiasedHistoricalExamples ,
                         :DisparateSystemPerformance ,
                         :Erasure ,
                         :IncompleteHistoricalExamples ;
          :itsComplianceIsSupportedWith :AddNonToxicExamples ,
                                        :AugmentedAntidoteData ,
                                        :BlocklistDocumentRemoval ,
                                        :CDA ,
                                        :GenderneutralAlternatives ,
                                        :LogLikeDocumentRemoval ,
                                        :ReSamplingProtectedGroup ,
                                        :ReplaceStereotypes ;
          resource:SIO_000068 :EU_AI_Act ;
          rdfs:comment "Training, validation and testing data must be relevant, representative, free of errors and complete, with appropriate statistical properties, including where applicable in relation to the persons or groups for whom the system is intended. Notes: Central data-governance requirement on distribution and representativeness for fairness." .


###  http://fairness_ontology.com/Art.10.4
:Art.10.4 rdf:type owl:NamedIndividual ,
                   :LegalRequirement ,
                   :TechnicalLegalRequirement ;
          :isOperationalizedBy :Calibration ,
                               :ConditionalStatisticalParity ,
                               :CounterfactualFairness ,
                               :DemographicParity ,
                               :MatchingConditionalFrequencies ,
                               :StatisticalParity ,
                               :TestFairness ;
          :itsComplianceIsSupportedWith :AugmentedAntidoteData ,
                                        :CDA ,
                                        :CalibratedReRanking ,
                                        :ListReAdjustment ,
                                        :ReSamplingProtectedGroup ,
                                        :UserItemReRanking ;
          resource:SIO_000068 :EU_AI_Act ;
          rdfs:comment "Datasets shall, to the best extent possible, take into account the specific geographical, behavioural and functional context in which the AI system is intended to be used, so that performance and fairness generalise to the deployment environment. Notes: Addresses fairness risks due to domain shift between training data and the real-world context of use." .


###  http://fairness_ontology.com/Art.10.5
:Art.10.5 rdf:type owl:NamedIndividual ,
                   :LegalRequirement ,
                   :ManagementLegalRequirement ,
                   :TechnicalLegalRequirement ;
          :isOperationalizedBy :Calibration ,
                               :ConditionalStatisticalParity ,
                               :CounterfactualFairness ,
                               :DemographicParity ,
                               :EqualOpportunity ,
                               :EqualizedOdds ,
                               :ErrorRateBalance ,
                               :FalseNegativeErrorRateBalance ,
                               :FalsePositiveErrorRateBalance ,
                               :MatchingConditionalFrequencies ,
                               :PredictiveEquality ,
                               :StatisticalParity ,
                               :TestFairness ;
          :itsComplianceIsSupportedWith :AdversarialFDP ,
                                        :AugmentedAntidoteData ,
                                        :CDA ,
                                        :PerceptronForUnawareness ,
                                        :ReSamplingProtectedGroup ,
                                        :RegularizationOnANOVA ,
                                        :RegularizationOnValueFairness ;
          resource:SIO_000068 :EU_AI_Act ;
          rdfs:comment "Allows, under strict conditions, the processing of special categories of personal data for the purposes of detecting, preventing or mitigating bias in AI systems, subject to Union data-protection law. Notes: Enables fairness-aware use of sensitive attributes while maintaining data-protection safeguards." .


###  http://fairness_ontology.com/Art.11
:Art.11 rdf:type owl:NamedIndividual ,
                 :LegalRequirement ,
                 :ManagementLegalRequirement ;
        :isOperationalizedBy :Calibration ,
                             :ConditionalStatisticalParity ,
                             :CounterfactualFairness ,
                             :DemographicParity ,
                             :EqualOpportunity ,
                             :EqualizedOdds ,
                             :ErrorRateBalance ,
                             :FairnessThroughAwareness ,
                             :FalseNegativeErrorRateBalance ,
                             :FalsePositiveErrorRateBalance ,
                             :IndividualFairness ,
                             :MatchingConditionalFrequencies ,
                             :PredictiveEquality ,
                             :StatisticalParity ,
                             :TestFairness ;
        :itsComplianceIsSupportedWith :AddNonToxicExamples ,
                                      :AdversarialFDP ,
                                      :AugmentedAntidoteData ,
                                      :BlocklistDocumentRemoval ,
                                      :CDA ,
                                      :CalibratedReRanking ,
                                      :ControlOffensiveTokens ,
                                      :ListReAdjustment ,
                                      :LogLikeDocumentRemoval ,
                                      :PerceptronForUnawareness ,
                                      :REALTOXICITYPROMPTS ,
                                      :ReSamplingProtectedGroup ,
                                      :RegularizationOnANOVA ,
                                      :RegularizationOnValueFairness ,
                                      :UserItemReRanking ;
        resource:SIO_000068 :EU_AI_Act ;
        rdfs:comment "Obliges providers to draw up technical documentation demonstrating compliance with the requirements, including design choices, data sources, model properties, performance and limitations relevant to fairness and non-discrimination. Notes: Traceability layer: binds legal compliance claims to explicit notions, indicators, and documented controls; requires before/after evidence and clear limitations for authority review and conformity assessment." .


###  http://fairness_ontology.com/Art.112.10
:Art.112.10 rdf:type owl:NamedIndividual ,
                     :LegalRequirement ,
                     :ManagementLegalRequirement ;
            :isOperationalizedBy :Calibration ,
                                 :DemographicParity ,
                                 :EqualOpportunity ,
                                 :EqualizedOdds ,
                                 :MatchingConditionalFrequencies ,
                                 :StatisticalParity ,
                                 :TestFairness ;
            resource:SIO_000068 :EU_AI_Act ;
            rdfs:comment "Requires the Commission to evaluate and review the implementation of the Regulation and, where appropriate, propose amendments, taking into account technological developments and the effects of AI systems on health, safety and fundamental rights, including equality and non-discrimination. Notes: This is a governance/evaluation obligation: notions/metrics are mapped as evaluation indicators aggregated across systems (not as system-level compliance targets)." .


###  http://fairness_ontology.com/Art.12
:Art.12 rdf:type owl:NamedIndividual ,
                 :LegalRequirement ,
                 :TechnicalLegalRequirement ;
        :isOperationalizedBy :Calibration ,
                             :ConditionalStatisticalParity ,
                             :CounterfactualFairness ,
                             :DemographicParity ,
                             :EqualOpportunity ,
                             :EqualizedOdds ,
                             :ErrorRateBalance ,
                             :FairnessThroughAwareness ,
                             :FalseNegativeErrorRateBalance ,
                             :FalsePositiveErrorRateBalance ,
                             :IndividualFairness ,
                             :MatchingConditionalFrequencies ,
                             :PredictiveEquality ,
                             :StatisticalParity ,
                             :TestFairness ;
        :itsComplianceIsSupportedWith :AddNonToxicExamples ,
                                      :AdversarialFDP ,
                                      :AugmentedAntidoteData ,
                                      :BlocklistDocumentRemoval ,
                                      :CDA ,
                                      :CalibratedReRanking ,
                                      :ControlOffensiveTokens ,
                                      :ListReAdjustment ,
                                      :LogLikeDocumentRemoval ,
                                      :PerceptronForUnawareness ,
                                      :REALTOXICITYPROMPTS ,
                                      :ReSamplingProtectedGroup ,
                                      :RegularizationOnANOVA ,
                                      :RegularizationOnValueFairness ,
                                      :UserItemReRanking ;
        resource:SIO_000068 :EU_AI_Act ;
        rdfs:comment "Requires that high-risk AI systems are designed with automatic logging capabilities to record events relevant for performance monitoring and compliance, including behaviour affecting fundamental rights. Notes: Observability layer: logs enable reproducible fairness monitoring and drift detection across versions/contexts; deviations trigger escalation and activation of corrective controls, whose effectiveness is evidenced via improvements in the same logged metrics." .


###  http://fairness_ontology.com/Art.13
:Art.13 rdf:type owl:NamedIndividual ,
                 :LegalRequirement ,
                 :ManagementLegalRequirement ;
        :isOperationalizedBy :Calibration ,
                             :ConditionalStatisticalParity ,
                             :CounterfactualFairness ,
                             :DemographicParity ,
                             :EqualOpportunity ,
                             :EqualizedOdds ,
                             :ErrorRateBalance ,
                             :FalseNegativeErrorRateBalance ,
                             :FalsePositiveErrorRateBalance ,
                             :MatchingConditionalFrequencies ,
                             :PredictiveEquality ,
                             :StatisticalParity ,
                             :TestFairness ;
        :itsComplianceIsSupportedWith :AddNonToxicExamples ,
                                      :AdversarialFDP ,
                                      :AugmentedAntidoteData ,
                                      :BlocklistDocumentRemoval ,
                                      :CDA ,
                                      :CalibratedReRanking ,
                                      :ControlOffensiveTokens ,
                                      :ListReAdjustment ,
                                      :LogLikeDocumentRemoval ,
                                      :PerceptronForUnawareness ,
                                      :REALTOXICITYPROMPTS ,
                                      :ReSamplingProtectedGroup ,
                                      :RegularizationOnANOVA ,
                                      :RegularizationOnValueFairness ,
                                      :UserItemReRanking ;
        resource:SIO_000068 :EU_AI_Act ;
        rdfs:comment "Requires providers to ensure that high-risk AI systems are accompanied by clear instructions for use and information about performance, assumptions, limitations and foreseeable risks to fundamental rights. Notes: Operational transparency layer: communicate applicable fairness notions, the metrics used to evidence them (incl. parity, error gaps, counterfactual instability, calibration/divergence), evaluation conditions and limits; document active safeguards and the operational response when monitoring signals degrade." .


###  http://fairness_ontology.com/Art.14
:Art.14 rdf:type owl:NamedIndividual ,
                 :LegalRequirement ,
                 :ManagementLegalRequirement ;
        :isOperationalizedBy :Calibration ,
                             :ConditionalStatisticalParity ,
                             :CounterfactualFairness ,
                             :DemographicParity ,
                             :EqualOpportunity ,
                             :EqualizedOdds ,
                             :ErrorRateBalance ,
                             :FairnessThroughAwareness ,
                             :FalseNegativeErrorRateBalance ,
                             :FalsePositiveErrorRateBalance ,
                             :IndividualFairness ,
                             :MatchingConditionalFrequencies ,
                             :PredictiveEquality ,
                             :StatisticalParity ,
                             :TestFairness ;
        :itsComplianceIsSupportedWith :AddNonToxicExamples ,
                                      :AdversarialFDP ,
                                      :AugmentedAntidoteData ,
                                      :BlocklistDocumentRemoval ,
                                      :CDA ,
                                      :CalibratedReRanking ,
                                      :ControlOffensiveTokens ,
                                      :ListReAdjustment ,
                                      :LogLikeDocumentRemoval ,
                                      :PerceptronForUnawareness ,
                                      :REALTOXICITYPROMPTS ,
                                      :ReSamplingProtectedGroup ,
                                      :RegularizationOnANOVA ,
                                      :RegularizationOnValueFairness ,
                                      :UserItemReRanking ;
        resource:SIO_000068 :EU_AI_Act ;
        rdfs:comment "Requires that high-risk AI systems be designed and developed with effective human oversight, enabling human operators to understand, monitor and intervene to prevent or minimise harm, including discriminatory outcomes. Notes: Art. 14 binds fairness monitoring to human interventions: define operator-facing fairness signals, thresholds and escalation; enable override/adjustment actions and corrective controls; evidence effectiveness through improvements in the same monitored metrics." .


###  http://fairness_ontology.com/Art.15
:Art.15 rdf:type owl:NamedIndividual ,
                 :LegalRequirement ,
                 :TechnicalLegalRequirement ;
        :isOperationalizedBy :Calibration ,
                             :ConditionalStatisticalParity ,
                             :CounterfactualFairness ,
                             :DemographicParity ,
                             :EqualOpportunity ,
                             :EqualizedOdds ,
                             :ErrorRateBalance ,
                             :FairnessThroughAwareness ,
                             :FalseNegativeErrorRateBalance ,
                             :FalsePositiveErrorRateBalance ,
                             :IndividualFairness ,
                             :MatchingConditionalFrequencies ,
                             :PredictiveEquality ,
                             :StatisticalParity ,
                             :TestFairness ;
        :itsComplianceIsSupportedWith :AddNonToxicExamples ,
                                      :AdvBERT ,
                                      :AdvPredictedScore ,
                                      :AugmentedAntidoteData ,
                                      :BlocklistDocumentRemoval ,
                                      :CDA ,
                                      :CalibratedReRanking ,
                                      :ChangeAttentionScores ,
                                      :ChangeAttentionWeights ,
                                      :ControlOffensiveTokens ,
                                      :DropoutOnAttention ,
                                      :InferenceSubnetworks ,
                                      :ListReAdjustment ,
                                      :LogLikeDocumentRemoval ,
                                      :OSCAR ,
                                      :REALTOXICITYPROMPTS ,
                                      :ReSamplingProtectedGroup ,
                                      :RegularizationOnANOVA ,
                                      :RegularizationOnValueFairness ,
                                      :UserItemReRanking ;
        resource:SIO_000068 :EU_AI_Act ;
        rdfs:comment "Requires high-risk AI systems to achieve appropriate levels of accuracy, robustness and cybersecurity, and to maintain these properties throughout the lifecycle. Notes: Art. 15 is mapped to robustness and cybersecurity monitoring where degradations can create group-conditional harms. Fairness indicators are used as robustness evidence (error gaps, calibration/divergence drift, local consistency); mitigations are technical controls activated to restore dependability and evidenced via improvements in the same metrics." .


###  http://fairness_ontology.com/Art.16
:Art.16 rdf:type owl:NamedIndividual ,
                 :LegalRequirement ,
                 :ManagementLegalRequirement ;
        :isOperationalizedBy :Calibration ,
                             :ConditionalStatisticalParity ,
                             :CounterfactualFairness ,
                             :DemographicParity ,
                             :EqualOpportunity ,
                             :EqualizedOdds ,
                             :ErrorRateBalance ,
                             :FairnessThroughAwareness ,
                             :FalseNegativeErrorRateBalance ,
                             :FalsePositiveErrorRateBalance ,
                             :IndividualFairness ,
                             :MatchingConditionalFrequencies ,
                             :PredictiveEquality ,
                             :StatisticalParity ,
                             :TestFairness ;
        :itsComplianceIsSupportedWith :AddNonToxicExamples ,
                                      :AdversarialFDP ,
                                      :AugmentedAntidoteData ,
                                      :BlocklistDocumentRemoval ,
                                      :CDA ,
                                      :CalibratedReRanking ,
                                      :ControlOffensiveTokens ,
                                      :ListReAdjustment ,
                                      :LogLikeDocumentRemoval ,
                                      :PerceptronForUnawareness ,
                                      :REALTOXICITYPROMPTS ,
                                      :ReSamplingProtectedGroup ,
                                      :RegularizationOnANOVA ,
                                      :RegularizationOnValueFairness ,
                                      :UserItemReRanking ;
        resource:SIO_000068 :EU_AI_Act ;
        rdfs:comment "Sets out the obligations of providers of high-risk AI systems, including designing and developing systems in accordance with the requirements and implementing risk management, data governance and monitoring procedures. Notes: Art. 16 is an umbrella provider-duty clause. Mapped notions/metrics form a provider-level evidence portfolio; mapped techniques form the provider control catalogue applied across the lifecycle with documented thresholds, escalation and change management." .


###  http://fairness_ontology.com/Art.17
:Art.17 rdf:type owl:NamedIndividual ,
                 :LegalRequirement ,
                 :ManagementLegalRequirement ;
        :isOperationalizedBy :Calibration ,
                             :ConditionalStatisticalParity ,
                             :CounterfactualFairness ,
                             :DemographicParity ,
                             :EqualOpportunity ,
                             :EqualizedOdds ,
                             :ErrorRateBalance ,
                             :FairnessThroughAwareness ,
                             :FalseNegativeErrorRateBalance ,
                             :FalsePositiveErrorRateBalance ,
                             :IndividualFairness ,
                             :MatchingConditionalFrequencies ,
                             :PredictiveEquality ,
                             :StatisticalParity ,
                             :TestFairness ;
        :itsComplianceIsSupportedWith :AdversarialFDP ,
                                      :AugmentedAntidoteData ,
                                      :CDA ,
                                      :CalibratedReRanking ,
                                      :FairPSL ,
                                      :ListReAdjustment ,
                                      :PerceptronForUnawareness ,
                                      :ReSamplingProtectedGroup ,
                                      :RegularizationOnANOVA ,
                                      :RegularizationOnValueFairness ,
                                      :UserItemReRanking ;
        resource:SIO_000068 :EU_AI_Act ;
        rdfs:comment "Requires providers to establish and maintain a quality management system covering design, development, testing, validation, data management and monitoring processes for high-risk AI systems. Notes: Art. 17 operationalises compliance via a QMS: define measurable fairness acceptance criteria (release/regression gates), govern approved mitigation methods, document evidence and limitations, and ensure monitoring plus corrective actions are consistently applied across the lifecycle." .


###  http://fairness_ontology.com/Art.2
:Art.2 rdf:type owl:NamedIndividual ,
                :LegalRequirement ,
                :ManagementLegalRequirement ;
       :isOperationalizedBy :Calibration ,
                            :CounterfactualFairness ,
                            :DemographicParity ,
                            :EqualOpportunity ,
                            :EqualizedOdds ,
                            :MatchingConditionalFrequencies ,
                            :StatisticalParity ,
                            :TestFairness ;
       resource:SIO_000068 :EU_AI_Act ;
       rdfs:comment "Defines the subject matter and scope of the Regulation, specifying which AI systems and providers fall under the uniform requirements, including those on fundamental-rights protection and non-discrimination. Notes: Art. 2 is a scope rule: notions/metrics are mapped as applicability anchors (taxonomy for the types of discrimination evidence referenced by downstream obligations), not as performance thresholds required by Art. 2 itself." .


###  http://fairness_ontology.com/Art.20
:Art.20 rdf:type owl:NamedIndividual ,
                 :LegalRequirement ,
                 :ManagementLegalRequirement ;
        :isOperationalizedBy :Calibration ,
                             :CounterfactualFairness ,
                             :DemographicParity ,
                             :EqualOpportunity ,
                             :EqualizedOdds ,
                             :FairnessThroughAwareness ,
                             :IndividualFairness ,
                             :MatchingConditionalFrequencies ,
                             :StatisticalParity ,
                             :TestFairness ;
        :itsComplianceIsSupportedWith :AdversarialFDP ,
                                      :AugmentedAntidoteData ,
                                      :CDA ,
                                      :CalibratedReRanking ,
                                      :ListReAdjustment ,
                                      :PerceptronForUnawareness ,
                                      :ReSamplingProtectedGroup ,
                                      :RegularizationOnANOVA ,
                                      :RegularizationOnValueFairness ,
                                      :UserItemReRanking ;
        resource:SIO_000068 :EU_AI_Act ;
        rdfs:comment "Corrective actions and duty of information: when a high-risk AI system is non-compliant or presents a risk, the provider must take corrective actions without undue delay (bring into conformity, withdraw/recall, or disable as appropriate) and promptly inform relevant economic operators and competent actors, providing details of the non-compliance/risk and actions taken. Notes: Art. 20 is a remediation and information-duty clause: fairness notions/metrics serve as operational triggers and regression evidence; mapped techniques are corrective controls applied via change management (update/rollback/withdrawal/disable) with before/after metric verification and notification duties." .


###  http://fairness_ontology.com/Art.21
:Art.21 rdf:type owl:NamedIndividual ,
                 :LegalRequirement ,
                 :ManagementLegalRequirement ;
        :isOperationalizedBy :Calibration ,
                             :CounterfactualFairness ,
                             :DemographicParity ,
                             :EqualOpportunity ,
                             :EqualizedOdds ,
                             :MatchingConditionalFrequencies ,
                             :StatisticalParity ,
                             :TestFairness ;
        resource:SIO_000068 :EU_AI_Act ;
        rdfs:comment "Requires providers of high-risk AI systems to cooperate with competent authorities and, upon reasoned request, provide necessary information and documentation to demonstrate compliance; where applicable, provide access to automatically generated logs under their control. Notes: Assurance obligation: notions/metrics define the “compliance evidence package” that must be producible, versioned, and interpretable by authorities, including monitoring outputs and (where relevant) log-based evidence." .


###  http://fairness_ontology.com/Art.23
:Art.23 rdf:type owl:NamedIndividual ,
                 :LegalRequirement ,
                 :ManagementLegalRequirement ;
        :isOperationalizedBy :Calibration ,
                             :CounterfactualFairness ,
                             :DemographicParity ,
                             :EqualOpportunity ,
                             :EqualizedOdds ,
                             :MatchingConditionalFrequencies ,
                             :StatisticalParity ,
                             :TestFairness ;
        :itsComplianceIsSupportedWith :AdversarialFDP ,
                                      :AugmentedAntidoteData ,
                                      :CDA ,
                                      :CalibratedReRanking ,
                                      :ListReAdjustment ,
                                      :PerceptronForUnawareness ,
                                      :ReSamplingProtectedGroup ,
                                      :RegularizationOnANOVA ,
                                      :RegularizationOnValueFairness ,
                                      :UserItemReRanking ;
        resource:SIO_000068 :EU_AI_Act ;
        rdfs:comment "Sets obligations for importers of high-risk AI systems to verify conformity (incl. required compliance artefacts and instructions), refrain from market placement when non-compliant, ensure storage/transport do not compromise compliance, and cooperate with competent authorities including corrective actions where needed. Notes: Art. 23 acts as a supply-chain compliance gate: notions/metrics define what must be checkable and transferable; mitigation techniques are mapped as documented controls whose configuration and effectiveness evidence must remain aligned with the marketed version and intended context." .


###  http://fairness_ontology.com/Art.24
:Art.24 rdf:type owl:NamedIndividual ,
                 :LegalRequirement ,
