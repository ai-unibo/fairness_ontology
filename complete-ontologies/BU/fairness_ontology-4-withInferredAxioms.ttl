                            :FalseNegativeErrorRateBalance ,
                            :FalsePositiveErrorRateBalance ,
                            :IndividualFairness ,
                            :MatchingConditionalFrequencies ,
                            :PredictiveEquality ,
                            :StatisticalParity ,
                            :TestFairness ,
                            :TotalFairness ,
                            :TreatmentEquality ;
       resource:SIO_000068 :EU_AI_Act ;
       rdfs:comment "Prohibits certain AI practices, such as exploiting vulnerabilities of specific groups, social scoring, and some forms of predictive policing, which are considered incompatible with fundamental rights and equality. Notes: Directly excludes particularly harmful and discriminatory uses of AI systems." .


###  http://fairness_ontology.com/Art.50
:Art.50 rdf:type owl:NamedIndividual ,
                 :LegalRequirement ,
                 :ManagementLegalRequirement ;
        :isOperationalizedBy :Calibration ,
                             :CounterfactualFairness ,
