:AlgorithmicBias a owl:Class ;
    rdfs:label "algorithmic bias"@en ;
    dc:source "https://doi.org/10.1145/3457607"^^xsd:anyURI ;
    rdfs:subClassOf fmo:bias ;
    skos:definition "Algorithmic bias is when the bias is not present in the input data and is added purely by the algorithm."@en .

:ArchitectureModification a owl:Class ;
    rdfs:label "Architecture Modification"@en ;
    rdfs:subClassOf :InprocessingMitigation .

:CausalFairnessNotion a owl:Class ;
    rdfs:label "causal fairness notion"@en ;
    resource:hasSynonym "causal fairness"@en ;
    rdfs:subClassOf :OutcomeFairnessNotion ;
    owl:disjointWith :ObservationalFairnessNotion ;
    skos:definition "A family of fairness notions focusing on the causal relations between variables."@en .

:ConditionalStatisticalParity a :IndependenceFairnessNotion,
        :ObservationalFairnessNotion,
        owl:NamedIndividual ;
    :hasBeenAppliedTo :CensusIncomePrediction,
        :CreditRisk,
        :Health,
        :Law ;
    :isProposedBy :2017_CORBETTDAVIES ;
    :isSuitableFor :ChatbotInteraction,
        :Classification ;
    :notionDefinition "Demographic parity conditioned on a set of “legitimate factors” L. For example, among defendants who have the same number of prior convictions, ensure that  black and white defendants are detained at equal rates." .

:ConfusionMatrixBasedFairnessMetric a owl:Class ;
    rdfs:label "confusion matrix-based fairness metric"@en ;
    rdfs:subClassOf fmo:fairness_metric ;
    skos:definition "A measurement of any fairness notion, focusing on the amount of correct/incorrect classifications inferred by the predictor."@en .

:CounterfactualFairness a :CausalFairnessNotion,
        :IndividualFairnessNotion,
        owl:NamedIndividual ;
    :hasBeenAppliedTo :Education ;
    :isProposedBy :2017_KUSNER ;
    :isSuitableFor :ChatbotInteraction,
        :Classification ;
    :notionDefinition "a decision is fair towards an individual (or a group) if it is the same in both the actual world and a counterfactual world where the individual belonged to a different demographic group. Essentially, the definition ensures that changing an individual’s sensitive variable, while holding constant all other variables that are not causally dependent on the sensitive variable , does not change the prediction (distribution)." .

:DemographicParity a :IndependenceFairnessNotion,
        :ObservationalFairnessNotion,
        owl:NamedIndividual ;
    owl:sameAs :StatisticalParity .

:ErrorRateBalance a :ObservationalFairnessNotion,
        :SeparationFairnessNotion,
        owl:NamedIndividual ;
    :hasBeenAppliedTo :Finance,
        :Health,
        :Law ;
    :isEquivalentTo :ConditionalProcedureAccuracyEquality ;
    :isProposedBy :2017_CHOULDECHOVA ;
    :isSuitableFor :ChatbotInteraction,
        :Classification ;
    :notionDefinition "equal false negative and false positive rates" .

:FalseNegativeErrorRateBalance a :ObservationalFairnessNotion,
        :SeparationFairnessNotion,
        owl:NamedIndividual ;
    :hasBeenAppliedTo :Finance,
        :Health,
        :Law ;
    :isEquivalentTo :EqualOpportunity ;
    :isProposedBy :2017_CHOULDECHOVA ;
    :isSuitableFor :ChatbotInteraction,
        :Classification ;
    :notionDefinition "Protected and unprotected groups should have equal false negative rates." .

:HistoricalBias a owl:Class ;
    rdfs:label "historical bias"@en ;
    dc:source "https://doi.org/10.1145/3457607"^^xsd:anyURI ;
    rdfs:subClassOf fmo:bias ;
    skos:definition "Historical bias is caused by already existing bias and socio-technical issues in the world, and can seep into from the data generation process even given a perfect sampling and feature selection."@en .

:IndividualFairness a :IndividualFairnessNotion,
        :ObservationalFairnessNotion,
        owl:NamedIndividual ;
    rdfs:label "Individual Fairness" ;
    owl:sameAs :FairnessThroughAwareness .

:LinguisticBias a owl:Class ;
    rdfs:label "linguistic bias"@en ;
    rdfs:subClassOf :AlgorithmicBias ;
    skos:definition "Linguistic bias is embedded in generative AI outputs, the manifestation of harm through demeaning or offensive language that reinforces discrimination."@en .

:ModelEvaluation a owl:Class ;
    rdfs:label "Model Evaluation"@en ;
    rdfs:subClassOf ns1:In-processing .

:Projection-basedMitigation a owl:Class ;
    rdfs:label "Projection-based Mitigation" ;
    rdfs:subClassOf :PreprocessingMitigation .

:Resampling a owl:Class ;
    rdfs:label "Resampling"@en ;
    rdfs:subClassOf :PreprocessingMitigation .

:ScoreBasedFairnessMetric a owl:Class ;
    rdfs:label "score-based fairness metric"@en ;
    rdfs:subClassOf fmo:fairness_metric ;
    skos:definition "A measurement of any fairness notion, directing attention to the value of the classification score."@en .

:TotalFairness a :IndependenceFairnessNotion,
        :ObservationalFairnessNotion,
        :SeparationFairnessNotion,
        :SufficiencyFairnessNotion,
        owl:NamedIndividual ;
    :hasBeenAppliedTo :Law ;
    :isProposedBy :2018_BERK ;
    :isSuitableFor :ChatbotInteraction,
        :Classification ;
    :notionDefinition "Achived when: overall accuracy equality, statistical parity, equalized odds (conditional procedure accuracy equality), conditional use accuracy equality, treatment equality are all achieved" .

:TrainingDataset a owl:Class ;
    rdfs:label "Training Dataset"@en ;
    rdfs:subClassOf :Dataset .

:TreatmentEquality a :ObservationalFairnessNotion,
        :SeparationFairnessNotion,
        owl:NamedIndividual ;
    :hasBeenAppliedTo :Finance,
        :Health,
        :Law ;
    :isProposedBy :2018_BERK ;
    :isSuitableFor :ChatbotInteraction,
        :Classification ;
    :notionDefinition "It is achieved when the ratio of false negatives and false positives  is the same for both protected group categories. If the two ratios are significantly different, then you have that for group a(say, men) it is more probable to be incorrectly classified as a negative, then for group b (say, women)" .

