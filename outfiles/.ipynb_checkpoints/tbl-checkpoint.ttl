:ConditionalProcedureAccuracyEquality a :ObservationalFairnessNotion,
        :SeparationFairnessNotion,
        owl:NamedIndividual ;
    :hasBeenAppliedTo :Finance,
        :Health,
        :Law ;
    :isEquivalentTo :EqualizedOdds ;
    :isProposedBy :2018_BERK,
        :2018_VANMASSENHOVE ;
    :isSuitableFor :ChatbotInteraction,
