ns1:ADELE a :ArchitectureModification,
        owl:NamedIndividual ;
    rdfs:label "ADELE" ;
    :isProposedBy :2021_LAUSCHER ;
    rdfs:comment "Introduce debiasing adapter modules, called ADELE, to mitigate gender bias." .

ns1:AddNonToxicExamples a :DataAugmentation,
        owl:NamedIndividual ;
    rdfs:label "AddNonToxicExamples" ;
    :isProposedBy :2018_DIXON ;
    rdfs:comment "Add non-toxic examples for groups disproportionately represented with toxicity." .

ns1:AdvBERT a :AdversarialLearning,
        owl:NamedIndividual ;
    rdfs:label "AdvBERT" ;
    :isProposedBy :2021_REKABSAZ ;
    rdfs:comment "Adversarial learning with a ranking of information retrieval results to reduce bias while maintaining relevance." .

ns1:AdvPredictedScore a :AdversarialLearning,
        owl:NamedIndividual ;
    rdfs:label "AdvPredictedScore" ;
    :isProposedBy :2020_ZHU ;
    rdfs:comment "Learn fair predicted scores by enhancing score distribution similarity" .

ns1:AdversarialFDP a :AdversarialLearning,
        owl:NamedIndividual ;
    rdfs:label "AdversarialFDP" ;
    :isProposedBy :2019_CELISa ;
    rdfs:comment "Adversarial training using False Discovery Rate parity." .

ns1:Analytics_Approach a owl:Class ;
    rdfs:label "Analytics Approach" ;
    rdfs:subClassOf ns1:Pre-processing .

ns1:Art5 a ns1:Legal_Requirement,
        owl:NamedIndividual ;
    :its_compliance_is_supported_by ns1:Re-SamplingProtectedGroup ;
    ns1:is_operationalized_by :Calibration,
        :ConditionalStatisticalParity,
        :CounterfactualFairness,
        :EqualOpportunity,
        :EqualizedOdds,
        :ErrorRateBalance,
        :FairnessThroughAwareness,
        :FalseNegativeErrorRateBalance,
        :FalsePositiveErrorRateBalance,
        :PredictiveEquality,
        :StatisticalParity,
        :TestFairness,
        :TotalFairness,
        :TreatmentEquality ;
    resource:SIO_000068 ns1:EU_AI_Act ;
    rdfs:comment "Prohibits certain AI practices, such as exploiting vulnerabilities of specific groups, social scoring, and some forms of predictive policing, which are considered incompatible with fundamental rights and equality" .

ns1:AugmentedAntidoteData a :DataAugmentation,
        owl:NamedIndividual ;
    rdfs:label "AugmentedAntidoteData" ;
    :isProposedBy :2019_RASTEGARPANAH ;
    rdfs:comment "Add antidote data to the training data" .

ns1:BlocklistDocumentRemoval a :DataFiltering,
        owl:NamedIndividual ;
    rdfs:label "BlocklistDocumentRemoval" ;
    :isProposedBy :2020_RAFFEL ;
    rdfs:comment "Removal of biased instances, such as derogatory language: coarse word-level technique, removing all documents containing any words on a blocklist." .

ns1:Business_Requirements a owl:Class ;
    rdfs:label "Business Requirements" ;
    rdfs:subClassOf ns1:Pre-processing .

ns1:CDA a :DataAugmentation,
        owl:NamedIndividual ;
    rdfs:label "CDA" ;
    :isProposedBy :2020_LU ;
    rdfs:comment "Use CDA to mitigate occupation-gender bias, creating matched pairs." .

ns1:CDS a :SelectiveReplacement,
        owl:NamedIndividual ;
    rdfs:label "CDS" ;
    :isProposedBy :2019_MAUDSLAY ;
    rdfs:comment "Randomly substitute gendered text with counterfactuals." .

ns1:CalibratedRe-ranking a :Reranking,
        owl:NamedIndividual ;
    rdfs:label "CalibratedRe-ranking" ;
    :isProposedBy :2018_STECK ;
    rdfs:comment "Calibrated recommendation through maximal marginal relevance" .

ns1:ChangeAttentionScores a :LossFunctionModification,
        owl:NamedIndividual ;
    rdfs:label "ChangeAttentionScores" ;
    :isProposedBy :2022_GACI ;
    rdfs:comment "Redistribute attention scores to address learned stereotypes." .

ns1:ChangeAttentionWeights a :WeightRedistribution,
        owl:NamedIndividual ;
    rdfs:label "ChangeAttentionWeights" ;
    :isProposedBy :2023_ZAYED ;
    rdfs:comment "Apply temperature scaling to attention weights post-training." .

ns1:ControlOffensiveTokens a :DecodingStrategyModification,
        owl:NamedIndividual ;
    rdfs:label "ControlOffensiveTokens" ;
    :isProposedBy :2020_XU ;
    rdfs:comment "Use control tokens to prevent offensive output." .

ns1:Data_Collection a owl:Class ;
    rdfs:label "Data Collection" ;
    rdfs:subClassOf ns1:Pre-processing .

ns1:Data_Preparation a owl:Class ;
    rdfs:label "Data Preparation" ;
    rdfs:subClassOf ns1:Pre-processing .

ns1:Data_Requirements a owl:Class ;
    rdfs:label "Data Requirements" ;
    rdfs:subClassOf ns1:Pre-processing .

ns1:DropoutOnAttention a :LossFunctionModification,
        owl:NamedIndividual ;
    rdfs:label "DropoutOnAttention" ;
    :isProposedBy :2020_WEBSTER ;
    rdfs:comment "Use dropout during pre-training to reduce stereotypical gendered associations." .

ns1:Exploratory_Data_Analysis a owl:Class ;
    rdfs:label "Exploratory Data Analysis" ;
    rdfs:subClassOf ns1:Pre-processing .

ns1:FairPSL a :Regularization,
        owl:NamedIndividual ;
    rdfs:label "FairPSL" ;
    :isProposedBy :2018_FARNADI ;
    rdfs:comment "FairPSL extends an existing statistical relational learning framework, probabilistic soft logic (PSL). FairPSL incorporates logical definitions of fairnesss supporting a probabilistic interpretation." .

ns1:Gender-neutralAlternatives a :Rewriting,
        owl:NamedIndividual ;
    rdfs:label "Gender-neutralAlternatives" ;
    :isProposedBy :2021_JAIN ;
    rdfs:comment "Generate gender-neutral sentence alternatives." .

ns1:InferenceSubnetworks a :ModularDebiasingNetwork,
        owl:NamedIndividual ;
    rdfs:label "InferenceSubnetworks" ;
    :isProposedBy :2023_HAUZENBERG ;
    rdfs:comment "Apply trained subnetworks modularly at inference time." .

<http://fairness_ontology/IsValidatedOn#is_validated_on> a owl:ObjectProperty ;
    rdfs:label "is validated on" ;
    rdfs:domain :AIModel ;
    rdfs:range :ValidationDataset .

ns1:ListRe-adjustment a :Reranking,
        owl:NamedIndividual ;
    rdfs:label "ListRe-adjustment" ;
    :isProposedBy :2021_MANSOURY ;
    rdfs:comment "Re-ranking method based on maximum flow: iteratively adds high-quality items that have low visibility or items from suppliers with low exposure to the users’ final recommendation lists." .

ns1:LogLikeDocumentRemoval a :DataFiltering,
        owl:NamedIndividual ;
    rdfs:label "LogLikeDocumentRemoval" ;
    :isProposedBy :2021_NGO ;
    rdfs:comment "Append to each document a phrase representative of an undesirable harm, such as racism or hate speech, and then use a pre-trained model to compute the conditional log-likelihood of the modified documents." .

ns1:Model_Deployment a owl:Class ;
    rdfs:label "Model Deployment" ;
    rdfs:subClassOf ns1:Post-processing .

ns1:Model_Selection a owl:Class ;
    rdfs:label "Model Selection" ;
    rdfs:subClassOf ns1:In-processing .

ns1:Model_Tuning a owl:Class ;
    rdfs:label "Model Tuning" ;
    rdfs:subClassOf ns1:Post-processing .

ns1:NamesIntervention a :SelectiveReplacement,
        owl:NamedIndividual ;
    rdfs:label "NamesIntervention" ;
    :isProposedBy :2019_MAUDSLAY ;
    rdfs:comment "Swap masculine and feminine first names during CDA." .

ns1:OSCAR a :Projection-basedMitigation,
        owl:NamedIndividual ;
    rdfs:label "OSCAR" ;
    :isProposedBy :2021_DEV ;
    rdfs:comment "Bias removal while maintaining relevant semantic information: orthogonalize two directions that should be independent." .

ns1:PerceptronForUnawareness a :ModularDebiasingNetwork,
        owl:NamedIndividual ;
    rdfs:label "PerceptronForUnawareness" ;
    :isProposedBy :2023_KUMAR ;
    rdfs:comment "Adapter network removing protected attributes." .

ns1:PoliteAlternatives a :Rewriting,
        owl:NamedIndividual ;
    rdfs:label "PoliteAlternatives" ;
    :isProposedBy :2022_WANG ;
    rdfs:comment "Generate more polite sentence rewrites." .

ns1:PredictedReplacements a :Rewriting,
        owl:NamedIndividual ;
    rdfs:label "PredictedReplacements" ;
    :isProposedBy :2022_TOKPO ;
    rdfs:comment "Use LIME to identify biased tokens and predict replacements." .

ns1:Project_Review a owl:Class ;
    rdfs:label "Project Review" ;
    rdfs:subClassOf ns1:Governance .

ns1:REALTOXICITYPROMPTS a :DecodingStrategyModification,
        owl:NamedIndividual ;
    rdfs:label "REALTOXICITYPROMPTS" ;
    :isProposedBy :2020_GEHMAN ;
    rdfs:comment "Constrained decoding to reduce toxic generation." .

ns1:RecIndependence a :Regularization,
        owl:NamedIndividual ;
    rdfs:label "RecIndependence" ;
    :isProposedBy :2018_KAMISHIMA ;
    rdfs:comment "Use distribution matching and mutual information terms as regularization (to make recommendations independent of a specific attribute)" .

ns1:RegardClassifier a :Regularization,
        owl:NamedIndividual ;
    rdfs:label "RegardClassifier" ;
    :isProposedBy :2019_SHENG ;
    rdfs:comment "Classifier measuring regard toward social groups." .

ns1:RegularizationOnANOVA a :Regularization,
        owl:NamedIndividual ;
    rdfs:label "RegularizationOnANOVA" ;
    :isProposedBy :2020_WAN ;
    rdfs:comment "Use F-statistic of ANOVA in the the loss function as regularization term to calibrate the parity of prediction errors across different market segments." .

ns1:RegularizationOnEmbeddings a :Regularization,
        owl:NamedIndividual ;
    rdfs:label "RegularizationOnEmbeddings" ;
    :isProposedBy :2023_PARK ;
    rdfs:comment "introduce a regularization term that orthogonalizes stereotypical word embeddings and the gender direction in the embedding space." .

ns1:RegularizationOnValueFairness a :Regularization,
        owl:NamedIndividual ;
    rdfs:label "RegularizationOnValueFairness" ;
    :isProposedBy :2017_YAO ;
    rdfs:comment "Use fairness metrics (e.g., value fairness) as fair regularization" .

ns1:ReplaceStereotypes a :Rewriting,
        owl:NamedIndividual ;
    rdfs:label "ReplaceStereotypes" ;
    :isProposedBy :2023_DHINGRA ;
    rdfs:comment "Identify and replace stereotypical words using SHAP." .

ns1:UserItemRe-ranking a :Reranking,
        owl:NamedIndividual ;
    rdfs:label "UserItemRe-ranking" ;
    :isProposedBy :2020_PATRO ;
    rdfs:comment "Re-ranking for both user fairness and item fairness" .

ns1:is_operationalized_by a owl:ObjectProperty ;
    rdfs:label "is operationalized by" ;
    rdfs:domain ns1:Legal_Requirement ;
    rdfs:range fmo:fairness_notion ;
    owl:inverseOf ns1:operationalize .

