@prefix : <http://fairness_ontology.com/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix fmo: <https://purl.org/twc/fmo#> .
@prefix ns1: <http://fairness_ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix resource: <http://semanticscience.org/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

: a owl:Ontology .

:AILifecycleStep a owl:Class ;
    rdfs:label "AI Lifecycle Step" .

:AllUnmaskedLikelihood a :PseudoLogLikelihoodFairnessMetric,
        owl:NamedIndividual ;
    :isProposedBy :2022_KANEKO ;
    :isSuitableFor :ChatbotInteraction,
        :Classification ;
    :scientificArtifactDescription "Extends the CrowS-Pair Score and CAT to consider multiple correct candidate predictions. While pseudo-loglikelihood and CAT consider a single correct answer for a masked test example, AUL provides an unmasked sentence to the model and predicts all tokens in the sentence. The unmasked input provides the model with all information to predict a token, which can improve the prediction accuracy of the model, and avoids selection bias in the choice of which words to mask." .

:ArmortizedGranularityMetric a owl:Class ;
    rdfs:label "Armortized Granularity Metric"@en ;
    rdfs:subClassOf :GranularityMetric .

:BalanceForNegativeClass a :ObservationalFairnessNotion,
        :SeparationFairnessNotion,
        owl:NamedIndividual ;
    :hasBeenAppliedTo :Law ;
    :isProposedBy :2017_KLEINBERG ;
    :isSuitableFor :ChatbotInteraction,
        :Classification ;
    :isUsedBy :2019_DIMITRAKAKIS ;
    :scientificArtifactDescription "The expected predicted score for the negative class has to be equal for all groups. The average score received by people constituting negative instances should be the same in each group. This metric requires that the average score assigned to people of group a who belong to the negative class should be the same as the average score assigned to people of group b who belong to the negative class. In other words, the assignment of scores shouldn’t be systematically more inaccurate for negative instances in one group than the other." .

:BalanceForPositiveClass a :ObservationalFairnessNotion,
        :SeparationFairnessNotion,
        owl:NamedIndividual ;
    :hasBeenAppliedTo :Law ;
    :isProposedBy :2017_KLEINBERG ;
    :isSuitableFor :ChatbotInteraction,
        :Classification ;
    :isUsedBy :2019_DIMITRAKAKIS ;
    :notionDefinition "It requires that the average score assigned to people of group a who belong to the positive class should be the same as the average score assigned to people of group b who belong to the positive class." .

:BalancedConditionedConsistency a owl:NamedIndividual,
        fmo:fairness_metric ;
    :hasBeenAppliedTo :CensusIncomePrediction,
        :CreditRisk,
        :Law ;
    :isProposedBy :2025_WALLER ;
    :isSuitableFor :Classification ;
    :metricDefinition "It measures the proportion of acceptable decisions (i.e., above a threshold), but not how close to full agreement those decisions were. It allows each individual to contribute to the score with 1/|E| as long as their individual consistency score meets the threshold, regardless of how close to the threshold the score is (or how far from full agreement, i.e., 1, the score is). The balanced conditioned consistency score BCC allows us to capture this." .

:BayesianFairness a :ScoreBasedFairnessMetric,
        owl:NamedIndividual ;
    :hasBeenAppliedTo :Law ;
    :isProposedBy :2019_DIMITRAKAKIS ;
    :isSuitableFor :ChatbotInteraction,
        :Classification ;
    :metricDefinition "It considers the case that model parameters themselves are uncertain. The amount of uncertainty about the model parameters directly influences the interpretation of the balance condition. Informally, the more uncertain we are, the more stochastic the decision rule will need to be." .

:CEAT a :SentenceEmbeddingFairnessMetric,
        owl:NamedIndividual ;
    :isProposedBy :2021_GUO ;
    :isSuitableFor :ChatbotInteraction,
        :Classification .

:CalibrationBasedFairnessMetric a owl:Class ;
    rdfs:label "calibration-based fairness metric"@en ;
    rdfs:subClassOf fmo:fairness_metric ;
    skos:definition "A measurement of any fairness notion, partially connected to the confusion matrix principles, these metrics are usually referred with the term  calibration-based, with the very aim of distinguishing their prevalent attention to the predictive values."@en .

:CategoricalBiasScore a :MaskedTokenFairnessMetric,
        owl:NamedIndividual ;
    :isProposedBy :2021_AHN ;
    :isSuitableFor :ChatbotInteraction,
        :Classification .

:Clustering a :UnsupervisedLearningTask,
        owl:NamedIndividual .

:CoOccurrenceBiasScore a :DistributionFairnessMetric,
        owl:NamedIndividual ;
    :isProposedBy :2019_BORDIA ;
    :isSuitableFor :ChatbotInteraction,
        :Classification .

:ConditionalEqualOpportunity a :ObservationalFairnessNotion,
        :SeparationFairnessNotion,
        owl:NamedIndividual ;
    :hasBeenAppliedTo :Law ;
    :isProposedBy :2019_BEUTEL ;
    :isSuitableFor :ChatbotInteraction,
        :Classification ;
    :notionDefinition "As examples from different groups may have different distributions of risk,  directly applying equality of opportunity over these different risks can raise  issues.  For example, among defendants who have the same number of prior convictions (L), ensure that  FPRs for black and white defendants are equal" .

:ConditionalUseAccuracyEquality a :ObservationalFairnessNotion,
        :SufficiencyFairnessNotion,
        owl:NamedIndividual ;
    :hasBeenAppliedTo :Law ;
    :isProposedBy :2018_BERK ;
    :isSuitableFor :ChatbotInteraction,
        :Classification ;
    :notionDefinition "Conditional on the prediction of success (or failure), is the projected probability of success (or failure) the same across protected group classes?" .

:ConsistencyScore a owl:NamedIndividual,
        fmo:fairness_metric ;
    :isProposedBy :2013_ZEMEL ;
    :isSuitableFor :Classification ;
    :isUsedBy :2025_WALLER ;
    :metricDefinition "It measures the overall level of disparity in the classification of individuals with respect to similar individuals, using the k-nearest neighbours. To do so, NN gives a value in the interval [0, 1], and the higher the value, the lower the level of disparity overall." .

:ContextAssociationTest a :PseudoLogLikelihoodFairnessMetric,
        owl:NamedIndividual ;
    :isProposedBy :2021_NADEEM ;
    :isSuitableFor :ChatbotInteraction,
        :Classification .

:CounterfactualSentimentBias a :ClassifierFairnessMetric,
        owl:NamedIndividual ;
    :isProposedBy :2020_HUANG ;
    :isSuitableFor :ChatbotInteraction,
        :Classification .

:CrowSPairsScore a :PseudoLogLikelihoodFairnessMetric,
        owl:NamedIndividual ;
    :isProposedBy :2020_NANGIA ;
    :isSuitableFor :ChatbotInteraction,
        :Classification .

:DemographicRepresentation a :DistributionFairnessMetric,
        owl:NamedIndividual ;
    :isProposedBy :2023_LIANG ;
    :isSuitableFor :ChatbotInteraction,
        :Classification .

:DisCo a :MaskedTokenFairnessMetric,
        owl:NamedIndividual ;
    :isProposedBy :2021_WEBSTER ;
    :isSuitableFor :ChatbotInteraction,
        :Classification .

:Disparagement a :LinguisticBias,
        :RepresentationBias,
        owl:NamedIndividual ;
    rdfs:label "disparagement"@en ;
    skos:definition "Disparagement is not merely bias in representation but bias in expression, it is the linguistic realization of stereotype."@en .

:DisparateImpact a :ParityBasedFairnessMetric,
        owl:NamedIndividual ;
    :hasBeenAppliedTo :CensusIncomePrediction,
        :CreditRisk,
        :Health,
        :Law ;
    :isProposedBy :2015_FELDMAN,
        :2017_CHOULDECHOVA,
        :2023_GIULIANI ;
    :isSuitableFor :ChatbotInteraction,
        :Classification ;
    :isUsedBy :2015_FELDMAN ;
    :measures :StatisticalParity ;
    :metricDefinition "The ratio between the probabilities of positively classifying unprivileged and privileged groups should exceed a threshold." .

:EmpiricalToxicityProbability a :ClassifierFairnessMetric,
        owl:NamedIndividual ;
    :isProposedBy :2020_GEHMAN ;
    :isSuitableFor :ChatbotInteraction,
        :Classification .

:EnforcedWith a owl:ObjectProperty ;
    rdfs:label "enforced with"@en ;
    rdfs:domain :FairnessConcern ;
    rdfs:range fmo:fairness_notion .

:EqualityPrincipal a :SocialPrinciple,
        owl:NamedIndividual ;
    rdfs:label "Equality"@en ;
    skos:definition "Equality is giving everyone the same resources and opportunities."@en .

:EqualizingDisincentives a :ObservationalFairnessNotion,
        :SeparationFairnessNotion,
        owl:NamedIndividual ;
    :hasBeenAppliedTo :Law ;
    :isProposedBy :2020_JUNGa ;
    :isSuitableFor :ChatbotInteraction,
        :Classification ;
    :notionDefinition "It aims at equilizing the disincentive (e.e., to commit a crime) across groups: e.g., the probability of being found guilty having committed a crime relative to not must be the same for different groups." .

:EquityPrinciple a :SocialPrinciple,
        owl:NamedIndividual ;
    rdfs:label "Equity"@en ;
    skos:definition "Equity is providing different resources based on individual needs to ensure everyone has an equal outcome."@en .

:ExpectedMaximumToxicity a :ClassifierFairnessMetric,
        owl:NamedIndividual ;
    :isProposedBy :2020_GEHMAN ;
    :isSuitableFor :ChatbotInteraction,
        :Classification .

:ExposesTo a owl:ObjectProperty ;
    rdfs:label "exposes to"@en ;
    rdfs:domain :FairnessConcern ;
    rdfs:range fmo:bias .

:FairScore a owl:NamedIndividual,
        fmo:fairness_metric ;
    :isProposedBy :2022_QIAN ;
    :isSuitableFor :ChatbotInteraction,
        :Classification ;
    :isUsedBy :2025_RUSSO ;
    :metricDefinition "Is a counterfactual fairness metric that measures the change in model predictions between the original evaluation dataset and the perturbation-augmented version, with a comparatively lower score indicating a fairer model. The fairscore of a classifier is defined as the percentage of predictions that differ when the input is demographically altered." .

:FairnessThroughUnawareness a :ProceduralFairnessNotion,
        owl:NamedIndividual ;
    :isProposedBy :2016_GRGIC-HLACA ;
    :isSuitableFor :ChatbotInteraction,
        :Classification ;
    :notionDefinition "An algorithm is fair as long as any protected attributes A are not explicitly used in the decision-making process" .

:FullGenBias a :ClassifierFairnessMetric,
        owl:NamedIndividual ;
    :isProposedBy :2022_SMITH ;
    :isSuitableFor :ChatbotInteraction,
        :Classification .

:GenderPolarity a :LexiconFairnessMetric,
        owl:NamedIndividual ;
    :isProposedBy :2021_DHAMALA ;
    :isSuitableFor :ChatbotInteraction,
        :Classification .

:GeneralizedEntropyIndex a owl:NamedIndividual,
        fmo:fairness_metric ;
    :hasBeenAppliedTo :CensusIncomePrediction,
        :Law ;
    :isProposedBy :2018_SPEICHER ;
    :isSuitableFor :Classification ;
    :isUsedBy :2018_BELLAMY ;
    :metricDefinition "It is a merit-based metric of fairness that seeks to equalize the benefit individuals receive as the result of being subject to algorithmic decision making. Suppose society consists of n individuals, where b_i >= 0 denotes the benefit individual i receives as the result of being subject to algorithmic decision making." .

:Guides a owl:ObjectProperty ;
    rdfs:label "guides"@en ;
    rdfs:comment "Links a fairness notion to its underpinning social principle such as equity or equality."@en ;
    rdfs:domain :SocialPrinciple ;
    rdfs:range fmo:fairness_notion ;
    owl:inverseOf :isGuidedBy .

:HONEST a :LexiconFairnessMetric,
        owl:NamedIndividual ;
    :isProposedBy :2021_NOZZA ;
    :isSuitableFor :ChatbotInteraction,
        :Classification .

:ImpactFocusedMetric a owl:Class ;
    rdfs:label "Impact-focused Metric"@en ;
    rdfs:subClassOf :OptimizationObjectMetric .

:IndividualConsistencyScore a owl:NamedIndividual,
        fmo:fairness_metric ;
    :hasBeenAppliedTo :CensusIncomePrediction,
        :CreditRisk,
        :Law ;
    :isProposedBy :2025_WALLER ;
    :isSuitableFor :Classification ;
    :metricDefinition "An extension of the consistency score, which does not provide an overall (average) evaluation of the individual fairness performance of the predictor, but is able to assess how fair the model is for any individual in the dataset." .

:IntersectionalBias a owl:Class ;
    rdfs:label "intersectional bias"@en ;
    dc:source "https://doi.org/10.1145/3468507.3468511"^^xsd:anyURI ;
    rdfs:subClassOf fmo:bias ;
    skos:definition "Intersectional bias is a type of bias that occurs due to the combination of multiple sensitive factors."@en .

:IsAbout a owl:ObjectProperty ;
    rdfs:label "is about"@en ;
    rdfs:domain :ModelEvaluation ;
    rdfs:range :AIModel .

:IsTrainedOn a owl:ObjectProperty ;
    rdfs:label "is trained on"@en ;
    rdfs:domain :AIModel ;
    rdfs:range :TrainingDataset .

:IsTrainedWith a owl:ObjectProperty ;
    rdfs:label "is trained with"@en ;
    rdfs:domain :AIModel ;
    rdfs:range :ExperimentalSetting .

:ItemFocusedMetric a owl:Class ;
    rdfs:label "Item-focused Metric"@en ;
    rdfs:subClassOf :SubjectMetric .

:LanguageModelBias a :PseudoLogLikelihoodFairnessMetric,
        owl:NamedIndividual ;
    :isProposedBy :2021_BARIKERI ;
    :isSuitableFor :ChatbotInteraction,
        :Classification .

:LogProbabilityBiasScore a :MaskedTokenFairnessMetric,
        :ScientificArtifact,
        owl:NamedIndividual ;
    :isProposedBy :2019_KURITA ;
    :isSuitableFor :ChatbotInteraction,
        :Classification .

:LowIndividualConsistencyCount a :ScientificArtifact,
        owl:NamedIndividual,
        fmo:fairness_metric ;
    :hasBeenAppliedTo :CensusIncomePrediction,
        :CreditRisk,
        :Law ;
    :isProposedBy :2025_WALLER ;
    :isSuitableFor :Classification ;
    :metricDefinition "It measures the absolute number of individuals whose individual consistency score is below some threshold." .

:MaskingBias a owl:Class ;
    rdfs:label "masking bias"@en ;
    dc:source "https://doi.org/10.1145/3468507.3468511"^^xsd:anyURI ;
    rdfs:subClassOf fmo:bias ;
    skos:definition "Masking is a form of intentional discrimination that allows decision makers with prejudicial views to mask their intentions, typically by exploiting how fairness notions are defined."@en .

:OmmittedVariableBias a owl:Class ;
    rdfs:label "omitted variable bias"@en ;
    dc:source "https://doi.org/10.1145/3457607"^^xsd:anyURI ;
    rdfs:subClassOf fmo:bias ;
    skos:definition "Omitted variable bias occurs when one or more important variables are left out of a model."@en .

:OutcomeUnfairness a :ConfusionMatrixBasedFairnessMetric,
        owl:NamedIndividual ;
    :hasBeenAppliedTo :Law ;
    :isProposedBy :2016_GRGIC-HLACA ;
    :isSuitableFor :ChatbotInteraction,
        :Classification ;
    :metricDefinition "It quantifies the disparities in the misclassification rates for protected and unprotected groups." .

:OverallAccuracyEquality a :ObservationalFairnessNotion,
        :ScientificArtifact,
        :SeparationFairnessNotion,
        owl:NamedIndividual ;
    :hasBeenAppliedTo :Finance,
        :Health,
        :Law ;
    :isProposedBy :2018_BERK ;
    :isSuitableFor :ChatbotInteraction,
        :Classification ;
    :notionDefinition "The accuracy of the classification must be the same for both groups" .

:PerspectiveAPI a :ClassifierFairnessMetric,
        :ScientificArtifact,
        owl:NamedIndividual ;
    :isSuitableFor :ChatbotInteraction,
        :Classification ;
    :isUsedBy :2020_GEHMAN,
        :2023_CHOWDHERY,
        :2023_LIANG,
        :2024_CHUNG .

:PredictiveParity a :ObservationalFairnessNotion,
        :ScientificArtifact,
        :SufficiencyFairnessNotion,
        owl:NamedIndividual ;
    :hasBeenAppliedTo :Law ;
    :isProposedBy :2016_DIETERICH,
        :2017_CHOULDECHOVA,
        :2017_KUSNER ;
    :isSuitableFor :ChatbotInteraction,
        :Classification ;
    :notionDefinition "Aims at having similar predictive values for two different groups. E.g.,the probability of recidivating, given a high risk score, is similar for blacks and whites. Let S = S(x) denote the risk score, with higher values of S corresponding to higher levels of assessed risk. A score S = S(x) satisfies predictive parity at a threshold sHR if the likelihood of recidivism among high-risk offenders is the same regardless of group membership." .

:Prejudice a :HistoricalBias,
        owl:NamedIndividual ;
    rdfs:label "prejudice"@en ;
    skos:definition "Prejudice is a latent human or cultural construct and represents historical predispositions to discrimination."@en .

:ProportionalConsistencyScore a owl:NamedIndividual,
        fmo:fairness_metric ;
    :hasBeenAppliedTo :CensusIncomePrediction,
        :CreditRisk,
        :Law ;
    :isProposedBy :2025_WALLER ;
    :isSuitableFor :Classification ;
    :metricDefinition "It measures the proportion of individuals in the datasets whose decisions are deemed ‘consistent’, i.e., with an individual consistency score above a certain threshold." .

:PsycholinguisticNorms a :LexiconFairnessMetric,
        owl:NamedIndividual ;
    :isProposedBy :2021_DHAMALA ;
    :isSuitableFor :ChatbotInteraction,
        :Classification .

:RegardScore a :ClassifierFairnessMetric,
        owl:NamedIndividual ;
    :isProposedBy :2019_SHENG ;
    :isSuitableFor :ChatbotInteraction,
        :Classification .

:Regression a :SupervisedLearingTask,
        owl:NamedIndividual .

:SEAT a :SentenceEmbeddingFairnessMetric,
        owl:NamedIndividual ;
    :isProposedBy :2019_MAY ;
    :isSuitableFor :ChatbotInteraction,
        :Classification .

:SamplingBias a owl:Class ;
    rdfs:label "sampling bias"@en ;
    dc:source "https://doi.org/10.1145/3457607"^^xsd:anyURI ;
    rdfs:subClassOf fmo:bias ;
    skos:definition "Similarly to representation bias, sampling bias arises due to non-random sampling of subgroups"@en .

:ScoreParity a :ClassifierFairnessMetric,
        owl:NamedIndividual ;
    :isProposedBy :2023_SICILIA ;
    :isSuitableFor :ChatbotInteraction,
        :Classification .

:SentenceBiasScore a :SentenceEmbeddingFairnessMetric,
        owl:NamedIndividual ;
    :isProposedBy :2023_DOLCI ;
    :isSuitableFor :ChatbotInteraction,
        :Classification .

:SentimentAnalysis a :NaturalLanguageProcessingTask,
        owl:NamedIndividual .

:SimilarityRobustnessOfIndividualConsistency a owl:NamedIndividual,
        fmo:fairness_metric ;
    :hasBeenAppliedTo :CensusIncomePrediction,
        :CreditRisk,
        :Law ;
    :isProposedBy :2025_WALLER ;
    :isSuitableFor :Classification ;
    :metricDefinition "It quantifies the proportion of individuals for which the individual consistency decreases below or increases above some threshold, between two different notions of similarity. Useful for comparing the impact of switching between two notions. The lower the value, the more resilient the decisions of a classifier are with respect to the notions." .

:SingleGranularityMetric a owl:Class ;
    rdfs:label "Single Granularity Metric"@en ;
    rdfs:subClassOf :GranularityMetric .

:SocialGroupSubstitution a :DistributionFairnessMetric,
        owl:NamedIndividual ;
    :isProposedBy :2024_GALLEGOS ;
    :isSuitableFor :ChatbotInteraction,
        :Classification .

:Stereotype a :RepresentationBias,
        owl:NamedIndividual ;
    rdfs:label "stereotype"@en ;
    skos:definition "A simplified and generalized representation of a group (e.g., “women are nurses,” “men are engineers”) that operationalizes discrimination in communication, media, or data."@en .

:StereotypicalAssociations a :DistributionFairnessMetric,
        owl:NamedIndividual ;
    :isProposedBy :2023_LIANG ;
    :isSuitableFor :ChatbotInteraction,
        :Classification .

:TestingDataset a owl:Class ;
    rdfs:label "Testing Dataset"@en ;
    rdfs:subClassOf :Dataset .

:TheilIndex a owl:NamedIndividual,
        fmo:fairness_metric ;
    :hasBeenAppliedTo :CensusIncomePrediction,
        :Law ;
    :isProposedBy :2018_SPEICHER ;
    :isSuitableFor :Classification ;
    :isUsedBy :2024_GONZALEZ-SENDINO ;
    :metricDefinition "It measures the inequality in a group or individual concerning the fairness of the algorithm outcome. The lower the better." .

:ToxicityFraction a :ClassifierFairnessMetric,
        owl:NamedIndividual ;
    :isProposedBy :2023_LIANG ;
    :isSuitableFor :ChatbotInteraction,
        :Classification .

:TreatmentFocusedMetric a owl:Class ;
    rdfs:label "Treatment-focused Metric"@en ;
    rdfs:subClassOf :OptimizationObjectMetric .

:TruePositiveRateDifference a :ParityBasedFairnessMetric,
        owl:NamedIndividual ;
    :hasBeenAppliedTo :Law ;
    :isEquivalentTo :EqualOpportunity ;
    :isProposedBy :2021_DEARTEAGA ;
    :isSuitableFor :ChatbotInteraction,
        :Classification ;
    :metricDefinition "Originally: True positive gender gap. It measures the gap in true positive rate between the predictions of machine learning models employing demographic data, meant to be used comparatively; a lower score indicates a fairer model." .

:UserFocusedMetric a owl:Class ;
    rdfs:label "User-focused Metric"@en ;
    rdfs:subClassOf :SubjectMetric .

:WEAT a :WordEmbeddingFairnessMetric,
        owl:NamedIndividual ;
    :isProposedBy :2017_CALISKAN ;
    :isSuitableFor :ChatbotInteraction,
        :Classification .

:WellCalibration a :ObservationalFairnessNotion,
        :SufficiencyFairnessNotion,
        owl:NamedIndividual ;
    :hasBeenAppliedTo :Law ;
    :isProposedBy :2017_KLEINBERG,
        :2024_CATON ;
    :isSuitableFor :ChatbotInteraction,
        :Classification ;
    :notionDefinition "when two people from different groups get the same predicted score r, they should have the same probability of belonging to Y = 1 and that probability should also be equal to r. In other words, if the algorithm identifies a set of people as having a probability x of constituting positive instances, then approximately an x fraction of this set should indeed be positive instances" .

:concernDescription a owl:DatatypeProperty ;
    rdfs:label "concern description"@en ;
    rdfs:domain :FairnessConcern ;
    rdfs:range xsd:string .

:concernName a owl:DatatypeProperty ;
    rdfs:label "concern name"@en ;
    rdfs:domain :FairnessConcern ;
    rdfs:range xsd:string .

:configDescription a owl:DatatypeProperty ;
    rdfs:label "configuration description"@en ;
    rdfs:domain :HyperparameterConfiguration ;
    rdfs:range xsd:string .

:configName a owl:DatatypeProperty ;
    rdfs:label "configuration name"@en ;
    rdfs:domain :HyperparameterConfiguration ;
    rdfs:range xsd:string .

:configValue a owl:DatatypeProperty ;
    rdfs:label "has value"@en ;
    rdfs:domain :HyperparameterConfiguration ;
    rdfs:range xsd:string .

:datasetDescription a owl:DatatypeProperty ;
    rdfs:label "dataset description"@en ;
    rdfs:domain :Dataset ;
    rdfs:range xsd:string .

:datasetName a owl:DatatypeProperty ;
    rdfs:label "dataset name"@en ;
    rdfs:domain :Dataset ;
    rdfs:range xsd:string .

:defines a owl:ObjectProperty ;
    rdfs:label "defines"@en ;
    rdfs:domain :ExperimentalSetting ;
    rdfs:range :HyperparameterConfiguration .

:enforces a owl:ObjectProperty ;
    rdfs:label "enforces"@en ;
    rdfs:domain :MitigationTechnique ;
    rdfs:range fmo:fairness_metric ;
    owl:inverseOf :isEnforcedBy .

:hasAntonym a owl:AnnotationProperty ;
    rdfs:label "has antonym"@en ;
    rdfs:comment "Relates a concept to its antonym, given as a string or URI."@en .

:hasBeenAppliedTo a owl:ObjectProperty ;
    rdfs:label "has been applied to"@en ;
    rdfs:domain :ScientificArtifact ;
    rdfs:range :ApplicationDomain ;
    skos:definition "A certain fairness notion has been applied to certain application domains."@en .

:hasBeenTestedOn a owl:ObjectProperty ;
    rdfs:label "has been tested on"@en ;
    rdfs:domain :MitigationTechnique ;
    rdfs:range :Dataset .

:hasGoal a owl:DatatypeProperty ;
    rdfs:label "has goal"@en ;
    rdfs:domain :ExperimentalSetting ;
    rdfs:range xsd:string .

:hasValue a owl:DatatypeProperty ;
    rdfs:label "has value"@en ;
    rdfs:range xsd:float .

:hyperparameterDescription a owl:DatatypeProperty ;
    rdfs:label "hyperparameter description"@en ;
    rdfs:domain :Hyperparameter ;
    rdfs:range xsd:string .

:hyperparameterName a owl:DatatypeProperty ;
    rdfs:label "hyperparameter name"@en ;
    rdfs:domain :Hyperparameter ;
    rdfs:range xsd:string .

:isBasedOnSocialPrinciple a owl:AnnotationProperty .

:isEquivalentTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "is equivalent to"@en ;
    skos:definition "A certain fairness notion can be equal to some other fairness notions."@en .

:isInstanceOf a owl:ObjectProperty ;
    rdfs:label "is instance of"@en ;
    rdfs:domain :HyperparameterConfiguration ;
    rdfs:range :Hyperparameter .

:isMeasuredBy a owl:ObjectProperty ;
    rdfs:label "is measured by"@en ;
    rdfs:domain fmo:fairness_notion ;
    rdfs:range fmo:fairness_metric ;
    owl:inverseOf :measures ;
    skos:definition "A fairness notion is measured by a fairness metric if comparisons made with the given metric are a valid way to determine fairness with this notion."@en .

:isMitigatedBy a owl:ObjectProperty ;
    rdfs:label "is mitigated by"@en ;
    rdfs:domain fmo:bias ;
    rdfs:range fmo:fairness_notion ;
    owl:inverseOf :mitigates ;
    skos:definition "A certain bias in the use-case can be mitigated by enforcing specific fairness notions."@en .

:isProposedBy a owl:ObjectProperty ;
    rdfs:label "is proposed by"@en ;
    rdfs:domain :ScientificArtifact ;
    rdfs:range :ScientificPaper ;
    skos:definition "A certain fairness notion is proposed by a certain scientific paper."@en .

:isSuitableFor a owl:ObjectProperty ;
    rdfs:label "is suitable for"@en ;
    rdfs:domain :ScientificArtifact ;
    rdfs:range :MLTask ;
    skos:definition "A certain fairness notion is suitable for a certain set of tasks."@en .

:isUsedBy a owl:ObjectProperty ;
    rdfs:label "is used by"@en ;
    rdfs:domain :ScientificArtifact ;
    rdfs:range :ScientificPaper ;
    skos:definition "A certain fairness notion is used by some scientific papers."@en .

