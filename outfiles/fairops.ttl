@prefix core: <https://purl.org/fairops/core#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix fmo: <https://purl.org/twc/fmo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix resource: <http://semanticscience.org/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrla: <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dc:source a owl:AnnotationProperty .

resource:SIO_000068 a owl:ObjectProperty ;
    rdfs:label "is part of"@en ;
    rdfs:domain core:LegalRequirement ;
    rdfs:range core:Legislation .

resource:hasSynonym a owl:AnnotationProperty .

swrla:isRuleEnabled a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

<https://purl.org/fairops/core> a owl:Ontology .

core:AbductiveReasoning a owl:NamedIndividual,
        core:ReasoningAndDecisionMaking .

core:Adapters a owl:Class ;
    rdfs:label "Adapters" ;
    rdfs:subClassOf core:PartialFineTuning .

core:AdversarialLearning a owl:Class ;
    rdfs:label "Adversarial Learning" ;
    rdfs:subClassOf core:FullRetraining .

core:AlgorithmicBias a owl:NamedIndividual,
        fmo:bias ;
    rdfs:label "Algorithmic Bias"@en ;
    dc:source "https://doi.org/10.1145/3457607"^^xsd:anyURI ;
    skos:definition "Algorithmic bias is when the bias is not present in the input data and is added purely by the algorithm."@en .

core:AmortizedGranularityMetric a owl:Class ;
    rdfs:label "Amortized Granularity Metric"@en ;
    rdfs:subClassOf core:GranularityMetric .

core:AuditSets a owl:Class ;
    rdfs:label "Audit Sets" ;
    rdfs:subClassOf core:DataGeneration .

core:BanditsBasedLearning a owl:Class ;
    rdfs:label "Bandits-based Learning" ;
    rdfs:subClassOf core:FullRetraining .

core:BenchmarkAndCounterfactualEvaluationReports a owl:NamedIndividual,
        core:EvidenceArtifact ;
    skos:definition "assessments that measure an AI system’s performance and fairness using two complementary approaches. Benchmark evaluations compare the system against established standards, datasets, or metrics to see how well it performs overall. Counterfactual evaluations test how the system’s outputs would change if certain inputs, conditions, or group attributes were altered, revealing potential biases or unfair treatment. Together, these reports provide evidence of accuracy, consistency, and fairness across different scenarios."@en .

core:BiasPerpetuation a owl:NamedIndividual,
        core:RecommendationFairnessConcern ;
    skos:definition "When recommender systems learn from historical data, they are prone to absorbing and reproducing any biases present in that data"@en ;
    core:arisesIn core:Recommendation .

core:Blinding a owl:Class ;
    rdfs:label "Blinding and Proxy Removal" ;
    rdfs:subClassOf core:FeatureLevelColumnIntervention .

core:CalibrationBasedFairnessMetric a owl:Class ;
    rdfs:label "Calibration-based Fairness Metric" ;
    rdfs:subClassOf fmo:fairness_metric ;
    skos:definition "A measurement of any fairness notion, partially connected to the confusion matrix principles, these metrics are usually referred with the term  calibration-based, with the very aim of distinguishing their prevalent attention to the predictive values." .

core:CalibrationBasedMitigation a owl:Class ;
    rdfs:label "Calibration-based Mitigation" ;
    rdfs:subClassOf core:GreyBoxScores .

core:CausalFairnessNotion a owl:Class ;
    rdfs:label "Causal Fairness Notion"@en ;
    resource:hasSynonym "causal fairness"@en ;
    rdfs:subClassOf core:OutcomeFairnessNotion ;
    owl:disjointWith core:ObservationalFairnessNotion ;
    skos:definition "A family of fairness notions focusing on the causal relations between variables."@en .

core:Classification a owl:NamedIndividual,
        core:LearningAndPerception .

core:ClassifierFairnessMetric a owl:Class ;
    rdfs:label "Classifier Fairness Metric"@en ;
    rdfs:subClassOf core:GeneratedTextBasedFairnessMetric ;
    skos:definition "A metric that employs a classifier on generated text to assess the presence of bias or fairness."@en .

core:Cleaning a owl:Class ;
    rdfs:label "Cleaning" ;
    rdfs:subClassOf core:InstanceLevelRowIntervention .

core:ConformityAssesmentReport a owl:NamedIndividual,
        core:EvidenceArtifact .

core:ConfusionMatrixBasedFairnessMetric a owl:Class ;
    rdfs:label "Confusion Matrix-based Fairness Metric"@en ;
    rdfs:subClassOf fmo:fairness_metric ;
    skos:definition "A measurement of any fairness notion, focusing on the amount of correct/incorrect classifications inferred by the predictor."@en .

core:ConstrainedOptimization a owl:Class ;
    rdfs:label "Constrained Optimization" ;
    rdfs:subClassOf core:FullRetraining .

core:ConstraintOptimization a owl:NamedIndividual,
        core:ReasoningAndDecisionMaking .

core:ConstraintSolving a owl:NamedIndividual,
        core:ReasoningAndDecisionMaking .

core:CounterfactualAugmentation a owl:Class ;
    rdfs:label "Counterfactual Augmentation" ;
    rdfs:subClassOf core:InstanceLevelRowIntervention .

core:DatasetRepresentativenessReport a owl:NamedIndividual,
        core:EvidenceArtifact ;
    skos:definition "evaluates how well the dataset reflects the target population, with the goal of ensururing no group is systematically under- or over-represented.. It usually includes: Group distribution analysis (e.g., gender, age, region), Coverage checks (are some groups missing or underrepresented?), Sampling bias detection,Comparisons to a reference or real-world distribution"@en .

core:DecisionTimeConstrainedDecisioning a owl:Class ;
    rdfs:label "Decision-time Constrained Decisioning" ;
    rdfs:subClassOf core:BlackBoxDecisionOnly .

core:DerogatoryLanguage a owl:NamedIndividual,
        core:ConversationFairnessConcern ;
    skos:definition "Derogatory language refers to insulting slurs, demeaning expressions, or any terms used to attack or belittle a particular social group."@en ;
    core:arisesIn core:Conversation .

core:Dialogue a owl:NamedIndividual,
        core:ApplicationDomain .

core:DisparateSystemPerformance a owl:NamedIndividual,
        core:ConversationFairnessConcern ;
    skos:definition "Reduced language understanding, diversity, or richness in processing or generation across different social or linguistic groups."@en ;
    core:arisesIn core:Conversation .

core:DistanceBasedFairnessMetric a owl:Class ;
    rdfs:label "Distance-based Fairness Metric" ;
    rdfs:subClassOf fmo:fairness_metric .

core:DistributionFairnessMetric a owl:Class ;
    rdfs:label "Distribution Fairness Metric"@en ;
    rdfs:subClassOf core:GeneratedTextBasedFairnessMetric ;
    skos:definition "A metric that evaluates fairness by comparing the statistical distribution of generated outputs across groups."@en .

core:DocumentationOfSafeguardsAndEffectiveness a owl:NamedIndividual,
        core:EvidenceArtifact ;
    skos:definition "describes the measures implemented to prevent harm, bias, or unsafe behavior in an AI system and provides evidence showing how well those measures work. It explains the protections in place, such as moderation rules, human oversight, or bias mitigation, and demonstrates through metrics, tests, or audits that these measures reduce harm or unfair outcomes. This documentation ensures transparency, accountability, and regulatory compliance by showing that the system is responsibly managed."@en .

core:DocumentationOnJustificationOfEnrichmentStrategiesAndResidualRisk a owl:NamedIndividual,
        core:EvidenceArtifact ;
    skos:definition "a documented explanation of why specific data improvements were chosen and how they address identified gaps or biases. Also, clearly states the remaining limitations or uncertainties after mitigation, ensuring transparency about unresolved risks."@en .

core:DriftContextShiftLogs a owl:NamedIndividual,
        core:EvidenceArtifact ;
    skos:definition "capture statistical changes in data or model behavior over time (data drifts) and track changes in the environment or system context (context-shift, like a change in the User Interface); used to detect when a model is no longer operating under the same conditions it was trained on—which can introduce bias, errors, or unfair outcomes. A typical log entry might include:Timestamp, What changed (data distribution, UI, policy, etc.), Metrics before/after, Affected groups (if known), Alerts triggered (e.g., fairness threshold breached), Actions taken (or not)"@en .

core:EU_AI_Act a owl:NamedIndividual,
        core:Legislation ;
    rdfs:label "EU AI Act" ;
    dc:source "https://www.euaiact.com/" .

core:Education a owl:NamedIndividual,
        core:ApplicationDomain .

core:EqualityPrincipal a owl:NamedIndividual,
        core:SocialPrinciple ;
    rdfs:label "Equality"@en ;
    skos:definition "Equality is giving everyone the same resources and opportunities."@en .

core:EquityPrinciple a owl:NamedIndividual,
        core:SocialPrinciple ;
    rdfs:label "Equity"@en ;
    skos:definition "Equity is providing different resources based on individual needs to ensure everyone has an equal outcome."@en .

core:Erasure a owl:NamedIndividual,
        core:ConversationFairnessConcern ;
    skos:definition "Systematically overlooking or obscuring a social group’s language, identities, and lived experiences."@en ;
    core:arisesIn core:Conversation .

core:EvaluationReportsOnOmissionCoverageGaps a owl:NamedIndividual,
        core:EvidenceArtifact ;
    skos:definition "assessments that identify and document areas where an AI system or dataset fails to adequately represent certain groups, topics, or scenarios. These reports measure how well the system includes all relevant populations or information, highlighting missing data, underrepresented groups, or overlooked content. They help quantify potential bias or unfairness and guide interventions to improve coverage, ensuring the system’s outputs are more complete, representative, and equitable."@en .

core:ExclusionaryNorm a owl:NamedIndividual,
        core:ConversationFairnessConcern ;
    core:arisesIn core:Conversation .

core:ExclusionaryNorms skos:definition "An implicit exclusion or devaluation of an already disadvantaged social group, reinforcing the standards, assumptions, and worldviews of the dominant social group, while implicitly sidelining or devaluing those who do not fit within those boundaries"@en .

core:ExposureDistributionReports a owl:NamedIndividual,
        core:EvidenceArtifact ;
    skos:definition "analyses that measure how visibility or recommendations are distributed across items or groups, using divergence metrics (e.g., JSD, NDKL) to detect imbalance. They show whether certain items or groups receive disproportionately more or less exposure compared to a fair or expected distribution."@en .

core:FRIAReport a owl:NamedIndividual,
        core:EvidenceArtifact .

core:FairnessRegularization a owl:Class ;
    rdfs:label "Fairness Regularization" ;
    rdfs:subClassOf core:FullRetraining .

core:FeatureReview a owl:Class ;
    rdfs:label "Feature Review" ;
    rdfs:subClassOf core:FeatureLevelColumnIntervention .

core:FeedbackLoopOverfitting a owl:NamedIndividual,
        core:RecommendationFairnessConcern ;
    skos:definition "Given the existence of a feedback loop in the system, an item displayed by the recommender system may result in an action, which is then used to retrain the model, thus possibly reinforcing any bias already affecting the system."@en ;
    core:arisesIn core:Recommendation .

core:FinanceAndInsurance a owl:NamedIndividual,
        core:ApplicationDomain .

core:FullParameterDebiasing a owl:Class ;
    rdfs:label "Full Parameter Debiasing" ;
    rdfs:subClassOf core:FullFineTuning .

core:FullPruning a owl:Class ;
    rdfs:label "Full Pruning and Weight Masking" ;
    rdfs:comment "A mitigation technique that prunes an already trained model by setting to 0 some of its weights. The model is considered AS A WHOLE, by taking into account for pruning all its internal weights." ;
    rdfs:subClassOf core:FullFineTuning .

core:FullWeightRedistribution a owl:Class ;
    rdfs:label "Full Weight Redistribution"@en ;
    rdfs:comment "A mitigation technique that redistributes the weights of an already trained model, considering it AS A WHOLE, potentially redistributing all its weights." ;
    rdfs:subClassOf core:FullFineTuning .

core:GlobalKPIEvaluationReport a owl:NamedIndividual,
        core:EvidenceArtifact ;
    skos:definition "Global evaluations assess overall KPI across all users"@en .

core:GovernanceOnly a owl:Class ;
    rdfs:label "Governance-only Interventions (J)" ;
    rdfs:subClassOf core:HumanOversightMitigation .

core:GovernanceRecordsForDatasetUpdates a owl:NamedIndividual,
        core:EvidenceArtifact ;
    skos:definition "official records that track changes made to an AI system’s datasets. They document what data was added, removed, or modified, who authorized the change, when it occurred, and why it was done. These records ensure transparency, accountability, and traceability, helping organizations demonstrate responsible data management and maintain compliance with regulatory or ethical standards."@en .

core:GroupWisePerformanceAndCalibrationDashboards a owl:NamedIndividual,
        core:EvidenceArtifact ;
    skos:definition "visual tools that show how an AI system performs across different user groups. They track metrics like accuracy, prediction reliability, and calibration for each segment, making it easy to see disparities or biases. These dashboards allow ongoing monitoring, help identify underperforming groups, and provide evidence for corrective actions or fairness audits."@en .

core:HeadOnly a owl:Class ;
    rdfs:label "Head-only" ;
    rdfs:subClassOf core:PartialFineTuning .

core:Healthcare a owl:NamedIndividual,
        core:ApplicationDomain .

core:HistoricalBias a owl:NamedIndividual,
        fmo:bias ;
    rdfs:label "Historical Bias"@en ;
    dc:source "https://doi.org/10.1145/3457607"^^xsd:anyURI ;
    skos:definition "Historical bias is caused by already existing bias and socio-technical issues in the world, and can seep into from the data generation process even given a perfect sampling and feature selection."@en .

core:HumanOversightRulesThresholdsForIntervention a owl:NamedIndividual,
        core:EvidenceArtifact ;
    skos:definition "predefined, recorded criteria that specify when humans must review or override system outputs (e.g., if fairness metrics or risk indicators cross set thresholds). They ensure consistent, accountable intervention by defining who acts, under what conditions, and what actions are taken."@en .

core:HumanResources a owl:NamedIndividual,
        core:ApplicationDomain .

core:ICTSecurity a owl:NamedIndividual,
        core:ApplicationDomain .

core:ImpactFocusedMetric a owl:Class ;
    rdfs:label "Impact-focused Metric"@en ;
    rdfs:subClassOf core:OptimizationObjectMetric .

core:IncompleteHistoricalExamples a owl:NamedIndividual,
        core:RecommendationFairnessConcern ;
    core:arisesIn core:Recommendation .

core:IncompleteHystoricalExamples skos:definition "When the historical data on which the recommender system has been trained systematically lacks information that is valuable to provide good recommendations for certain items or users."@en .

core:InformationRetrival a owl:NamedIndividual,
        core:LearningAndPerception .

core:InstanceWeighting a owl:Class ;
    rdfs:label "Instance Weighting" ;
    rdfs:subClassOf core:FeatureLevelRowReweightingResampling .

core:InstructionsForUse a owl:NamedIndividual,
        core:EvidenceArtifact .

core:IntersectionalBias a owl:NamedIndividual,
        fmo:bias ;
    rdfs:label "Intersectional Bias"@en ;
    dc:source "https://doi.org/10.1145/3468507.3468511"^^xsd:anyURI ;
    skos:definition "Intersectional bias is a type of bias that occurs due to the combination of multiple sensitive factors. So, the AI system may behave fairly for each attribute separately but unfairly for certain subgroups at their intersections."@en .

core:ItemFocusedMetric a owl:Class ;
    rdfs:label "Item-focused Metric"@en ;
    rdfs:subClassOf core:SubjectMetric .

<https://purl.org/fairops/core#Kolmogorov–SmirnovTest> a owl:NamedIndividual,
        core:EvidenceArtifact ;
    skos:definition "statistical test used to compare two distributions. Usefull for: Compare feature distributions across groups (e.g., income distribution for different demographics), Detect distribution shifts (e.g., training vs production data), Identify hidden biases in variables"@en .

core:LawAndJustice a owl:NamedIndividual,
        core:ApplicationDomain .

core:LexiconFairnessMetric a owl:Class ;
    rdfs:label "Lexicon Fairness Metric"@en ;
    rdfs:subClassOf core:GeneratedTextBasedFairnessMetric ;
    skos:definition "A metric that uses predefined lexicons to study fairness or bias in generated textual content."@en .

core:LinguisticBias a owl:NamedIndividual,
        fmo:bias ;
    rdfs:label "Linguistic Bias"@en ;
    skos:definition "Linguistic bias is embedded in generative AI outputs, the manifestation of harm through demeaning or offensive language that reinforces discrimination."@en .

core:LoRA a owl:Class ;
    rdfs:label "LoRA" ;
    rdfs:subClassOf core:PartialFineTuning .

core:Logs a owl:NamedIndividual,
        core:EvidenceArtifact .

core:LogsOfInterventions a owl:NamedIndividual,
        core:EvidenceArtifact ;
    skos:definition """detailed records of actions taken to correct, mitigate, or manage undesirable behavior in an AI system. In the context of fairness, these logs document when and how the system’s outputs were flagged, modified, or blocked. They typically include:
Timestamp of the intervention, Reason for the action (e.g., offensive content, biased recommendation), Type of intervention (e.g., content filter applied, model retraining, human review), Outcome or resolution (e.g., corrected recommendation, blocked message)"""@en .

core:LongitudinalKPIsTrendsOverTime a owl:NamedIndividual,
        core:EvidenceArtifact ;
    skos:definition "track how much harmful or offensive language an AI system produces or allows, measured continuously or periodically. Helps identify trends, evaluate whether mitigation strategies are effective, and ensure the system maintains fairness and safety for all user groups."@en .

core:LongitudinalParityErrorDivergenceTrendsReport a owl:NamedIndividual,
        core:EvidenceArtifact ;
    skos:definition "tracking fairness and distribution metrics (like Disparate Impact, Non-parity Unfariness, Overestimation Unfairness,True Positive Rate Difference, JS Divergence, NDKL) over time (not just at one snapshot) to see how a system evolves—especially to catch feedback loops, drift, or emerging bias. In practice, the report contains time series plots for the selected metrics, possibily splited by group"@en .

core:ManagementLegalRequirement a owl:Class ;
    rdfs:label "Management Legal Requirement" ;
    rdfs:subClassOf core:LegalRequirement .

core:MaskedTokenFairnessMetric a owl:Class ;
    rdfs:label "Masked Token Fairness Metric"@en ;
    rdfs:subClassOf core:ProbabilityBasedFairnessMetric ;
    skos:definition "A fairness metric relying on the predicted probabilities for masked tokens in language models."@en .

core:MaskingBias a owl:NamedIndividual,
        fmo:bias ;
    rdfs:label "Masking Bias"@en ;
    dc:source "https://doi.org/10.1145/3468507.3468511"^^xsd:anyURI ;
    skos:definition "Masking is a form of intentional discrimination that allows decision makers with prejudicial views to mask their intentions, typically by exploiting how fairness notions are defined."@en .

core:Misrepresentation a owl:NamedIndividual,
        core:ConversationFairnessConcern ;
    skos:definition "A sample population is incomplete or unrepresentative, yet its characteristics are projected onto an entire social group as if they were accurate or universally applicable."@en ;
    core:arisesIn core:Conversation .

core:MisrepresentationsInProductMarketing a owl:NamedIndividual,
        core:RecommendationFairnessConcern ;
    skos:definition "Misrepresentations in product marketing--such as the choice of a particular human model, aesthetic style, or contextual presentation in product imagery--may induce marketing-driven biases that negatively affect the fairness of the overall system. These design choices can inadvertently skew user behaviour—forinstance, by appealing more strongly to some demographic groups than others—thereby embedding marketing-driven biases into the observed interaction signals."@en ;
    core:arisesIn core:Recommendation .

core:OmmittedVariableBias a owl:NamedIndividual,
        fmo:bias ;
    rdfs:label "Omitted Variable Bias"@en ;
    dc:source "https://doi.org/10.1145/3457607"^^xsd:anyURI ;
    skos:definition "Omitted variable bias occurs when one or more important variables are left out of a model."@en .

core:OutputRewriting a owl:Class ;
    rdfs:label "Decision/Output Re-writing" ;
    rdfs:subClassOf core:BlackBoxDecisionOnly .

core:ParityBasedFairnessMetric a owl:Class ;
    rdfs:label "Parity-based Fairness Metric"@en ;
    rdfs:subClassOf fmo:fairness_metric ;
    skos:definition "A measurement of any fairness notion, focusing on equalising the probability of a favourable outcome among groups."@en .

core:ParityErrorGapDashboard a owl:NamedIndividual,
        core:EvidenceArtifact ;
    skos:definition "monitoring dashboards used to track fairness metrics across groups. They focus on two things: Parity (Are outcomes similar across groups?) and Error gaps (Are mistakes, i.e.,false positives/negatives, uneven across groups? They can use metrics such as Disparate Impact, Absolute Difference, Fair Score, Non-parity unfairness"@en .

core:PartialPruning a owl:Class ;
    rdfs:label "Partial Pruning and Weight Masking" ;
    rdfs:comment "A mitigation technique that prunes a SUBPART OF an already trained model by setting to 0 some of its weights." ;
    rdfs:subClassOf core:PartialFineTuning .

core:PatternBasedEvaluationResults a owl:NamedIndividual,
        core:EvidenceArtifact ;
    skos:definition "Reports of the outcomes of systematically testing an AI system using a set of predefined input patterns or prompts designed to expose specific behaviors, biases, or failures. Controlled prompt suites ensure that each scenario is consistent and repeatable, allowing evaluators to measure how the system responds to different social groups, topics, or edge cases. The results reveal patterns of bias, unfairness, or errors, providing evidence for monitoring, mitigation, and accountability."@en .

core:Planning a owl:NamedIndividual,
        core:ReasoningAndDecisionMaking .

core:PopularItemsOverrecommended a owl:NamedIndividual,
        core:RecommendationFairnessConcern ;
    skos:definition "Given the functioning principlesof recommender systems, popular items may end up being disproportionately more recommended."@en ;
    core:arisesIn core:Recommendation .

core:PrePostMitigationComparisonReport a owl:NamedIndividual,
        core:EvidenceArtifact ;
    skos:definition "a structured record showing how a system behaved before a fairness intervention and how it behaves after—with clear evidence that the mitigation had (or didn’t have) the intended effect."@en .

core:ProbabilisticReasoning a owl:NamedIndividual,
        core:ReasoningAndDecisionMaking .

core:PseudoLogLikelihoodFairnessMetric a owl:Class ;
    rdfs:label "Pseudo-log Likelihood Fairness Metric"@en ;
    rdfs:subClassOf core:ProbabilityBasedFairnessMetric ;
    skos:definition "A metric based on pseudo-log likelihoods, often used to evaluate the fairness of generation or prediction probabilities."@en .

core:PublicServices a owl:NamedIndividual,
        core:ApplicationDomain .

core:Ranking a owl:NamedIndividual,
        core:ReasoningAndDecisionMaking .

core:RecordOfPolicyChanges a owl:NamedIndividual,
        core:EvidenceArtifact ;
    skos:definition "official documents that track modifications to the rules, guidelines, or procedures governing an AI system. They include details of what was changed, why the change was made, who approved it, and when it took effect. These records provide transparency, accountability, and a historical trail, helping organizations demonstrate responsible management and compliance with ethical or regulatory standards."@en .

core:Relabeling a owl:Class ;
    rdfs:label "Relabeling" ;
    rdfs:subClassOf core:InstanceLevelRowIntervention .

core:RemediationRecordsAndPostFixVerification a owl:NamedIndividual,
        core:EvidenceArtifact ;
    skos:definition "formal records documenting actions taken to correct identified problems or biases in an AI system and the follow-up checks to ensure those fixes worked. Remediation records detail what issues were addressed, what changes were made, and who implemented them. Post-fix verification shows that the interventions successfully resolved the problem, often using tests, metrics, or audits, providing accountability and evidence of system reliability and fairness"@en .

core:RepresentationBias a owl:NamedIndividual,
        fmo:bias ;
    rdfs:label "Representation Bias"@en ;
    dc:source "https://doi.org/10.1145/3457607"^^xsd:anyURI ;
    skos:definition "Representation bias arises from the use of a skewed or otherwise non-representative sample from a population during data collection process."@en .

core:Reranking a owl:Class ;
    rdfs:label "Re-ranking" ;
    rdfs:subClassOf core:BlackBoxDecisionOnly .

core:RetailAndECommerce a owl:NamedIndividual,
        core:ApplicationDomain .

core:RetrainingDecisionRecordsAndEffectivenessEvidence a owl:NamedIndividual,
        core:EvidenceArtifact ;
    skos:definition "audit-ready documentation showing why you retrained a model, how you did it, and whether it actually improved fairness"@en .

core:SafetyFairnessEvaluationSuite a owl:NamedIndividual,
        core:EvidenceArtifact ;
    skos:definition "a structured collection of tests, metrics, benchmark datasets, and evaluation procedures used to systematically assess whether an AI system behaves safely and fairly across different scenarios and user groups. It combines multiple evaluation methods—such as fairness metrics, robustness checks, toxicity analysis, bias detection, and stress testing—to provide comprehensive evidence about the system’s reliability, risk profile, and compliance with ethical or regulatory requirements."@en .

core:SamplingBias a owl:NamedIndividual,
        fmo:bias ;
    rdfs:label "Sampling  Bias"@en ;
    dc:source "https://doi.org/10.1145/3457607"^^xsd:anyURI ;
    skos:definition "Similarly to representation bias, sampling bias arises due to non-random sampling of subgroups"@en .

core:ScoreBasedFairnessMetric a owl:Class ;
    rdfs:label "Score-based Fairness Metric"@en ;
    rdfs:subClassOf fmo:fairness_metric ;
    skos:definition "A measurement of any fairness notion, directing attention to the value of the classification score."@en .

core:ScoringRegression a owl:NamedIndividual,
        core:LearningAndPerception .

core:SegmentLevelCalibrationPerformanceEvidence a owl:NamedIndividual,
        core:EvidenceArtifact ;
    skos:definition "documents whether predicted outcomes match actual outcomes for each user subgroup and identifies differences in accuracy or fairness (performance). E.g, F-statistic of ANOVA can be used  to test if these differences between groups are statistically significant; calibration gaps quantify the mismatch between predicted and observed results, helping detect and document biases for oversight and mitigation."@en .

core:SelectiveParameterUpdating a owl:Class ;
    rdfs:label "Selective Parameter Updating" ;
    rdfs:comment "A mitigation technique that updates the parameters (e.g., redistributes the weights) of a SUBPART OF an already trained model." ;
    rdfs:subClassOf core:PartialFineTuning .

core:SentenceEmbeddingFairnessMetric a owl:Class ;
    rdfs:label "Sentence Embedding Fairness Metric"@en ;
    rdfs:subClassOf core:EmbeddingBasedFairnessMetric ;
    skos:definition "A metric using sentence-level embedding representations as the basis for evaluating model or data fairness."@en .

core:SingleGranularityMetric a owl:Class ;
    rdfs:label "Single Granularity Metric"@en ;
    rdfs:subClassOf core:GranularityMetric .

core:Stereotyping a owl:NamedIndividual,
        core:ConversationFairnessConcern ;
    skos:definition "The formation of negative, fixed generalizations about a socially labeled group."@en ;
    core:arisesIn core:Conversation .

core:StratifiedSampling a owl:Class ;
    rdfs:label "Stratified Sampling" ;
    rdfs:subClassOf core:FeatureLevelRowReweightingResampling .

core:StructuredEvaluationOnGroupConditionedFactualityConsistency a owl:NamedIndividual,
        core:EvidenceArtifact ;
    skos:definition "systematic assessment of an AI system to determine how accurately and consistently it produces information for different social or demographic groups. It checks whether facts are correctly represented and whether responses remain reliable when conditioned on group attributes. This evaluation helps identify group-specific biases, misinformation, or inconsistencies, providing evidence for fairness, accountability, and corrective actions."@en .

core:SyntheticData a owl:Class ;
    rdfs:label "Synthetic Data" ;
    rdfs:subClassOf core:DataGeneration .

core:TargetedCollections a owl:Class ;
    rdfs:label "Targeted Collections" ;
    rdfs:subClassOf core:DataGeneration .

core:TechnicalDocument a owl:NamedIndividual,
        core:EvidenceArtifact .

core:TechnicalLegalRequirement a owl:Class ;
    rdfs:label "Technical Legal Requirement" ;
    rdfs:subClassOf core:LegalRequirement .

core:TextGeneration a owl:NamedIndividual,
        core:LearningAndPerception .

core:Thresholding a owl:Class ;
    rdfs:label "Thresholding" ;
    rdfs:subClassOf core:GreyBoxScores .

core:Toxicity a owl:NamedIndividual,
        core:ConversationFairnessConcern ;
    skos:definition "The employment of language that insults, threatens, or encourages hatred or violence toward a particular social group."@en ;
    core:arisesIn core:Conversation .

core:Transformation a owl:Class ;
    rdfs:label "Transformation/Representation Learning" ;
    rdfs:subClassOf core:InstanceLevelRowIntervention .

core:TransportAndLogistics a owl:NamedIndividual,
        core:ApplicationDomain .

core:TreatmentFocusedMetric a owl:Class ;
    rdfs:label "Treatment-focused Metric"@en ;
    rdfs:subClassOf core:OptimizationObjectMetric .

core:UserFacingInstructions a owl:NamedIndividual,
        core:EvidenceArtifact ;
    skos:definition "communicate to users how to safely and appropriately interact with the AI, including warnings, usage boundaries, or content restrictions."@en .

core:UserFocusedMetric a owl:Class ;
    rdfs:label "User-focused Metric"@en ;
    rdfs:subClassOf core:SubjectMetric .

core:UtilitiesEnergy a owl:NamedIndividual,
        core:ApplicationDomain .

core:WordEmbeddingFairnessMetric a owl:Class ;
    rdfs:label "Word Embedding Fairness Metric"@en ;
    rdfs:subClassOf core:EmbeddingBasedFairnessMetric ;
    skos:definition "A metric that leverages word vector representations to assess fairness or bias in language models or datasets."@en .

core:exposesTo a owl:ObjectProperty ;
    rdfs:label "exposes to"@en ;
    rdfs:domain fmo:bias ;
    rdfs:range core:FairnessConcern .

core:extends a owl:ObjectProperty ;
    rdfs:label "extends" ;
    rdfs:domain core:ScientificArtifact ;
    rdfs:range core:ScientificArtifact ;
    skos:definition "A certain Scientific Artifact may extend another. E.g., a certain Fairness Notion can extend another one" .

core:follows a owl:ObjectProperty ;
    rdfs:label "follows" ;
    rdfs:domain core:AILifecycleStep ;
    rdfs:range core:AILifecycleStep ;
    owl:inverseOf core:isFollowedBy .

core:guides a owl:ObjectProperty ;
    rdfs:label "guides"@en ;
    rdfs:comment "Links a fairness notion to its underpinning social principle such as equity or equality."@en ;
    rdfs:domain core:SocialPrinciple ;
    rdfs:range fmo:fairness_notion ;
    owl:inverseOf core:isGuidedBy .

core:hasAntonym a owl:AnnotationProperty ;
    rdfs:label "has antonym"@en ;
    rdfs:comment "Relates a concept to its antonym, given as a string or URI."@en .

core:isBasedOnSocialPrinciple a owl:AnnotationProperty .

core:isEquivalentTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "is equivalent to"@en ;
    rdfs:domain fmo:fairness_notion ;
    rdfs:range fmo:fairness_notion ;
    skos:definition "A certain fairness notion can be equal to some other fairness notions."@en .

core:isMeasuredBy a owl:ObjectProperty ;
    rdfs:label "is measured by"@en ;
    rdfs:domain fmo:fairness_notion ;
    rdfs:range fmo:fairness_metric ;
    owl:inverseOf core:measures ;
    skos:definition "A fairness notion is measured by a fairness metric if comparisons made with the given metric are a valid way to determine fairness with this notion."@en .

core:isMitigatedBy a owl:ObjectProperty ;
    rdfs:label "is mitigated by"@en ;
    rdfs:domain fmo:bias ;
    rdfs:range fmo:fairness_notion ;
    owl:inverseOf core:mitigates ;
    skos:definition "A certain bias in the use-case can be mitigated by enforcing specific fairness notions."@en .

core:isOperationalizedBy a owl:ObjectProperty ;
    rdfs:label "is operationalized by" ;
    rdfs:domain core:LegalRequirement ;
    rdfs:range fmo:fairness_notion ;
    owl:inverseOf core:operationalize .

core:isRelevantDuring a owl:ObjectProperty ;
    rdfs:label "is relevant during" ;
    rdfs:domain core:LegalRequirement ;
    rdfs:range core:AILifecycleStep .

core:isTriggeredBy a owl:ObjectProperty ;
    rdfs:label "is triggered by" ;
    owl:inverseOf core:triggers .

core:itsComplianceIsSupportedWith a owl:ObjectProperty ;
    rdfs:label "its compliance is supported by" ;
    rdfs:domain core:LegalRequirement ;
    rdfs:range core:MitigationTechnique ;
    owl:inverseOf core:supportsComplianceWith .

core:refersTo a owl:ObjectProperty ;
    rdfs:label "refers to"@en ;
    rdfs:domain core:ScientificArtifact ;
    rdfs:range core:AITask ;
    skos:definition "A certain fairness notion refers to (is suitable for) a certain set of AI tasks."@en .

core:requires a owl:ObjectProperty ;
    rdfs:domain core:FairnessConcern ;
    rdfs:range core:EvidenceArtifact .

core:scientificArtifactDescription a owl:DatatypeProperty ;
    rdfs:label "scientific artifact description"@en ;
    rdfs:domain core:ScientificArtifact ;
    rdfs:range xsd:string ;
    skos:definition "A latex description of a scientific artifact."@en .

fmo:probabilistic_definition a owl:AnnotationProperty .

fmo:tag a owl:AnnotationProperty .

core:AnalyticsApproach a owl:NamedIndividual,
        core:Scoping ;
    core:isFollowedBy core:DataRequirements .

core:BusinessRequirements a owl:NamedIndividual,
        core:Scoping ;
    core:isFollowedBy core:AnalyticsApproach .

core:DataCollection a owl:NamedIndividual,
        core:Pre-processing ;
    core:isFollowedBy core:ExploratoryDataAnalysis .

core:DataPreparation a owl:NamedIndividual,
        core:Pre-processing ;
    core:isFollowedBy core:ModelSelection .

core:DataRequirements a owl:NamedIndividual,
        core:Scoping ;
    core:isFollowedBy core:DataCollection .

core:ExploratoryDataAnalysis a owl:NamedIndividual,
        core:Pre-processing ;
    core:isFollowedBy core:DataPreparation .

core:HumanOversightMitigation a owl:Class ;
    rdfs:label "Human Oversight Mitigation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom core:Governance ;
            owl:onProperty core:isAppliedAt ],
        core:MitigationTechnique .

core:IndividualFairnessNotion a owl:Class ;
    rdfs:label "Individual Fairness Notion"@en ;
    dc:source "https://doi.org/10.1145/2090236.2090255"^^xsd:anyURI ;
    resource:hasSynonym "individual fairness"@en ;
    rdfs:subClassOf core:OutcomeFairnessNotion ;
    skos:definition "A family of fairness notions with the common objective to ensure that similar individuals are treated similarly by a model. Some notions in this group may be a relaxed version of &quot;strict&quot; individual fairness (i.e., they may treat similar indivduals differently under certain conditions)."@en .

core:ModelDeployment a owl:NamedIndividual,
        core:Post-processing ;
    rdfs:label "Model Deployment" ;
    core:isFollowedBy core:ModelTuning .

core:ModelEvaluation a owl:NamedIndividual,
        core:In-processing ;
    rdfs:label "Model Evaluation" ;
    core:isFollowedBy core:ModelDeployment .

core:ModelSelection a owl:NamedIndividual,
        core:In-processing ;
    rdfs:label "Model Selection" ;
    core:isFollowedBy core:ModelEvaluation .

core:ModelTuning a owl:NamedIndividual,
        core:Post-processing ;
    rdfs:label "Model Tuning" ;
    core:isFollowedBy core:ProjectReview .

core:ObservationalFairnessNotion a owl:Class ;
    rdfs:label "Observational Fairness Notion"@en ;
    resource:hasSynonym "observational fairness"@en ;
    rdfs:subClassOf core:OutcomeFairnessNotion ;
    skos:definition "A family of fairness notions focusing on the joint distribution of observable factors."@en .

core:Prediction a owl:NamedIndividual,
        core:AITypeOfUse .

core:ProjectReview a owl:NamedIndividual,
        core:Governance ;
    core:isFollowedBy core:BusinessRequirements .

core:enforces a owl:ObjectProperty ;
    rdfs:label "enforces"@en ;
    rdfs:domain core:MitigationTechnique ;
    rdfs:range fmo:fairness_metric ;
    owl:inverseOf core:isEnforcedBy .

core:hasBeenAppliedTo a owl:ObjectProperty ;
    rdfs:label "has been applied to"@en ;
    rdfs:domain core:ScientificArtifact ;
    rdfs:range core:ApplicationDomain ;
    skos:definition "A certain fairness notion has been applied to certain application domains."@en .

core:hasBeenTestedOn a owl:ObjectProperty ;
    rdfs:label "has been tested on"@en ;
    rdfs:domain core:ScientificArtifact ;
    rdfs:range <https://www.w3.org/TR/vocab-dcat-3/Dataset> .

core:isAddressedWith a owl:ObjectProperty ;
    rdfs:label "is addressed with"@en ;
    rdfs:domain core:FairnessConcern ;
    rdfs:range fmo:fairness_notion .

core:isEnforcedBy a owl:ObjectProperty ;
    rdfs:label "is enforced by"@en ;
    rdfs:domain fmo:fairness_metric ;
    rdfs:range core:MitigationTechnique .

core:isFollowedBy a owl:ObjectProperty ;
    rdfs:label "is followed by" ;
    rdfs:domain core:AILifecycleStep ;
    rdfs:range core:AILifecycleStep .

core:isGuidedBy a owl:ObjectProperty ;
    rdfs:label "is guided by"@en ;
    rdfs:comment "Links a fairness notion to its underpinning social principle such as equity or equality."@en ;
    rdfs:domain fmo:fairness_notion ;
    rdfs:range core:SocialPrinciple .

core:isSuitableFor a owl:ObjectProperty ;
    rdfs:label "is suitable for" ;
    rdfs:domain core:ScientificArtifact ;
    rdfs:range core:AITypeOfUse .

core:isUsedBy a owl:ObjectProperty ;
    rdfs:label "is used by"@en ;
    rdfs:domain core:ScientificArtifact ;
    rdfs:range core:ScientificPaper ;
    skos:definition "A certain fairness notion is used by some scientific papers."@en .

core:mitigatedWith a owl:ObjectProperty ;
    rdfs:label "mitigated with"@en ;
    rdfs:domain core:FairnessConcern ;
    rdfs:range core:MitigationTechnique .

core:mitigates a owl:ObjectProperty ;
    rdfs:label "mitigates"@en ;
    rdfs:domain fmo:fairness_notion ;
    rdfs:range fmo:bias ;
    skos:definition "A fairness notion is required to mitigate a certain bias."@en .

core:operationalize a owl:ObjectProperty ;
    rdfs:label "operationalize" ;
    rdfs:domain fmo:fairness_notion ;
    rdfs:range core:LegalRequirement .

core:relatesTo a owl:ObjectProperty ;
    rdfs:label "relates to" ;
    rdfs:domain <https://www.w3.org/TR/vocab-dcat-3/Dataset> ;
    rdfs:range core:ApplicationDomain .

core:supportsComplianceWith a owl:ObjectProperty ;
    rdfs:label "supports compliance with" ;
    rdfs:domain core:MitigationTechnique ;
    rdfs:range core:LegalRequirement .

core:triggers a owl:ObjectProperty ;
    rdfs:domain core:FairnessConcern ;
    rdfs:range core:LegalRequirement .

core:AD a swrl:Variable .

core:EmbeddingBasedFairnessMetric a owl:Class ;
    rdfs:label "Embedding-based Fairness Metric"@en ;
    rdfs:subClassOf fmo:fairness_metric ;
    skos:definition "A fairness metric that evaluates bias or fairness using representations derived from word or sentence embeddings."@en .

core:FeatureLevelColumnIntervention a owl:Class ;
    rdfs:label "Feature-level Column Intervention (A)" ;
    rdfs:subClassOf core:DataResourcesMitigation .

core:FeatureLevelRowReweightingResampling a owl:Class ;
    rdfs:label "Feature-level Row Reweighting/Resampling (C)" ;
    rdfs:subClassOf core:DataResourcesMitigation .

core:Governance a owl:Class ;
    rdfs:label "Governance" ;
    rdfs:subClassOf core:AILifecycleStep .

core:GranularityMetric a owl:Class ;
    rdfs:label "Granularity Metric"@en ;
    rdfs:subClassOf core:RecommendationSystemMetric .

core:GreyBoxScores a owl:Class ;
    rdfs:label "Scores and Probabilities Access - Grey-box Model (H)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom core:Post-processing ;
            owl:onProperty core:isAppliedAt ],
        core:ModelAccessResourcesMitigation .

core:IndependenceFairnessNotion a owl:Class ;
    rdfs:label "Independence Fairness Notion"@en ;
    dc:source "https://doi.org/10.1145/3468507.3468511"^^xsd:anyURI ;
    resource:hasSynonym "independence fairness"@en ;
    rdfs:subClassOf core:GroupFairnessNotion ;
    skos:definition "The fairness property satisfied when the predicted outcome variable is independent from protected attributes."@en ;
    fmo:probabilistic_definition "Ŷ ⊥ A"@en .

core:Legislation a owl:Class ;
    rdfs:label "Legislation" .

core:N a swrl:Variable .

core:OptimizationObjectMetric a owl:Class ;
    rdfs:label "Optimization Object Metric"@en ;
    rdfs:subClassOf core:RecommendationSystemMetric .

core:ProbabilityBasedFairnessMetric a owl:Class ;
    rdfs:label "Probability-based Fairness Metric"@en ;
    rdfs:subClassOf fmo:fairness_metric ;
    skos:definition "A metric that considers the probability distributions of predicted outcomes to measure fairness."@en .

core:ProceduralFairnessNotion a owl:Class ;
    rdfs:label "Procedural Fairness Notion"@en ;
    resource:hasSynonym "procedural fairness"@en ;
    rdfs:subClassOf fmo:fairness_notion ;
    skos:definition "Procedural fairness is connected to the concept of fairness from administrative law, which is concerned with equality of treatment within the process that makes a decision."@en .

core:SeparationFairnessNotion a owl:Class ;
    rdfs:label "Separation Fairness Notion"@en ;
    dc:source "https://doi.org/10.1145/3468507.3468511"^^xsd:anyURI ;
    resource:hasSynonym "separation fairness"@en ;
    rdfs:subClassOf core:GroupFairnessNotion ;
    skos:definition "The fairness property satisfied when the predicted outcome variable is independent of protected attributes, conditionally on the actual outcome variable."@en ;
    fmo:probabilistic_definition "Ŷ ⊥ A | Y"@en .

core:SubjectMetric a owl:Class ;
    rdfs:label "Subject Metric"@en ;
    rdfs:subClassOf core:RecommendationSystemMetric .

core:SufficiencyFairnessNotion a owl:Class ;
    rdfs:label "Sufficiency Fairness Notion"@en ;
    dc:source "https://doi.org/10.1145/3468507.3468511"^^xsd:anyURI ;
    resource:hasSynonym "sufficiency fairness"@en ;
    rdfs:subClassOf core:GroupFairnessNotion ;
    skos:definition "The fairness property satisfied when a target variable is independent of protected attributes, conditionally on the predicted outcome variable."@en ;
    fmo:probabilistic_definition "Y ⊥ A | Ŷ"@en .

core:independenceSeparationConflictsWith a owl:ObjectProperty ;
    rdfs:comment "Assume Y is binary, A is not independent of Y, and R is not independent of Y. Then, independence and separation cannot both hold." ;
    rdfs:subPropertyOf core:conflictsWith .

core:independenceSufficiencyConflictsWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:comment "Assume that sensitive attribute A and the target variable Y are not independent. Then sufficiency and independence cannot both hold." ;
    rdfs:subPropertyOf core:conflictsWith .

core:isProposedBy a owl:ObjectProperty ;
    rdfs:label "is proposed by"@en ;
    rdfs:domain core:ScientificArtifact ;
    rdfs:range core:ScientificPaper ;
    rdfs:subPropertyOf core:isUsedBy ;
    skos:definition "A certain fairness notion is proposed by a certain scientific paper."@en .

core:isQuantifiedBy a owl:ObjectProperty ;
    rdfs:label "is quantified by"@en ;
    rdfs:domain core:FairnessConcern ;
    rdfs:range fmo:fairness_metric .

core:measures a owl:ObjectProperty ;
    rdfs:label "measures"@en ;
    rdfs:domain fmo:fairness_metric ;
    rdfs:range fmo:fairness_notion ;
    skos:definition "A fairness metric measures some fairness notion if comparisons made with the given metric are a valid way to determine fairness with this notion."@en .

core:separationSufficiencyConflictsWith a owl:ObjectProperty ;
    rdfs:comment "Assume that all events in the joint distribution of (A, R, Y) have positive probability, and assume A is not independent of Y. Then, separation and sufficiency cannot both hold. For binary classifier, this means: Assume Y is not independent of A and assume \\hat{Y} is a binary classifier with a nonzero false positive rate. Then, separation and sufficiency cannot both hold." ;
    rdfs:subPropertyOf core:conflictsWith .

core:testsOn a owl:ObjectProperty ;
    rdfs:label "tests on"@en ;
    rdfs:domain core:ScientificPaper ;
    rdfs:range <https://www.w3.org/TR/vocab-dcat-3/Dataset> .

core:AITask a owl:Class ;
    rdfs:label "AI Task"@en ;
    skos:definition "The functional task that the AI system is able to perform. Previously was MLTask, AITask and AICapability."@en .

core:BlackBoxDecisionOnly a owl:Class ;
    rdfs:label "Decision Layer Control - Black-box Model (I)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom core:Post-processing ;
            owl:onProperty core:isAppliedAt ],
        core:ModelAccessResourcesMitigation .

core:DataGeneration a owl:Class ;
    rdfs:label "Data Acquisition/Generation (D)" ;
    rdfs:subClassOf core:DataResourcesMitigation .

core:FullFineTuning a owl:Class ;
    rdfs:label "Full Fine-tuning - White-box Model (F)" ;
    rdfs:subClassOf core:ModelAccessResourcesMitigation,
        core:TrainingResourcesMitigation ;
    owl:disjointWith core:PartialFineTuning .

core:GeneratedTextBasedFairnessMetric a owl:Class ;
    rdfs:label "Generated Text-based Fairness Metric"@en ;
    rdfs:subClassOf fmo:fairness_metric ;
    skos:definition "A metric that measures fairness by analyzing or scoring generated text outputs."@en .

core:GroupFairnessNotion a owl:Class ;
    rdfs:label "Group Fairness Notion"@en ;
    dc:source "https://doi.org/10.1145/3468507.3468511"^^xsd:anyURI ;
    resource:hasSynonym "group fairness"@en ;
    rdfs:subClassOf core:OutcomeFairnessNotion ;
    owl:disjointWith core:IndividualFairnessNotion ;
    skos:definition "A family of fairness notions with the common objective to ensure that groups who differ by their sensitive attributes are treated equally. (Note: Occasionally, \"group fairness\" is used to refer to statistical parity specifically, instead of the broader meaning as defined here)."@en .

core:In-processing a owl:Class ;
    rdfs:label "In-processing" ;
    rdfs:subClassOf core:AILifecycleStep .

core:RecommendationSystemMetric a owl:Class ;
    rdfs:label "Recommendation System Metric"@en ;
    rdfs:subClassOf fmo:fairness_metric .

core:ScientificPaper a owl:Class ;
    rdfs:label "Scientific Paper"@en ;
    skos:definition "A scientific manuscript published in a journal, conference proceedings or made pubblicly available online."@en .

core:Scoping a owl:Class ;
    rdfs:label "Scoping" ;
    rdfs:subClassOf core:AILifecycleStep .

core:TrainingResourcesMitigation a owl:Class ;
    rdfs:label "Training Resources Mitigation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom core:In-processing ;
            owl:onProperty core:isAppliedAt ],
        core:MitigationTechnique .

core:arisesIn a owl:ObjectProperty ;
    rdfs:label "arises in" ;
    rdfs:domain core:FairnessConcern ;
    rdfs:range core:AITypeOfUse .

<https://www.w3.org/TR/vocab-dcat-3/Dataset> a owl:Class ;
    rdfs:label "Dataset"@en ;
    skos:definition "A dataset used by an AI system"@en .

core:D a swrl:Variable .

core:DataResourcesMitigation a owl:Class ;
    rdfs:label "Data Resources Mitigation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom core:Pre-processing ;
            owl:onProperty core:isAppliedAt ],
        core:MitigationTechnique .

core:FullRetraining a owl:Class ;
    rdfs:label "Full Retraining (E)" ;
    rdfs:subClassOf core:TrainingResourcesMitigation .

core:InstanceLevelRowIntervention a owl:Class ;
    rdfs:label "Feature-level Row Intervention (B)" ;
    rdfs:subClassOf core:DataResourcesMitigation .

core:LearningAndPerception a owl:Class ;
    rdfs:label "Learning And Perception" ;
    rdfs:subClassOf core:AITask .

core:ModelAccessResourcesMitigation a owl:Class ;
    rdfs:label "Model Access Resources Mitigation"@en ;
    rdfs:subClassOf core:MitigationTechnique .

core:Post-processing a owl:Class ;
    rdfs:label "Post-processing" ;
    rdfs:subClassOf core:AILifecycleStep .

core:Pre-processing a owl:Class ;
    rdfs:label "Pre-processing" ;
    rdfs:subClassOf core:AILifecycleStep .

core:SA a swrl:Variable .

core:SP a swrl:Variable .

core:SocialPrinciple a owl:Class ;
    rdfs:label "Social Principle"@en ;
    skos:definition "Ethical and contextual interpretation of fairness, informing notions."@en .

core:T a swrl:Variable .

core:AITypeOfUse a owl:Class ;
    rdfs:label "AI Type Of Use" ;
    rdfs:comment "Describes the type of use of (or the type of interaction with) the AI system. It impacts obligations. Previously called AIScenario" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( core:Conversation core:Prediction core:Recommendation ) ] .

core:C a swrl:Variable .

core:M a swrl:Variable .

core:OutcomeFairnessNotion a owl:Class ;
    rdfs:label "Outcome Fairness Notion"@en ;
    resource:hasSynonym "outcome fairness"@en ;
    rdfs:subClassOf fmo:fairness_notion ;
    owl:disjointWith core:ProceduralFairnessNotion ;
    skos:definition "Outcome fairness is concerned with the fairness of the results of the decision-making process."@en .

core:RecommendationFairnessConcern a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue core:Recommendation ;
            owl:onProperty core:arisesIn ],
        core:FairnessConcern .

core:conflictsWith a owl:ObjectProperty,
        owl:SymmetricProperty .

core:isAppliedAt a owl:ObjectProperty ;
    rdfs:label "is applied at" ;
    rdfs:domain core:MitigationTechnique ;
    rdfs:range core:AILifecycleStep .

core:PartialFineTuning a owl:Class ;
    rdfs:label "Partial Fine-tuning - White-box Model (G)" ;
    rdfs:subClassOf core:ModelAccessResourcesMitigation,
        core:TrainingResourcesMitigation .

core:ReasoningAndDecisionMaking a owl:Class ;
    rdfs:label "Reasoning And Decision Making" ;
    rdfs:subClassOf core:AITask .

core:ConversationFairnessConcern a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue core:Conversation ;
            owl:onProperty core:arisesIn ],
        core:FairnessConcern .

core:Recommendation a owl:NamedIndividual,
        core:AITypeOfUse .

core:Conversation a owl:NamedIndividual,
        core:AITypeOfUse .

core:FairnessConcern a owl:Class ;
    rdfs:label "Fairness Concern"@en ;
    skos:definition "A fairness concern refers to a potential or observed issue where a system’s decisions or outcomes may unjustly favor or disadvantage certain individuals or groups. It highlights risks of bias, discrimination, or unequal treatment that require attention and mitigation." .

core:LegalRequirement a owl:Class ;
    rdfs:label "Legal Requirement" ;
    skos:definition "A law or regulation article that constrains the AI systems activity, specifically to operate fairly, without unjust bias or discrimination against individuals or groups." .

core:MitigationTechnique a owl:Class ;
    rdfs:label "Mitigation Technique"@en ;
    rdfs:subClassOf core:ScientificArtifact ;
    skos:definition "A method used to identify, reduce, or prevent unfair bias in data, models, or decision-making processes. It aims to improve fairness and reduce discriminatory outcomes across different groups or individuals." .

core:AILifecycleStep a owl:Class ;
    rdfs:label "AI Lifecycle Step" .

fmo:bias a owl:Class ;
    rdfs:label "Bias" ;
    dc:source "https://www.lexico.com/en/definition/bias"^^xsd:anyURI ;
    rdfs:subClassOf owl:Thing ;
    skos:definition "Predisposition in favor of or against one thing, person, or group compared with another, usually in a way considered to be unfair."@en .

core:ScientificArtifact a owl:Class ;
    rdfs:label "Scientific Artifact"@en ;
    skos:definition "A scientific artifact is the outcome with which the the paper contributes, such as a fairness notion, metric, and so on."@en .

core:a a swrl:Variable .

core:b a swrl:Variable .

core:ApplicationDomain a owl:Class ;
    rdfs:label "Application Domain"@en ;
    skos:definition "The specific real-world area or context in which the system is designed to operate. Previously was UseArea. According to AI Watch taxonomy can also me called \"Economic Sector or Use Area\""@en .

fmo:fairness_notion a owl:Class ;
    rdfs:label "Fairness Notion"@en ;
    dc:source "https://doi.org/10.1145/3468507.3468511"^^xsd:anyURI ;
    resource:hasSynonym "criterion"@en,
        "fairness"@en ;
    rdfs:subClassOf core:ScientificArtifact ;
    skos:definition """A conceptual or normative principle that specifies what it means for an AI
system to be fair, i.e., a formal definition of fairness that can be observed as a property of an AI model, in relation to that model's treatment of different cohorts."""@en .

fmo:fairness_metric a owl:Class ;
    rdfs:label "Fairness Metric"@en ;
    dc:source "https://doi.org/10.1145/3468507.3468511"^^xsd:anyURI ;
    rdfs:subClassOf core:ScientificArtifact ;
    skos:definition "A measurement of some fairness notion in a machine-learning model or dataset, with regards to some specific cohort(s)."@en .

core:EvidenceArtifact a owl:Class ;
    rdfs:label "Evidence Artifact" ;
    skos:definition "Evidence expected for compliance and auditability. That is, a piece of documentation, data, or analytical output that provides verifiable information about the presence, assessment, or mitigation of a specific socio-technical concern in an AI system. It supports the evaluation of that concern by supplying measurable or auditable evidence (e.g., logs, dataset analyses, reports, or metrics) related to the system’s behavior, data, or operational context." .

[] a swrl:Imp ;
    rdfs:label "Conflict3" ;
    swrla:isRuleEnabled true ;
    rdfs:comment "" ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 core:a ;
                    swrl:classPredicate core:IndependenceFairnessNotion ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 core:b ;
                            swrl:classPredicate core:SeparationFairnessNotion ] ;
                    rdf:rest () ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 core:a ;
                    swrl:argument2 core:b ;
                    swrl:propertyPredicate core:independenceSeparationConflictsWith ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 core:b ;
                            swrl:argument2 core:a ;
                            swrl:propertyPredicate core:independenceSeparationConflictsWith ] ;
                    rdf:rest () ] ] .

